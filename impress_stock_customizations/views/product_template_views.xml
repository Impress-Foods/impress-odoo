<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='qty_available']" position="before">
                <field name="uom_ids" position="move" />
            </xpath>
            <xpath expr="//field[@name='uom_ids']" position="attributes">
                <attribute name="string">UoMs</attribute>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field
                    name="label_name"
                    invisible="product_variant_count &gt; 1 and not is_product_variant"
                />
            </xpath>
        </field>
    </record>
</odoo>
