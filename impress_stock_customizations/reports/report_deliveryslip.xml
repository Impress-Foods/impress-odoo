<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <template
        id="report_deliveryslip_document"
        inherit_id="stock.report_delivery_document"
    >
        <!-- add borders for the table -->
        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" " />
        </xpath>

        <!-- For total in transfers -->
        <xpath expr="//div[1]" position="after" />

        <!-- Sums for transfer in process -->
        <xpath expr="//table[1]/tbody/tr" position="before">
            <t t-set="total_ordered" t-value="0" />
            <t t-set="total_delivered" t-value="0" />
        </xpath>
        <xpath expr="//table[1]/tbody/tr/td[1]" position="before">
            <t t-set="total_ordered" t-value="total_ordered + move.product_uom_qty" />
            <t t-set="total_delivered" t-value="total_delivered + move.quantity" />
        </xpath>

        <xpath expr="//table[1]/tbody" position="after">
            <tfoot>
                <td class="text-end">
                    <strong>Total: </strong>
                </td>
                <td class="text-end">
                    <t t-out="total_ordered" />
                </td>
                <td class="text-end">
                    <t t-out="total_delivered" />
                </td>
            </tfoot>
        </xpath>

        <!-- sums for completed transfers -->

        <xpath expr="//table[@name='stock_move_line_table']/tbody" position="before">
            <t t-set="total_ordered" t-value="0" />
            <t t-set="total_delivered" t-value="0" />
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/tbody/t" position="before">
            <t t-foreach="o.move_ids" t-as="move">
                <t
                    t-set="total_ordered"
                    t-value="total_ordered + move.product_uom_qty"
                />
                <t t-set="total_delivered" t-value="total_delivered + move.quantity" />
            </t>
        </xpath>

        <!-- Footer -->
        <xpath expr="//table[@name='stock_move_line_table']/tbody" position="after">
            <t
                t-set="has_shelf_life"
                t-value="has_serial_number and any(o.mapped('move_ids.move_line_ids.lot_id.expiration_date'))"
            />
            <tfoot>
                <tr>
                    <td t-if="has_shelf_life" />
                    <td t-if="has_shelf_life" />
                    <td class="text-end">
                        <strong>Total: </strong>
                    </td>
                    <td class="text-center">
                        <t t-if="not has_serial_number" t-out="total_ordered" />
                    </td>
                    <td class="text-end">
                        <t t-out="total_delivered" />
                    </td>
                </tr>
            </tfoot>
        </xpath>

        <!-- Add barcode operation barcode -->
        <xpath expr="//h2[1]" position="before">
            <div name="title_holder" class="d-flex flex-row justify-content-between" />
        </xpath>

        <xpath expr="//div[@name='title_holder']" position="inside">
            <xpath expr="//h2[1]" position="move" />
        </xpath>

        <xpath expr="//div[@name='title_holder']" position="inside">
            <span
                t-field="o.name"
                t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;'}"
            />
        </xpath>
    </template>
</odoo>
