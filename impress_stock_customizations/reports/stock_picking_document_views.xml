<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <template id="report_picking" inherit_id="stock.report_picking">
        <xpath expr="//table[hasclass('o_main_table')]//tr[1]/td[1]" position="after">
            <td class="text-start">
                <span
                    t-out="move.description_picking"
                    t-options="{'widget': 'text'}"
                >Description on transfer</span>
            </td>
        </xpath>

        <xpath
            expr="//table[hasclass('o_main_table')]//tr[1]/td[1]"
            position="attributes"
        >
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//td[hasclass('o_td_quantity')]/span[1]" position="after">
            <span
                t-out="' / ' + str(format_number(move.product_uom_qty))"
                class="text-nowrap"
            >3.00</span>
        </xpath>
        <xpath expr="//td[hasclass('o_td_quantity')]/span[1]" position="before">
            <span t-if="move.product_uom_qty > move.quantity">
                <i class="fa fa-exclamation-triangle" />
            </span>
        </xpath>

        <xpath expr="//div//div[1]" position="before">
            <t
                t-set="has_shelf_life"
                t-value="any(o.mapped('move_ids.move_line_ids.lot_id.expiration_date'))"
            />
        </xpath>
        <xpath expr="//th[@name='th_barcode']" position="before">
            <th name="th_shelflife_remaining" class="text-center" t-if="has_shelf_life">
                <strong>Shelf life remaining</strong>
            </th>
        </xpath>

        <xpath expr="//tbody[1]/t/tr/td[last()]" position="before">
            <td />
        </xpath>
        <xpath expr="//tbody[1]//t[@t-as='line']/tr/td[4]" position="after">
            <td
                name="td_shelflife_remaining"
                t-if="has_shelf_life"
                class="text-center h6"
            >
                <div t-if="has_shelf_life">
                    <span t-out="line.lot_id.life_remaining">
                        0
                    </span>
                    <span> days</span>
                </div>
            </td>
        </xpath>
        <xpath expr="//table[1]//tbody[1]" position="inside">
            <!-- Moves without reservations lines-->
            <t
                t-foreach="o.move_ids.filtered(lambda m: not m.quantity).sorted(key=lambda
                                move: (move.move_line_ids and move.move_line_ids[0].location_id.complete_name,
                                move.move_line_ids and move.move_line_ids[0].location_dest_id.complete_name))"
                t-as="move"
            >
                <tr>
                    <td class="text-start">
                        <span
                            t-out="move.description_picking"
                            t-options="{'widget': 'text'}"
                        >Description on transfer</span>
                    </td>
                    <td class="o_td_quantity text-end">
                        <span
                            t-out="format_number(move.product_uom_qty)"
                            class="text-nowrap"
                        >3.00</span>
                        <span
                            t-field="move.product_uom"
                            groups="uom.group_uom"
                        >units</span>
                        <span
                            t-if="move.packaging_uom_id and move.packaging_uom_id != move.product_uom"
                        > (<span
                            t-field="move.packaging_uom_qty"
                            t-options='{"widget": "integer"}'
                        /> <span t-field="move.packaging_uom_id.name" />) </span>
                    </td>

                    <t id="colspan-calculation" t-set="colspan" t-value="0" />
                    <t t-if="from_col_exists" t-set="colspan" t-value="colspan + 1" />
                    <t t-if="to_col_exists" t-set="colspan" t-value="colspan + 1" />
                    <t
                        t-if="barcode_col_exists"
                        t-set="colspan"
                        t-value="colspan + 1"
                    />
                    <t t-if="has_shelf_life" t-set="colspan" t-value="colspan + 1" />

                    <td t-att-colspan="colspan" class="text-center">
                        <span>
                            <i
                            class="fa fa-exclamation-triangle"
                        /> No reservation for this product! </span>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>
