<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <template
        id="report_stock_picking_with_checks_view"
        inherit_id="stock.report_picking"
        primary="True"
    >
        <xpath expr="//table[1]" position="attributes">
            <attribute name="class" separator=" " add="" remove="table-borderless" />
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th class="text-end">
                <strong>Demand</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th class="text-end">
                <strong>Check</strong>
            </th>
        </xpath>

        <xpath expr="//td[hasclass('o_td_quantity')]" position="after">
            <td />
        </xpath>
        <xpath expr="//td[hasclass('o_td_quantity')]" position="before">
            <td class="o_td_quantity text-end">
                <span
                    t-out="format_number(move.product_uom_qty)"
                    class="text-nowrap"
                >3.00</span>
                <span t-field="move.product_uom" groups="uom.group_uom">units</span>
            </td>
        </xpath>

        <xpath expr="//tbody[1]//t[@t-as='line']/tr/td[2]" position="after">
            <td />
        </xpath>
        <xpath expr="//tbody[1]//t[@t-as='line']/tr/td[1]" position="after">
            <td />
        </xpath>

        <xpath expr="//table[1]//tbody[1]" position="inside">
            <!-- Moves without reservations lines-->
            <t
                t-foreach="o.move_ids.filtered(lambda m: not m.quantity).sorted(key=lambda
                                move: (move.move_line_ids and move.move_line_ids[0].location_id.complete_name,
                                move.move_line_ids and move.move_line_ids[0].location_dest_id.complete_name))"
                t-as="move"
            >
                <tr>
                    <td class="text-start">
                        <span
                            t-field="move.product_id.display_name"
                        >Customizable Desk</span>
                        <br />
                        <span
                            t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name"
                        >
                            <span
                                t-out="move.description_picking"
                                t-options="{'widget': 'text'}"
                            >Description on transfer</span>
                        </span>
                    </td>
                    <td class="o_td_quantity text-end">
                        <span
                            t-out="format_number(move.product_uom_qty)"
                            class="text-nowrap"
                        >3.00</span>
                        <span
                            t-field="move.product_uom"
                            groups="uom.group_uom"
                        >units</span>
                        <span
                            t-if="move.packaging_uom_id and move.packaging_uom_id != move.product_uom"
                        > (<span
                            t-field="move.packaging_uom_qty"
                            t-options='{"widget": "integer"}'
                        /> <span t-field="move.packaging_uom_id.name" />) </span>
                    </td>
                    <td colspan="4" class="text-center">
                        <span>
                            <i
                            class="fa fa-exclamation-triangle"
                        /> No reservation for this product! </span>
                    </td>
                </tr>
            </t>
        </xpath>

        <xpath expr="//table[2]" position="after">
            <div class="check_callout">
                <span>Second verification done by:</span>
                <span class="input_line" />
                <span>Date:</span>
                <span class="input_line" />
            </div>
        </xpath>
    </template>

    <record id="report_stock_picking_with_checks" model="ir.actions.report">
        <field name="name">Picking with Checks</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >impress_stock_customizations.report_stock_picking_with_checks_view</field>
        <field
            name="report_file"
        >impress_stock_customizations.report_stock_picking_with_checks_view</field>
        <field
            name="print_report_name"
        >'Picking with Checks - %s - %s' % (object.partner_id.name or '', object.origin)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>
