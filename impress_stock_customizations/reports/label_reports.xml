    <record id="report_label_lot_zpl_4x6" model="ir.actions.report">
        <field name="name">Lot/Serial Number (ZPL 4x6)</field>
        <field name="label_size_id" ref="printing_label_format.size_4x6" />
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">impress_stock_customizations.label_lot_zpl_4x6</field>
        <field name="report_file">impress_stock_customizations.label_lot_zpl_4x6</field>
