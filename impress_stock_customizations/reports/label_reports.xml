    <template id="label_product_zpl_2x4">
        <t t-foreach="docs" t-as="product_info">
            <t t-foreach="range(product_info['label_count'])" t-as="count">
                <t t-set="product" t-value="product_info['product_record']" />
                <t t-set="product_qty" t-value="product_info['product_quantity']" />
                <t
                    t-set="product_uom"
                    t-value="product_info.get('product_uom', product.uom_id)"
                />
                <t t-translation="off">
                    <t t-out="'^XA^CI28'" />
                    <t t-out="'^PW812^LL406^LH0,0'" />
                    <t name="product_name">
                        <t
                            t-out="'^FO10,10^A0N,66,44^FB800,2,0,L^FD' + product_info['display_name_markup'] + '^FS'"
                        />
                    </t>
                    <t t-if="product_qty != 0" name="product_quantity">
                        <t
                            t-out="'^FO10,250^A0N,66,44^FB800,2,0,L^FDQTY: ' + str(product_qty) + ' ' + product_uom.display_name + '^FS'"
                        />
                    </t>

                    <t name="barcode">
                        <t t-if="product_info['gs1_barcode']">
                            <t
                                t-out="'^FO550,160^BY10,2,100^BXN,10,200^FD' + product_info['gs1_barcode'] + '^FS'"
                            />
                        </t>
                        <t t-elif="product.barcode">
                            <t
                                t-out="'^FO550,160^BY10,2,100^BXN,10,200^FD' + product.barcode + '^FS'"
                            />
                        </t>
                    </t>
                    <t t-out="'^XZ'" />
                </t>
            </t>
        </t>
    </template>

