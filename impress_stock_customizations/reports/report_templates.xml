            > o is not None ando._name != 'stock.picking'</attribute>
        </xpath>
    </template>

    <template id="external_layout_bubble" inherit_id="web.external_layout_bubble">
        <xpath expr="//img[hasclass('o_company_logo')][1]" position="attributes">
            <attribute
                name="t-if"
            >o is not None and o._name != 'stock.picking' &amp;&amp; company.logo</attribute>
        </xpath>
    </template>
</odoo>
