<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="packing_list_line">
        <tr name="tr_product">
            <td
                name="td_product_name"
                t-out="line['product'].description_sale or line['product'].display_name"
            >Bacon Burger</td>
            <td
                name="td_hts"
                class="text-end text-nowrap"
                t-out="line['product'].hs_code or ''"
            />
            <td
                name="td_lot"
                t-if="has_lots"
                class="text-end text-nowrap"
                t-out="line['lot'] and line['lot'].name or ''"
            />
            <td
                name="td_weight_gross"
                class="text-end"
                t-out="'%.2f' % line['gross']"
            />
            <td name="td_weight_net" class="text-end" t-out="'%.2f' % line['net']" />
            <td name="td_quantity" class="o_td_quantity text-end">
                <span t-out="format_number(line['quantity'])" class="text-nowrap" />
                <span t-out="line['uom'].name" />
            </td>
        </tr>
    </template>

    <template id="report_packingslip_document">
        <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())" />
        <t t-set="data" t-value="o._get_packing_list_data()" />
        <t
            t-set="format_number"
            t-value="lambda x: int(x) if x == int(x) else round(x, 2)"
        />
        <t t-set="layout_document_title">
            <span>Packing Slip</span>
        </t>
        <t t-set="address">
            <strong>Shipper</strong>
            <div
                t-field="o.company_id.partner_id"
                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": False}'
            />
        </t>
        <t t-set="information_block">
            <strong>Consignee</strong>
            <div
                t-field="o.partner_id"
                t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": False}'
            />
        </t>

        <t t-call="web.external_layout">
            <div class="page">
                <div class="row mb-4" id="informations">
                    <div t-if="o.origin" class="col" name="informations_reference">
                        <strong>Invoice #</strong>
                        <div t-field="o.origin">S0001</div>
                    </div>
                    <div class="col" name="informations_date">
                        <strong>Date</strong>
                        <div
                            t-field="o.date_done"
                            t-options='{"widget": "date"}'
                        >2023-12-31</div>
                    </div>
                    <div t-if="o.company_id.country_id" class="col">
                        <strong>Country of Origin</strong>
                        <div t-field="o.company_id.country_id.display_name">Canada</div>
                    </div>
                    <div t-if="o.carrier_id" class="col">
                        <strong>Carrier</strong>
                        <div t-field="o.carrier_id.name" />
                    </div>
                    <div t-if="o.carrier_tracking_ref" class="col">
                        <strong>Tracking</strong>
                        <div t-field="o.carrier_tracking_ref" />
                    </div>
                    <div class="col">
                        <strong>Packages</strong>
                        <div t-out="data['total_packages']" />
                    </div>
                </div>

                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description" class="text-start">
                                <strong>Description of Goods</strong>
                            </th>
                            <th name="th_hts" class="text-end text-nowrap">
                                <strong>Hts Number</strong>
                            </th>
                            <th
                                name="th_lot"
                                t-if="data['has_lots']"
                                class="text-end text-nowrap"
                            >
                                <strong>Lot</strong>
                            </th>
                            <th name="th_weight_gross" class="text-end">
                                <strong>Gross Wt. (kg)</strong>
                            </th>
                            <th name="th_weight_net" class="text-end">
                                <strong>Net Wt. (kg)</strong>
                            </th>
                            <th name="th_quantity" class="text-end text-nowrap">
                                <strong>Quantity</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="data['unpacked_lines']">
                            <t t-foreach="data['unpacked_lines']" t-as="line">
                                <t
                                    t-call="impress_stock_customizations.packing_list_line"
                                    line="line"
                                    has_lots="data['has_lots']"
                                />
                            </t>
                        </t>
                        <t t-foreach="data['sections']" t-as="section">
                            <t
                                t-set="bg_color"
                                t-value="'background-color: ' + o.company_id.primary_color or '#6c757d' + ';'"
                            />
                            <tr class="o_line_section fw-bolder">
                                <td colspan="2" t-att-style="bg_color">
                                    <span
                                        class="ms-1"
                                        t-out="section['package'].name"
                                    />
                                </td>
                                <td t-att-style="bg_color" class="text-end">
                                    <span t-out="'%.2f' % section['package'].weight" />
                                </td>
                                <td t-att-style="bg_color" class="text-end">
                                    <span
                                        t-out="'%.2f' % section['package'].net_weight"
                                    />
                                </td>
                                <td t-att-style="bg_color" class="text-end">
                                    <span
                                        t-out="format_number(section['package'].total_count)"
                                    />
                                </td>
                            </tr>
                            <t t-foreach="section['lines']" t-as="line">
                                <t
                                    t-call="impress_stock_customizations.packing_list_line"
                                    line="line"
                                    has_lots="data['has_lots']"
                                />
                            </t>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="o_top_border fw-bolder">
                            <td
                                t-att-colspan="3 if data['has_lots'] else 2"
                                class="text-end"
                            >Total</td>
                            <td class="text-end">
                                <span t-out="'%.2f' % data['total_gross']" />
                            </td>
                            <td class="text-end">
                                <span t-out="'%.2f' % data['total_net']" />
                            </td>
                            <td class="text-end">
                                <span t-out="format_number(data['total_quantity'])" />
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <div t-if="o.signature" class="mt32 ml64 mr4" name="signature">
                    <div class="offset-8">
                        <strong>Signature</strong>
                    </div>
                    <div class="offset-8">
                        <img
                            t-att-src="image_data_uri(o.signature)"
                            style="max-height: 4cm; max-width: 8cm;"
                        />
                    </div>
                    <div t-if="o.partner_id.name" class="offset-8 text-center">
                        <p t-field="o.partner_id.name">John Doe</p>
                    </div>
                </div>
            </div>
            <div>
                <span>Package Gross Weight includes pallet weight</span>
            </div>
        </t>
    </template>

    <template id="report_packingslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="impress_stock_customizations.report_packingslip_document"
                    t-lang="o._get_report_lang()"
                />
            </t>
        </t>
    </template>

    <record id="action_report_packing_slip" model="ir.actions.report">
        <field name="name">Packing Slip</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="impress.us_letter_landscape" />
        <field
            name="report_name"
        >impress_stock_customizations.report_packingslip</field>
        <field
            name="report_file"
        >impress_stock_customizations.report_packingslip</field>
        <field
            name="print_report_name"
        >'Packing Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>
