<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_reorder_report_search" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.reorder.search.inherit</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.stock_reorder_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="inside">
                <filter string="Vendor" name="groupby_vendor" context="{'group_by':'vendor_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_tree_editable" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.editable.inherit</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_id']" position="after">
                <field name="vendor_id" string="Vendor" optional="hidden"/>
            </xpath>
        </field>
    </record>

</odoo>
