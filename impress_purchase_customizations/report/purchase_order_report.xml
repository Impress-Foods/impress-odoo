<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <record id="report_purchase_order_internal" model="ir.actions.report">
        <field name="name">Purchase Order Internal</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >impress_purchase_customizations.report_purchaseorder_internal</field>
        <field
            name="report_file"
        >impress_purchase_customizations.report_purchaseorder_internal</field>
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="binding_type">report</field>
    </record>

    <template
        id="report_purchaseorder_internal_document"
        inherit_id="purchase.report_purchaseorder_document"
        primary="True"
        priority="99"
    >
        <!-- Add needed columns for internal reports -->
        <xpath expr="//th[@name='th_quantity']" position='after'>
            <th name="th_qty_received" class="text-end">
                <strong>Qty Received</strong>
            </th>
            <th name="th_qty_invoiced" class="text-end">
                <strong>Qty Invoiced</strong>
            </th>
        </xpath>
        <xpath expr="//tbody[1]//tr[1]/t/td[2]" position="after">
            <td name="td_received_qty" class='text-end'>
                <span t-field="line.qty_received" />
                <span t-field="line.product_uom_id.name" groups="uom.group_uom" />
                <span
                    t-if="line.product_uom_id != line.product_id.uom_id"
                    class="text-muted small"
                >
                    <br />
                    <span
                        t-field="line.received_uom_qty"
                        t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                    />
                    <span t-field="line.product_id.uom_id" />
                </span>
            </td>
            <td name="td_invoiced_qty" class="text-end">
                <span t-field="line.qty_invoiced" />
                <span t-field="line.product_uom_id.name" groups="uom.group_uom" />
                <span
                    t-if="line.product_uom_id != line.product_id.uom_id"
                    class="text-muted small"
                >
                    <br />
                    <span
                        t-field="line.invoiced_uom_qty"
                        t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                    />
                    <span t-field="line.product_id.uom_id" />
                </span>
            </td>
        </xpath>
    </template>

    <template id="report_purchaseorder_internal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="impress_purchase_customizations.report_purchaseorder_internal_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>
</odoo>
