<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="group_maintenance_administrator" model="res.groups">
        <field name="name">Maintenance / Administrator (Deprecated)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >Deprecated, use maintenance.group_equipment_manager</field>
    </record>
    <record id="group_maintenance_technician" model="res.groups">
        <field name="name">Maintenance / User </field>
        <field
            name="category_id"
            ref="base.module_category_manufacturing_maintenance"
        />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field name="comment">The user will be able to manage equipment.</field>
    </record>
    <record id="equipment_request_rule_technician" model="ir.rule">
        <field name="name">Maintenance technician</field>
        <field name="model_id" ref="model_maintenance_request" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_technician'))]" />
    </record>

</odoo>
