<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_campaign_form_direct" model="ir.ui.view">
        <field name="name">mrp.campaign.form.direct</field>
        <field name="model">mrp.campaign</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="mrp_campaign.view_mrp_campaign_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reset']" position="before">
                <button
                    name="action_open_add_demand_wizard"
                    type="object"
                    string="Add Demand"
                    class="btn-secondary"
                    invisible="state not in ['draft']"
                />
                <button
                    name="action_open_split_wizard"
                    type="object"
                    string="Split Campaign"
                    class="btn-secondary"
                    invisible="state not in ['draft', 'plan']"
                />
                <button
                    name="action_bo"
                    type="object"
                    string="Backorder Campaign"
                    class="btn-secondary"
                    invisible="state not in ['confirm','progress']"
                />
            </xpath>
        </field>
    </record>
</odoo>
