<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_campaign_direct_wizard_form" model="ir.ui.view">
        <field name="name">mrp.campaign.direct.wizard.form</field>
        <field name="model">mrp.campaign.direct.wizard</field>
        <field name="inherit_id" ref="mrp_campaign.view_mrp_campaign_creator_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="invisible">campaign_id</attribute>
                <attribute name="readonly">campaign_id</attribute>
            </xpath>
            <xpath expr="//group[1]" position="inside">
                <field name="campaign_id" invisible="1" readonly="1" />
                <field name="planned_date" invisible="campaign_id" required="True" />
            </xpath>
            <xpath expr="//button[@name='process_wizard']" position="attributes">
                <attribute name="string">Confirm</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_mrp_campaign_direct_wizard_create" model="ir.actions.act_window">
        <field name="name">Create Campaign (Direct)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.campaign.direct.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_mrp_campaign_direct_wizard"
        name="Create Campaign (Direct)"
        parent="mrp_campaign.menu_mrp_campaign"
        action="action_mrp_campaign_direct_wizard_create"
        sequence="51"
    />
</odoo>
