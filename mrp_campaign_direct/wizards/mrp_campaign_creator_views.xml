<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_mrp_campaign_creator_direct_form" model="ir.ui.view">
        <field name="name">view.mrp.campaign.creator.direct.form</field>
        <field name="model">mrp.campaign.creator.direct</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="mrp_campaign.view_mrp_campaign_creator_form" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <notebook>
                    <page string="Demand Moves" name="demand_moves">
                        <field name="available_demand_move_ids" invisible="1" />
                        <field
                            name="demand_move_ids"
                            nolabel="1"
                            domain="[('id', 'in', available_demand_move_ids)]"
                        >
                            <tree>
                                <field name="product_id" readonly="1" />
                                <field name="product_uom_qty" readonly="1" />
                                <field name="origin" readonly="1" />
                                <field
                                    name="date_deadline"
                                    widget="date"
                                    readonly="1"
                                />
                                <field name="state" readonly="1" />
                                <field name="sale_customer_ref" readonly="1" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="action_mrp_campaign_creator_direct" model="ir.actions.act_window">
        <field name="name">Create Campaign (Direct)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.campaign.creator.direct</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_mrp_campaign_creator_direct"
        name="Create Campaign (Direct)"
        parent="mrp_campaign.menu_mrp_campaign"
        action="action_mrp_campaign_creator_direct"
        sequence="51"
    />
</odoo>
