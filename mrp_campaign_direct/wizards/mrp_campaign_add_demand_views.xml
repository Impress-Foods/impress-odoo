<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_campaign_add_demand_direct_form" model="ir.ui.view">
        <field name="name">mrp.campaign.add.demand.direct.form</field>
        <field name="model">mrp.campaign.add.demand.direct</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="campaign_id" readonly="1" />
                    <field name="valid_move_ids" invisible="1" />
                </group>
                <field
                    name="demand_move_ids"
                    domain="[('id', 'in', valid_move_ids)]"
                    nolabel="1"
                >
                    <tree>
                        <field name="product_id" />
                        <field name="campaign_qty_to_supply" />
                        <field name="product_uom" />
                        <field name="origin" />
                        <field name="date_deadline" />
                        <field name="state" />
                    </tree>
                </field>
                <footer>
                    <button
                        name="add_demands"
                        string="Add Demands"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
