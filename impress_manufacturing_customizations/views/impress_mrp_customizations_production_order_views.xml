    <record id="production_add_handle" model="ir.ui.view">
        <field name="name">production.add_handle</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_kanban_view" />
        <field name="priority">101</field>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/div[1]" position="inside">
                <div class="float-end text-end ps-2">
                    <field name='sequence' widget="handle" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="production_add_qty_producing" model="ir.ui.view">
        <field name="name">production.add_qty_producing</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_kanban_view" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name='qty_producing' />
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="replace" />

            <xpath expr="//field[@name='product_qty']" position="replace">
                <span t-if="record.state.raw_value !='done'" class="ms-auto">
                    <field name="product_qty" />
                    <small>
                        <span><![CDATA[&nbsp;]]></span>
                        <field name="product_uom_id" />
                    </small>
                </span>
                <span t-if="record.state.raw_value=='done'" class="ms-auto">
                    <field name="qty_producing" /> / <field name="product_qty" />
                    <small>
                    <span><![CDATA[&nbsp;]]></span>
                    <field name="product_uom_id" />
                </small>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
