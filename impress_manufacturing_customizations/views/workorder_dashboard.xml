<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="workorder_view_dashboard" model="ir.ui.view">
        <field name="name">workorder.view.kanban</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_dashboard o_mrp_workorder_kanban"
                create="0"
                sample="1"
                default_order="state"
            >
                <field name="name" />
                <field name="production_id" on_change="1" />
                <field name="state" readonly="1" on_change="1" />
                <field name="is_user_working" />
                <field name="working_user_ids" />
                <field name="last_working_user_id" />
                <field name="working_state" />
                <field name="workcenter_id" on_change="1" />
                <field name="product_id" />
                <field name="qty_remaining" />
                <field name="qty_production" on_change="1" />
                <field name="date_start" on_change="1" />
                <field name="production_date" />
                <field name="product_uom_id" force_save="1" />
                <field name="finished_lot_ids" on_change="1" />
                <field name="operation_id" on_change="1" />
                <field name="production_date" />
                <progressbar
                    field="state"
                    colors='{
                    "pending": "info",
                    "waiting": "info",
                    "ready": "primary",
                    "progress": "warning",
                    "done": "success",
                    "cancel": "danger"
                    }'
                />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_card_header o_kanban_record_top">
                                <div class="o_kanban_workorder_title">
                                    <h4 class="o_primary">
                                        <span>
                                        <t t-out="record.production_id.value" />
                                    </span> - <span>
                                        <t t-out="record.name.value" />
                                    </span>
                                    </h4>
                                </div>
                                <div class="o_kanban_workorder_date">
                                    <h5>
                                        <span
                                            class="d-flex"
                                            t-esc="record.date_start.value or record.production_date.value"
                                        />
                                    </h5>
                                </div>
                                <div>
                                    <h2 class="ml8">
                                        <span
                                            t-attf-class="badge #{['progress'].indexOf(record.state.raw_value) &gt; -1 ? 'text-bg-warning' : ['ready', 'waiting', 'pending'].indexOf(record.state.raw_value) &gt; -1 ? 'text-bg-primary' : ['done'].indexOf(record.state.raw_value) &gt; -1 ? 'text-bg-success' : 'text-bg-danger'}"
                                        >
                                            <t t-out="record.state.value" />
                                        </span>
                                    </h2>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom flex-column">
                                <div class="row">
                                    <h5 class="oe_kanban_bottom_left">
                                        <span>
                                            <t t-out="record.product_id.value" />
                                        </span>
                                    </h5>
                                </div>
                                <div class="row justify-content-between">
                                    <h5 class="col-4">
                                        <span>
                                            <t t-out="record.qty_production.value" />
                                            &#160;
                                            <t t-out="record.product_uom_id.value" />
                                        </span>
                                    </h5>
                                    <h5 class="col-4">
                                        <!-- <span
                                            t-if="record.finished_lot_ids.value"
                                            t-out="record.finished_lot_ids.value"
                                        /> -->
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="workorder_dashboard_view_search" model="ir.ui.view">
        <field name="name">workorder_dashboard.view.search</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_work_order_search" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <filter
                    string="Today"
                    name="today"
                    domain="[
                    ('production_date', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                    ('production_date', '&lt;=',  (context_today()).strftime('%Y-%m-%d'))
                    ]"
                />
            </xpath>
        </field>
    </record>

    <record id="action_workorder_dashboard" model="ir.actions.act_window">
        <field name="name">Workorders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban,form</field>
        <field name="context">{"search_default_workcenter": 1,
            "search_default_today": 1}</field>
        <field
            name="view_id"
            ref="impress_manufacturing_customizations.workorder_view_dashboard"
        />
    </record>

    <menuitem
        id="workorder_dashboard_menu"
        name="Workorder Dashboard"
        action="impress_manufacturing_customizations.action_workorder_dashboard"
        parent="mrp.menu_mrp_manufacturing"
        sequence="10"
    />
</odoo>
