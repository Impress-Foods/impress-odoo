<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="production_job_sheet">
        <t t-call="web.internal_layout">
            <div class="page">
                <div class="row">
                    <div class="col-7">
                        <h2>
                            <span t-field="o.name">MRP-001</span>
                        </h2>
                    </div>
                    <div class="col-5">
                        <span class="text-end">
                            <span
                                t-field="o.name"
                                t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:350px;height:60px'}"
                            >Package barcode</span>
                        </span>
                    </div>
                </div>
                <table class="table table-bordered o_table" style="margin-top: 27px;">
                    <tbody>
                        <tr style="height: 48px;">
                            <td style="width: 712px;">
                                <h5>
                                    <strong>Product:</strong>
                                    <span
                                        t-field="o.product_id.display_name"
                                    >Product:</span>
                                    <br />
                                </h5>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-bordered o_table">
                    <tbody class="w-100">
                        <tr>
                            <td style="width: 50%;">
                                <p class="mb-1">
                                    <strong>Quantity to Produce: &amp;nbsp;</strong>
                                    <span
                                        t-field="o.product_qty"
                                    >Quantity to produce</span>
                                    <span t-field="o.product_uom_id">Unit</span>
                                </p>
                                <p class="input_line">
                                    <strong class="label">Quantity Produced:</strong>
                                    <span class="line" />
                                </p>
                                <p class="input_line">
                                    <strong
                                        class="label"
                                    >Supervisor Verification:</strong>
                                    <span class="line" />
                                </p>
                                <p class="input_line">
                                    <strong class="label">Supervisor Note:</strong>
                                    <span class="line" />
                                </p>
                                <p class="extra_line" />
                                <p class="extra_line" />
                            </td>

                            <td style="width: 35%;">
                                <p class="mb-1">
                                    <strong>Date: &amp;nbsp;</strong>
                                    <span t-field="o.date_start">Production Date</span>
                                </p>
                                <p class="mb-1">
                                    <strong>125ml (kg): </strong>
                                    <span name="x_studio_125ml_kg">0 kg </span>
                                </p>
                                <p class="mb-1">
                                    <strong>500ml (kg):</strong>
                                    <span name="x_studio_500ml_kg">0 kg</span>
                                </p>
                                <p class="mb-1">
                                    <strong>Canadian (kg): </strong>
                                    <span name="x_studio_can_kg">0 kg</span>
                                </p>
                                <p class="mb-1">
                                    <strong>American (kg): </strong>
                                    <span name="x_studio_usa_kg_1">0 kg</span>
                                </p>
                            </td>

                            <td style="width: 25%;">
                                <span
                                    class="x_studio_field_l2DBU"
                                >Ligne de Production</span>
                                <ul class="o_checklist o_checklist_no_margin">
                                    <li id="checkId-1">Préparé</li>
                                    <li id="checkId-2">Pressé</li>
                                    <li id="checkId-3" class="input_line">
                                        <span class="label">pH</span>
                                        <span class="line" />
                                    </li>
                                    <li id="checkId-4">Embouteillé</li>
                                    <li id="checkId-5">Emball</li>
                                    <li id="checkId-6">Qualité</li>
                                    <li id="checkId-7">Odoo</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div>
                    <span name="x_studio_note_pour_la_production" />
                </div>
                <div t-if="o.move_raw_ids">
                    <h3>Components</h3>
                    <table class="table table-sm">
                        <t
                            t-set="has_product_barcode"
                            t-value="any(m.product_id.barcode for m in o.move_raw_ids)"
                        />
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th
                                    t-if="o.state in ('progress', 'to_close','done')"
                                    t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}"
                                >Consumed</th>
                                <th
                                    t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}"
                                >To Consume</th>
                                <th
                                    t-if="has_product_barcode"
                                    width="15%"
                                    class="text-center"
                                >Barcode</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.move_raw_ids" t-as="raw_line">
                                <td>
                                    <span t-field="raw_line.product_id">8 GB RAM</span>
                                </td>
                                <td
                                    t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}"
                                    t-if="o.state in ('progress', 'to_close','done')"
                                >
                                    <div>
                                        <span t-field="raw_line.quantity">2</span>
                                    </div>
                                </td>
                                <td
                                    t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}"
                                >
                                    <span t-field="raw_line.product_uom_qty">25</span>
                                    <span
                                        t-field="raw_line.product_uom"
                                        groups="uom.group_uom"
                                    >Pieces</span>
                                </td>
                                <td
                                    t-if="has_product_barcode"
                                    width="15%"
                                    class="text-center"
                                >
                                    <t t-if="raw_line.product_id.barcode">
                                        <span
                                            t-field="raw_line.product_id.barcode"
                                            t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:100%;height:35px'}"
                                        >12345678901</span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="report_job_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="impress_manufacturing_customizations.production_job_sheet" />
            </t>
        </t>
    </template>

    <record id="action_report_job_sheet" model="ir.actions.report">
        <field name="name">Job Sheet</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="impress.us_letter_internal" />
        <field
            name="report_name"
        >impress_manufacturing_customizations.report_job_sheet</field>
        <field
            name="report_file"
        >impress_manufacturing_customizations.report_job_sheet</field>
        <field name="print_report_name">'Job Sheet - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_mrp_production" />
        <field name="binding_type">report</field>
    </record>
</odoo>
