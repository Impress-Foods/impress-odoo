<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_actions_report_view_form_inherit" model="ir.ui.view">
        <field name="name">ir.actions.report.view.form.inherit</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_name']" position="after">
                <field name="print_report_id" invisible="report_type != 'api'" />
            </xpath>
        </field>
    </record>
</odoo>
