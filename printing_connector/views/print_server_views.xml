<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="print_server_view_list" model="ir.ui.view">
        <field name="name">print.server.view.list</field>
        <field name="model">print.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="url" />
            </list>
        </field>
    </record>

    <record id="print_server_view_form" model="ir.ui.view">
        <field name="name">print.server.view.form</field>
        <field name="model">print.server</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" />
                        <field name="url" />
                        <field name="api_key" />
                    </group>
                    <group>
                        <field name="timeout" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="action_print_server" model="ir.actions.act_window">
        <field name="name">Print servers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">print.server</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new print server.
            </p>
        </field>
    </record>
</odoo>
