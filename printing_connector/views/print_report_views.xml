<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="print_report_view_list" model="ir.ui.view">
        <field name="name">print.report.view.list</field>
        <field name="model">print.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="target_model_id" />
            </list>
        </field>
    </record>

    <record id="print_report_view_form" model="ir.ui.view">
        <field name="name">print.report.view.form</field>
        <field name="model">print.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" />
                        <field name="target_model_id" />
                    </group>
                </group>
                <group>
                    <field name="mapping_ids" />
                </group>
            </form>
        </field>
    </record>

    <record id="action_print_report" model="ir.actions.act_window">
        <field name="name">Print Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">print.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new print report.
            </p>
        </field>
    </record>
</odoo>
