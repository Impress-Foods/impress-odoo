<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="print_field_view_list" model="ir.ui.view">
        <field name="name">print.field.view.list</field>
        <field name="model">print.field</field>
        <field name="arch" type="xml">
            <list>
                <field name="target_field" />
                <field name="source_field" />
                <field name="field_type" />
                <field name="static_value" />
            </list>
        </field>
    </record>

    <record id="print_field_view_form" model="ir.ui.view">
        <field name="name">print.field.view.form</field>
        <field name="model">print.field</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="target_field" />
                        <field name="source_field" />
                    </group>
                    <group>
                        <field name="field_type" />
                        <field name="static_value" />
                        <field name="formatting" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="action_print_field" model="ir.actions.act_window">
        <field name="name">Print Fields</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">print.field</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new print field.
            </p>
        </field>
    </record>
</odoo>
