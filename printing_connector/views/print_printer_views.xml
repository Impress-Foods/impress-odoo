<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="print_printer_view_list" model="ir.ui.view">
        <field name="name">print.printer.view.list</field>
        <field name="model">print.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="technical_name" />
                <field name="server_id" />
            </list>
        </field>
    </record>

    <record id="print_printer_view_form" model="ir.ui.view">
        <field name="name">print.printer.view.form</field>
        <field name="model">print.printer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" />
                        <field name="technical_name" />
                        <field name="server_id" />
                    </group>
                    <group />
                </group>
            </form>
        </field>
    </record>

    <record id="action_print_printer" model="ir.actions.act_window">
        <field name="name">Print printers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">print.printer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new printer.
            </p>
        </field>
    </record>
</odoo>
