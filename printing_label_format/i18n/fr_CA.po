#. module: printing_label_format
#: model_terms:ir.actions.act_window,help:printing_label_format.printing_label_size_action
msgid ""
"A label size is the physical stock a label is printed on. Add\n"
"                one before writing a report for it."
msgstr ""
"Une taille d'étiquette est un format physique. Ajoutez-en un avant de "
"rédiger un rapport lui étant destiné."

