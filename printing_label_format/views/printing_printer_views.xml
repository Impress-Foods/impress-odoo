<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="printing_printer_view_form" model="ir.ui.view">
        <field name="name">printing.printer.form (in printing_label_format)</field>
        <field name="model">printing.printer</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_printer_view_form"
        />
        <field name="arch" type="xml">
            <field name="backend" position="after">
                <field name="label_format" />
                <field name="label_size_id" />
            </field>
        </field>
    </record>

    <record id="printing_printer_view_tree" model="ir.ui.view">
        <field name="name">printing.printer.list (in printing_label_format)</field>
        <field name="model">printing.printer</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_printer_view_tree"
        />
        <field name="arch" type="xml">
            <field name="backend" position="after">
                <field name="label_format" optional="show" />
            </field>
        </field>
    </record>
</odoo>
