<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_actions_report_view_form" model="ir.ui.view">
        <field name="name">ir.actions.report.form.inherit.label.format</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <!-- The size is declared here, so it is edited here. It is not
                 guarded on the dashboard flag: that flag lives downstream and
                 a report type the map does not know yet must still be able to
                 carry a size. -->
            <field name="report_type" position="after">
                <field name="label_size" />
            </field>
        </field>
    </record>
</odoo>
