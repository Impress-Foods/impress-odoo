<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_campaign_company_rule" model="ir.rule">
        <field name="name">Campaign multi-company</field>
        <field name="model_id" ref="model_mrp_campaign" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]" />
    </record>
</odoo>
