<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="mrp_campaign.PartitionAllocationWidget" owl="1">
        <div class="o_campaign_partition_allocation_container">
            <table class="o_list_table table table-sm table-hover table-striped">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Original Demand</th>
                        <th t-esc="destinationALabel" />
                        <th t-esc="destinationBLabel" />
                    </tr>
                </thead>
                <tbody>
                    <t t-if="!state.demands.length">
                        <tr>
                            <td
                                colspan="4"
                                class="text-center text-muted"
                            >No demand lines to allocate.</td>
                        </tr>
                    </t>
                    <t t-else="">
                        <t t-foreach="state.demands" t-as="demand" t-key="demand.id">
                            <tr>
                                <td><t t-out="demand.product[1]" /></td>
                                <td><t
                                        t-out="demand.current_target_qty.toFixed(2)"
                                    /> <t t-out="demand.product_uom_name" /></td>
                                <td>
                                    <input
                                        type="number"
                                        t-model.number="demand.allocated_to_a"
                                        t-on-change="(ev) => onAllocationChange(demand.id, 'allocated_to_a', ev.target.value)"
                                        class="o_input"
                                    />
                                </td>
                                <td>
                                    <input
                                        type="number"
                                        t-model.number="demand.allocated_to_b"
                                        t-on-change="(ev) => onAllocationChange(demand.id, 'allocated_to_b', ev.target.value)"
                                        class="o_input"
                                    />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>
