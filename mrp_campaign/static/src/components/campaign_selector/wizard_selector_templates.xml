<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="mrp_campaign.WizardSelector">
        <div class="wizard_selector d-flex gap-3 w-100" style="min-width: 0;">
            <div
                class="available_panel border rounded p-2"
                style="flex: 1 1 0; min-width: 0;"
            >
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Available Lines</h6>
                    <span class="badge bg-secondary" t-esc="availableItems.length" />
                </div>
                <div class="mb-2">
                    <input
                        type="text"
                        class="form-control form-control-sm"
                        placeholder="Search..."
                        t-ref="search-available"
                        t-on-input="filterAvailable"
                    />
                </div>
                <div class="list-group overflow-auto" style="max-height: 35vh;">
                    <t t-foreach="displayedAvailable" t-as="item" t-key="item.id">
                        <div
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2"
                        >
                            <div
                                class="flex-grow-1 me-2"
                                style="cursor: pointer; overflow: hidden;"
                                t-on-click="() => this.addToSelected(item)"
                            >
                                <div class="fw-bold text-truncate" t-esc="item.name" />
                                <div class="small text-muted">
                                    <span t-if="item.qty" t-esc="item.qty" />
                                    <span
                                        t-if="item.date"
                                        class="ms-2"
                                        t-esc="item.date"
                                    />
                                    <span
                                        t-if="item.additional_ref"
                                        class="ms-2 text-truncate"
                                        t-esc="item.additional_ref"
                                    />
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-primary flex-shrink-0"
                                title="Add to selection"
                                t-on-click="() => this.addToSelected(item)"
                            >
                                <i class="fa fa-plus" />
                            </button>
                        </div>
                    </t>
                    <t t-if="displayedAvailable.length === 0">
                        <div class="list-group-item text-center text-muted py-3">
                            <em>No available lines</em>
                        </div>
                    </t>
                </div>
            </div>

            <div class="selection_controls d-flex flex-column justify-content-center">
                <button
                    type="button"
                    class="btn btn-sm btn-secondary mb-1"
                    title="Add all"
                    t-on-click="addAllToSelected"
                    t-att-disabled="!hasAvailable"
                >
                    <i class="fa fa-forward" />
                </button>
                <button
                    type="button"
                    class="btn btn-sm btn-secondary mb-1"
                    title="Remove all"
                    t-on-click="removeAllFromSelected"
                    t-att-disabled="!hasSelected"
                >
                    <i class="fa fa-backward" />
                </button>
            </div>

            <div
                class="selected_panel border rounded p-2"
                style="flex: 1 1 0; min-width: 0;"
            >
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Selected Lines</h6>
                    <span class="badge bg-secondary" t-esc="selectedItems.length" />
                </div>
                <div class="mb-2">
                    <input
                        type="text"
                        class="form-control form-control-sm"
                        placeholder="Search..."
                        t-ref="search-selected"
                        t-on-input="filterSelected"
                    />
                </div>
                <div class="list-group overflow-auto" style="max-height: 35vh;">
                    <t t-foreach="displayedSelected" t-as="item" t-key="item.id">
                        <div
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2"
                        >
                            <div
                                class="flex-grow-1 me-2"
                                style="cursor: pointer; overflow: hidden;"
                                t-on-click="() => this.removeFromSelected(item)"
                            >
                                <div class="fw-bold text-truncate" t-esc="item.name" />
                                <div class="small text-muted">
                                    <span t-if="item.qty" t-esc="item.qty" />
                                    <span
                                        t-if="item.date"
                                        class="ms-2"
                                        t-esc="item.date"
                                    />
                                    <span
                                        t-if="item.additional_ref"
                                        class="ms-2 text-truncate"
                                        t-esc="item.additional_ref"
                                    />
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger flex-shrink-0"
                                title="Remove from selection"
                                t-on-click="() => this.removeFromSelected(item)"
                            >
                                <i class="fa fa-minus" />
                            </button>
                        </div>
                    </t>
                    <t t-if="displayedSelected.length === 0">
                        <div class="list-group-item text-center text-muted py-3">
                            <em>No selected lines</em>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
