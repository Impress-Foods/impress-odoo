<t t-name="mrp_campaign.CampaignNode">
    <div t-attf-class="campaign-node mb-3 #{props.isRoot ? 'root-node' : 'child-node'}">
        <div class="card shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold" t-esc="props.node.product_name" />
                        <div class="small"> Ratio: <t t-esc="props.node.ratio" /> | <t
                            t-esc="props.node.uom"
                        /></div>
                    </div>

                    <div class="text-end">
                        <div class="h5 mb-0 fw-bold">
                            <t t-esc="formatQty(props.node.quantities.planned)" />
                        </div>
                        <div class="small"> Target: <t
                            t-esc="formatQty(props.node.quantities.initial_planned)"
                        /> <t t-esc="props.node.uom" /></div>
                    </div>
                </div>
                <t t-set="initial" t-value="props.node.quantities.initial_planned" />
                <div class="production-bar-container mt-4 position-relative">
                    <div class="progress" style="height: 12px;">
                        <t
                            t-set="percentage"
                            t-value="initial ? (props.node.quantities.planned / initial) : 0"
                        />
                        <div
                            t-attf-class="progress-bar #{barColor}"
                            role="progressbar"
                            t-attf-style="width: #{ percentage * 100 }%;"
                        />
                    </div>
                    <t
                        t-set="floor"
                        t-value="initial ? (props.node.quantities.floor / initial) : 0"
                    />

                    <div
                        class="floor-marker"
                        t-if="props.node.quantities.floor != 0"
                        t-attf-style="left: #{ floor * 100 }%;"
                    >
                        <span class="floor-label">Min</span>
                    </div>

                    <div
                        t-if="props.node.quantities.planned > props.node.quantities.initial_planned"
                        class="text-white small fw-bold mt-1"
                    >
                        <i class="fa fa-warning" /> Exceeds capacity </div>
                </div>

                <t
                    t-if="props.node.quantities.planned &lt; props.node.quantities.floor"
                >
                    <div class="mt-2 small text-warning fw-bold">
                        <i class="fa fa-exclamation-circle me-1" /> Below floor: <t
                        t-esc="props.node.quantities.floor"
                    /> <t t-esc="props.node.uom" /> min. </div>
                </t>
            </div>
        </div>

        <div
            t-if="props.node.upstream_branches and props.node.upstream_branches.length"
            class="ms-4 mt-3 ps-3 border-start"
        >
            <t
                t-foreach="props.node.upstream_branches"
                t-as="branch"
                t-key="branch.line_id"
            >
                <t t-component="constructor" node="branch" />
            </t>
        </div>
    </div>
</t>
