<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <!-- View mrp.campaign.backorder.wizard form -->
    <record id="view_mrp_campaign_backorder_wizard_form" model="ir.ui.view">
        <field name="name">view.mrp.campaign.backorder.wizard.form</field>
        <field name="model">mrp.campaign.backorder.wizard</field>
        <field name="arch" type="xml">
            <form string="Mrp Campaign Backorder Wizard">
                <sheet>
                    <!-- <field name="line_ids">
                        <tree editable="1" create="0" delete="0">
                            <field name="demand_id" column_invisible="1" />
                            <field name="campaign_line_id" column_invisible="1" />
                            <field name="needed_anchor_qty" readonly="1" />
                            <field name="allocated_anchor_qty" />
                        </tree>
                    </field> -->

                    <field
                        name="allocation_json"
                        widget="campaign_allocation"
                        nolabel="1"
                    />

                </sheet>
                <footer>
                    <button
                        name="action_backorder_campaign"
                        string="Confirm Backorder"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
