<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_mrp_campaign_partition_wizard_form" model="ir.ui.view">
        <field name="name">mrp.campaign.partition.wizard.form</field>
        <field name="model">mrp.campaign.partition.wizard</field>
        <field name="arch" type="xml">
            <form string="Partition Campaign">
                <sheet>
                    <group>
                        <field name="campaign_id" readonly="1" />
                        <field name="partition_mode" widget="radio" />
                    </group>
                    <group invisible="'partition_mode', '!=', 'split'">
                        <field name="new_campaign_name_a" />
                        <field name="new_campaign_name_b" />
                    </group>
                    <field
                        name="partition_data_json"
                        widget="campaign_partition_allocation"
                        nolabel="1"
                    />
                </sheet>
                <footer>
                    <button
                        name="action_partition_campaign"
                        string="Confirm Partition"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Mrp Campaign Partition Wizard (to be used from mrp.campaign actions) -->
    <record id="action_mrp_campaign_partition_wizard" model="ir.actions.act_window">
        <field name="name">Partition Manufacturing Campaign</field>
        <field name="res_model">mrp.campaign.partition.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mrp_campaign.model_mrp_campaign" />
        <field name="binding_view_types">form</field>
    </record>

</odoo>
