<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View mrp.campaign.creator form -->
    <record id="view_mrp_campaign_creator_form" model="ir.ui.view">
        <field name="name">view.mrp.campaign.creator.form</field>
        <field name="model">mrp.campaign.creator</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="planned_date" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="make_campaign"
                        string="Create Campaign"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
