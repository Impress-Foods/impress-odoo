<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_mrp_campaign_tree" model="ir.ui.view">
        <field name="name">mrp.campaign.tree</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button
                        name="action_confirm_end"
                        type="object"
                        string="Confirm End Products"
                        class="oe_highlight"
                    />
                    <button
                        name="action_confirm_bulk"
                        type="object"
                        string="Confirm Bulk Products"
                        class="oe_highlight"
                    />
                    <button name="action_reset" type="object" string="Reset" class="" />
                </header>
                <field name="name" />
                <field name="product_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_mrp_campaign_form" model="ir.ui.view">
        <field name="name">mrp.campaign.form</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Campaign">
                <field name="end_created" invisible="1" />
                <field name="bulk_created" invisible="1" />
                <header>
                    <button
                        name="action_confirm_end"
                        type="object"
                        string="Make End Products"
                        class="btn-primary"
                        invisible="end_created"
                    />
                    <button
                        name="action_confirm_bulk"
                        type="object"
                        string="Make Bulk Products"
                        class="btn-primary"
                        invisible="bulk_created or not end_created"
                    />
                    <button
                        name="action_reset"
                        type="object"
                        string="Reset Campaign"
                        class="btn-primary"
                        invisible="not bulk_created and not end_created"
                    />
                    <field name="state" widget="statusbar" />
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_mos"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-flask"
                        >
                            <field
                                name="production_count"
                                widget="statinfo"
                                string="Productions"
                            />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="product_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="date_planned_start" />
                            <field name="bucket_start_date" readonly="1" />
                            <field name="bucket_end_date" readonly="1" />
                        </group>
                        <group>
                            <field name="campaign_color" widget="color" />
                            <field name="override_batch_size" widget="boolean_toggle" />
                            <field
                                name="batch_size"
                                required="override_batch_size"
                                invisible="not override_batch_size"
                            />
                        </group>

                    </group>

                    <notebook>
                        <page string="Campaign Line">
                            <field name="line_ids">
                                <tree>
                                    <field name="product_id" />
                                    <field
                                        name="product_demand_qty"
                                        string="Demand Qty"
                                    />
                                    <field name="product_uom_id" />
                                    <field
                                        name="anchor_product_qty"
                                        string="Required Component Qty"
                                        sum="Required Component Qty"
                                        optional="show"
                                    />
                                    <field name="component_uom_id" />
                                    <field name="bom_id" optional="hide" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_campaign_kanban" model="ir.ui.view">
        <field name="name">mrp.campaign.kanban</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="campaign_color" />
                <field name="lot_name" invisible="1" />
                <field
                    name="state"
                    invisible="1"
                    readonly="1"
                    on_change="1"
                    field_id="state_0"
                />
                <field name="date_planned_start" />
                <progressbar
                    field="state"
                    colors='{"draft": "muted", "confirmed": "info", "done": "success", "cancel": "danger"}'
                />

                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click"
                            t-attf-style="border-left: 4px solid {{record.campaign_color.raw_value}};"
                        >
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings ms-1">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div class="float-end text-end">
                                    <field name='sequence' widget="handle" />
                                </div>
                            </div>

                            <div class="o_kanban_record_body">
                                <field name="product_id" />
                                <span t-if="record.lot_name.value">
                                    <field name="lot_name" />
                                </span>
                                <br t-else="" />
                            </div>
                            <div class="o_kanban_record_bottom"> </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_mrp_campaign_search" model="ir.ui.view">
        <field name="name">mrp.campaign.search</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <search string="Seach Campaigns">
                <filter
                    name="today"
                    string="Today"
                    domain="[
                    ('date_planned_start', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                    ('date_planned_start', '&lt;=',  (context_today()).strftime('%Y-%m-%d'))
                ]"
                />

                <group expand="0" string="Group By...">
                    <filter
                        string="Date"
                        name="date"
                        domain="[]"
                        context="{'group_by': 'date_planned_start:day'}"
                        help="Date"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_campaign" model="ir.actions.act_window">
        <field name="name">Manufacturing Campaigns</field>
        <field name="res_model">mrp.campaign</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_date': 1}</field>
    </record>

    <menuitem
        id="menu_mrp_campaign"
        name="Campaigns"
        parent="mrp.menu_mrp_root"
        action="action_mrp_campaign"
        sequence="50"
        groups="mrp.group_mrp_user"
    />

</odoo>
