<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_production_form_campaign" model="ir.ui.view">
        <field name="name">mrp.production.form.campaign</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <!-- Smart button -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_campaign"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-object-group"
                    invisible="not campaign_id"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Production</span>
                        <span class="o_stat_text">Run</span>
                    </div>
                </button>
            </xpath>
            <xpath
                expr="//group[@name='group_extra_info']//label[@name='scheduled_date']"
                position="before"
            >
                <field name="date_deadline" readonly="1" />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="before">
                <field
                    name="campaign_id"
                    readonly="state in ['done','cancel']"
                    domain="['|',('product_id','=', product_id), ('product_id','=', anchor_product_id)]"
                />
            </xpath>
        </field>
    </record>
    <record id="view_mrp_production_filter_shop_floor" model="ir.ui.view">
        <field name="name">mrp.production.select.shop.floor.inherit</field>
        <field name="model">mrp.production</field>
        <field
            name="inherit_id"
            ref="mrp_workorder.view_mrp_production_filter_shop_floor"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[last()]" position="after">
                <field name="campaign_id" string="Campaign" />
            </xpath>
        </field>
    </record>
</odoo>
