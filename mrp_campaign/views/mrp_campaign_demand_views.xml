<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mrp_campaign_demand_form" model="ir.ui.view">
        <field name="name">mrp.campaign.demand.form</field>
        <field name="model">mrp.campaign.demand</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="campaign_id" />
                        <field name="product_id" />
                        <field name="product_uom_id" />
                    </group>
                    <group>
                        <field name="product_tmpl_id" invisible="1" />
                        <field
                            name="bom_id"
                            domain="['|', ('product_tmpl_id','=', product_tmpl_id), ('product_id', '=', product_id)]"
                        />
                        <field name="campaign_line_id" />
                        <field name="target_qty" />
                    </group>
                </group>

                <field
                    name="target_ids"
                    nolabel="1"
                    style="--fieldWidget-display: inline;"
                />
            </form>
        </field>
    </record>
    <record id="view_mrp_campaign_demand_tree" model="ir.ui.view">
        <field name="name">mrp.campaign.demand.tree</field>
        <field name="model">mrp.campaign.demand</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="product_id" />
                <field name="target_qty" />
                <field name="bom_id" />
            </tree>
        </field>
    </record>

    <record id="action_mrp_campaign_demand" model="ir.actions.act_window">
        <field name="name">Manufacturing Campaign Demands</field>
        <field name="res_model">mrp.campaign.demand</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="view_mrp_campaign_demand_target_form" model="ir.ui.view">
        <field name="name">mrp.campaign.demand.target.form</field>
        <field name="model">mrp.campaign.demand.target</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="demand_id" />
                        <field name="workflow_type" />
                        <field name="target_id" />
                    </group>
                    <group>
                        <field name="promised_qty" />
                        <field name="is_fully_planned" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_mrp_campaign_demand_target_tree" model="ir.ui.view">
        <field name="name">mrp.campaign.demand.target.tree</field>
        <field name="model">mrp.campaign.demand.target</field>
        <field name="arch" type="xml">
            <tree>
                <field name="demand_id" />
                <field name="workflow_type" />
                <field name="target_id" />
                <field name="promised_qty" />
                <field name="is_fully_planned" />
            </tree>
        </field>
    </record>

    <record id="action_mrp_campaign_demand_target" model="ir.actions.act_window">
        <field name="name">Manufacturing Campaign Demand Targets</field>
        <field name="res_model">mrp.campaign.demand.target</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_mrp_campaign_demand"
        active="false"
        name="Campaign Demands"
        parent="mrp_campaign.menu_mrp_campaign"
        action="action_mrp_campaign_demand"
        sequence="2"
        groups="mrp.group_mrp_user"
    />
    <!-- <menuitem
        id="menu_mrp_campaign_demand_target"
        name="Campaign Demand Targets"
        parent="mrp_campaign.menu_mrp_campaign"
        action="action_mrp_campaign_demand_target"
        sequence="99"
        groups="mrp.group_mrp_user"
    /> -->
</odoo>
