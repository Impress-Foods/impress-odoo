<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_mrp_campaign_tree" model="ir.ui.view">
        <field name="name">mrp.campaign.tree</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" />
                </header>
                <field name="name" />
                <field name="product_id" />
                <field name="state" />
                <field name="total_demand_qty" />
            </tree>
        </field>
    </record>

    <record id="view_mrp_campaign_form" model="ir.ui.view">
        <field name="name">mrp.campaign.form</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Campaign">
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm Campaign"
                        class="btn-primary"
                        invisible="state not in ['draft']"
                    />
                    <button
                        name="%(action_report_mrp_campaign)d"
                        type="action"
                        string="Print Tracking Report"
                        class="btn-primary"
                    />
                    <field name="state" widget="statusbar" />
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_provider_mos"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-flask"
                        >
                            <field
                                name="provider_mo_count"
                                widget="statinfo"
                                string="In"
                            />
                        </button>

                        <button
                            name="action_view_consumer_mos"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes"
                        >
                            <field
                                name="consumer_mo_count"
                                widget="statinfo"
                                string="Out"
                            />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="product_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="total_demand_qty" readonly="1" />
                            <field name="percent_fulfilled" widget="percentpie" />
                        </group>
                        <group>
                            <field name="color" widget="color" />
                            <field name="override_batch_size" widget="boolean_toggle" />
                            <field
                                name="batch_size"
                                required="override_batch_size"
                                invisible="not override_batch_size"
                            />
                        </group>

                    </group>

                    <notebook>

                        <!-- Demand -->
                        <page string="Consumers">
                            <field name="consumer_mo_ids">
                                <tree
                                    decoration-info="state == 'draft'"
                                    decoration-danger="state == 'cancel'"
                                >
                                    <field name="display_name" />
                                    <field name="product_id" />
                                    <field name="product_qty" sum="Total" />
                                    <field
                                        name="campaign_product_qty"
                                        string="Quantity needed"
                                        sum="Total"
                                    />
                                    <field name="state" />

                                </tree>
                            </field>
                        </page>

                        <!-- Supply -->
                        <page string="Producers">
                            <field name="provider_mo_ids">
                                <tree
                                    decoration-info="state == 'draft'"
                                    decoration-danger="state == 'cancel'"
                                >
                                    <field name="name" />
                                    <field name="product_qty" sum="Total" />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_campaign_kanban" model="ir.ui.view">
        <field name="name">mrp.campaign.kanban</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="color" />
                <field name="lot_id" invisible="1" />
                <field
                    name="state"
                    invisible="1"
                    readonly="1"
                    on_change="1"
                    field_id="state_0"
                />
                <field name="date_start" />
                <field name="date_end" />
                <progessbar
                    field="state"
                    colors='{"draft": "muted", "confirmed": "info", "done": "success", "cancel": "danger"}'
                />

                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click"
                            t-attf-style="border-left: 1px solid {{record.color}};"
                        >
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings ms-1">
                                    <strong class="o_kanban_record_title"><field
                                            name="name"
                                        /></strong>
                                </div>
                                <div class="float-end text-end">
                                    <field name='sequence' widget="handle" />
                                </div>
                            </div>

                            <div class="o_kanban_record_body">
                                <span t-if="record.lot_id.value">
                                    <field name="lot_id" />
                                </span>
                                <br t-else="" />
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span><field name="date_start" /> - <field
                                        name="date_end"
                                    /></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_mrp_campaign_search" model="ir.ui.view">
        <field name="name">mrp.campaign.search</field>
        <field name="model">mrp.campaign</field>
        <field name="arch" type="xml">
            <search string="Seach Campaigns">
                <filter
                    name="today"
                    string="Today"
                    domain="[
                    ('date_start', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                    ('date_start', '&lt;=',  (context_today()).strftime('%Y-%m-%d'))
                ]"
                />

                <group expand="0" string="Group By...">
                    <filter
                        string="Date"
                        name="date"
                        domain="[]"
                        context="{'group_by': 'date_start:day'}"
                        help="Date"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_campaign" model="ir.actions.act_window">
        <field name="name">Manufacturing Campaigns</field>
        <field name="res_model">mrp.campaign</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_date': 1}</field>
    </record>

    <menuitem
        id="menu_mrp_campaign"
        name="Campaigns"
        parent="mrp.menu_mrp_root"
        action="action_mrp_campaign"
        sequence="50"
        groups="mrp.group_mrp_user"
    />

</odoo>
