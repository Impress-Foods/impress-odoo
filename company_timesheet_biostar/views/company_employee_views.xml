<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BioStar ID lives next to the internal identification fields. -->
    <record id="view_company_employee_biostar_form" model="ir.ui.view">
        <field name="name">company.employee.biostar.form</field>
        <field name="model">company.employee</field>
        <field name="inherit_id" ref="company_employee.view_company_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification']" position="inside">
                <field name="biostar_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_employee_biostar_list" model="ir.ui.view">
        <field name="name">company.employee.biostar.list</field>
        <field name="model">company.employee</field>
        <field name="inherit_id" ref="company_employee.view_company_employee_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_ref']" position="after">
                <field name="biostar_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_employee_biostar_search" model="ir.ui.view">
        <field name="name">company.employee.biostar.search</field>
        <field name="model">company.employee</field>
        <field name="inherit_id" ref="company_employee.view_company_employee_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_ref']" position="after">
                <field name="biostar_id"/>
            </xpath>
        </field>
    </record>
</odoo>
