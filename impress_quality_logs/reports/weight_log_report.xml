<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="report_weight_log_view"
        inherit_id="report_quality_log_main"
        primary="True"
    />
    <template id="report_weight_log">
        <t t-call="impress_quality_logs.report_weight_log_view" t-lang="user.lang" />
    </template>
    <record id="action_report_weight_log" model="ir.actions.report">
        <field name="name">weight Log PDF</field>
        <field name="model">weight.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">impress_quality_logs.report_weight_log</field>
        <field name="report_file">impress_quality_logs.report_weight_log</field>
        <field
            name="print_report_name"
        >'weight Log - %s' % (object.name if object and object.exists() else 'DELETED')</field>
        <field name="binding_model_id" ref="model_weight_log" />
        <field name="binding_type">report</field>
    </record>

</odoo>
