<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="quality_point_view_list_inherit" model="ir.ui.view">
        <field name="name">quality.point.list.inherit</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="log_type_id" />
            </field>
        </field>
    </record>

    <record id="quality_point_view_form_inherit" model="ir.ui.view">
        <field name="name">quality.point.form.inherit</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_form" />
        <field name="arch" type="xml">
            <field name="worksheet_template_id" position="before">
                <field name="log_type_id" invisible="test_type != 'worksheet'" />
            </field>
        </field>
    </record>
</odoo>
