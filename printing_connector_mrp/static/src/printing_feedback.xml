<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="printing_connector_mrp.PrintOutcomeDialog">
        <div class="o_tablet_popups">
            <Dialog size="'sm'" modalRef="modalRef">
                <t t-set-slot="header">
                    <div class="d-flex w-100">
                        <div class="h4" t-esc="props.title"/>
                        <div t-on-click="_cancel" type="button" class="btn-close" aria-label="Close"/>
                    </div>
                </t>
                <div t-att-class="'alert border-0 mb-0 ' + (props.type === 'success' ? 'alert-success' : props.type === 'danger' ? 'alert-danger' : 'alert-info')">
                    <div t-out="props.body"/>
                </div>
                <t t-set-slot="footer">
                    <button class="btn btn-primary" t-on-click="_cancel" t-out="props.confirmLabel"/>
                </t>
            </Dialog>
        </div>
    </t>

</templates>
