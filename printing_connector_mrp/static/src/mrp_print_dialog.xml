<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="printing_connector_mrp.PrintDialog">
        <div class="o_tablet_popups">
            <Dialog size="'md'" modalRef="modalRef">
                <t t-set-slot="header">
                    <div class="d-flex w-100">
                        <div class="h4" t-esc="'Print'"/>
                        <div t-on-click="_cancel" type="button" class="btn-close" aria-label="Close"/>
                    </div>
                </t>
                <div class="o_mrp_print_dialog">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label for="qty" class="form-label mb-0">Quantity</label>
                        <input id="qty" t-model.number.lazy="state.qty" type="number" class="form-control w-50"/>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <label for="printer" class="form-label mb-0">Printer</label>
                        <select id="printer" t-model.lazy.number="state.printer_id" class="form-select w-50">
                            <option t-foreach="state.printers" t-as="printer" t-key="printer.id" t-att-value="printer.id" t-out="printer.name"/>
                        </select>
                    </div>

                    <ul class="list-group" style="align-items: center;">
                        <li class="list-group-item d-flex justify-content-between align-items-center border-start-0 border-end-0 px-0 w-50"
                            t-foreach="state.data" t-as="field" t-key="field">
                            <span class="text-muted" t-out="field"/>
                            <span class="fw-bold" t-out="field_value"/>
                        </li>
                    </ul>
                </div>
                <t t-set-slot="footer">
                    <button class="btn btn-primary me-2" t-on-click="validate" t-out="props.confirmLabel"/>
                    <button class="btn btn-secondary" t-on-click="_cancel" t-out="props.cancelLabel" />
                </t>
            </Dialog>
        </div>
    </t>

</templates>
