<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="domino_print_template_tree" model="ir.ui.view">
        <field name="name">domino.print.template.tree</field>
        <field name="model">domino.print.template</field>
        <field name="arch" type="xml">
            <list string="Domino Print Templates">
                <field name="name" />
                <field name="print_type" />
                <field name="domino_label_id" />
            </list>
        </field>
    </record>
    <record id="domino_print_template_form" model="ir.ui.view">
        <field name="name">domino.print.template.form</field>
        <field name="model">domino.print.template</field>
        <field name="arch" type="xml">
            <form string="Domino Print Template">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="print_type" />
                        <field name="domino_label_id" />
                        <field name="work_center_ids" widget="many2many_tags" />
                    </group>
                    <group string="Field Mappings">
                        <field name="field_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="domino_print_template_action" model="ir.actions.act_window">
        <field name="name">Domino Print Templates</field>
        <field name="res_model">domino.print.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="domino_print_template_menu"
        name="Print Templates"
        parent="base.menu_config"
        action="domino_print_template_action"
        sequence="90"
    />
</odoo>
