<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="domino_print_field_tree" model="ir.ui.view">
        <field name="name">domino.print.field.tree</field>
        <field name="model">domino.print.field</field>
        <field name="arch" type="xml">
            <list string="Domino Print Fields">
                <field name="name" />
                <field name="odoo_field_path" />
                <field name="target_field" />
                <field name="transform" />
                <field name="required" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="domino_print_field_form" model="ir.ui.view">
        <field name="name">domino.print.field.form</field>
        <field name="model">domino.print.field</field>
        <field name="arch" type="xml">
            <form string="Domino Print Field">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" />
                            <field name="field_type" />
                            <field
                                name="odoo_field_path"
                                invisible="field_type != 'dynamic'"
                            />
                            <field name="target_field" required="1" />
                        </group>
                        <group>
                            <field name="transform" />
                            <field
                                name="default_value"
                                required="field_type == 'static'"
                            />
                            <field
                                name="data_id"
                                invisible="field_type != 'data'"
                                required="field_type=='data'"
                            />
                            <field
                                name="data_value"
                                invisible="field_type != 'data'"
                                required="field_type=='data'"
                            />
                            <field name="required" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="domino_print_field_action" model="ir.actions.act_window">
        <field name="name">Domino Print Fields</field>
        <field name="res_model">domino.print.field</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="domino_print_field_menu"
        name="Print Fields"
        parent="base.menu_config"
        action="domino_print_field_action"
        sequence="100"
    />
</odoo>
