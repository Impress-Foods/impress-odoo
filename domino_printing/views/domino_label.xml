<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="domino_label_tree" model="ir.ui.view">
        <field name="name">domino.label.tree</field>
        <field name="model">domino.label</field>
        <field name="arch" type="xml">
            <list string="Domino Labels">
                <field name="name" readonly="1" />
                <field name="printer_ids" widget="many2many_tags" readonly="1" />
                <field name="domino_id" readonly="1" />
            </list>
        </field>
    </record>
    <record id="domino_label_form" model="ir.ui.view">
        <field name="name">domino.label.form</field>
        <field name="model">domino.label</field>
        <field name="arch" type="xml">
            <form string="Domino Label">
                <sheet>
                    <group>
                        <field name="name" readonly="1" />
                    </group>
                    <group>
                        <field
                            name="printer_ids"
                            widget="many2many_tags"
                            readonly="1"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="domino_label_action" model="ir.actions.act_window">
        <field name="name">Domino Labels</field>
        <field name="res_model">domino.label</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
