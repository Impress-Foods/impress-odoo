<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View res.config.settings form -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="after">
                <block title="Domino" name="domino_setting_container">
                    <setting id="API endpoint for Domino connector">
                        <field
                            name="domino_api_endpoint"
                            string="Domino API Endpoint"
                        />
                    </setting>
                    <setting id="API key for Domino connector">
                        <field name="domino_api_key" string="Domino API Key" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
