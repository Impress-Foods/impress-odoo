<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View product.product form -->
    <record id="view_product_product_form" model="ir.ui.view">
        <field name="name">view.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook[1]" position="inside">
                <page string="Maintenance" name="maintenance">
                    <group>
                        <group>
                            <field
                                name="maintenance_equipment_ids"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="vendor_code" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="product_view_kanban_catalog" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.purchase_stock</field>
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="purchase_stock.product_view_kanban_catalog_purchase_only"
        />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('o_kanban_record_top')]/div[2]"
                position="after"
            >
                <div t-if="record.current_vendor_code.value"> [<field
                        name="current_vendor_code"
                    />] </div>
            </xpath>
        </field>
    </record>

</odoo>
