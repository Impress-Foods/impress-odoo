<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="shop_floor_usability.AdditionalNoteDialog">
        <div class="o_tablet_popups">
            <Dialog size="'md'" modalRef="modalRef">
                <t t-set-slot="header">
                    <div class="d-flex w-100">
                        <div class="h4">Additional Note</div>
                        <div
                            t-on-click="_cancel"
                            type="button"
                            class="btn-close"
                            aria-label="Close"
                        />
                    </div>
                </t>
                <TextField name="'additional_note'" record="props.record" />
                <t t-set-slot="footer">
                    <button
                        t-on-click="saveAndClose"
                        class="btn btn-primary"
                    >Save and Close</button>
                    <button
                        t-on-click="_cancel"
                        class="btn btn-secondary"
                    >Cancel</button>
                </t>
            </Dialog>
        </div>
    </t>
</templates>
