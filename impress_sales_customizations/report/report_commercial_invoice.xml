<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_commercial_invoice_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat" />

            <t t-set="address">
                <strong>Seller</strong>
                <div
                    t-field="doc.company_id.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": False}'
                />
            </t>
            <t
                t-if="doc.partner_shipping_id == doc.partner_invoice_id
                             and doc.partner_invoice_id != doc.partner_id
                             or doc.partner_shipping_id != doc.partner_invoice_id"
            >
                <t t-set="information_block">
                    <strong>Buyer</strong>
                    <div
                        t-field="doc.partner_invoice_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": False}'
                    />
                    <strong class="d-block mt-3">Deliver to</strong>
                    <div
                        t-field="doc.partner_shipping_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": False}'
                    />
                </t>
            </t>
            <div class="page">
                <t t-set="layout_document_title">
                    <span>Commercial Invoice #<span t-field="doc.name" /></span>
                </t>

                <div class="row mb-4" id="informations">
                    <div t-if="doc.date_order" class="col" name="informations_date">
                        <strong>Date</strong>
                        <div
                            t-field="doc.date_order"
                            t-options='{"widget": "date"}'
                        >2023-12-31</div>
                    </div>
                    <div t-if="doc.user_id.name" class="col">
                        <strong>Salesperson</strong>
                        <div t-field="doc.user_id">Mitchell Admin</div>
                    </div>
                    <div t-if="doc.company_id.country_id" class="col">
                        <strong>Country of Origin</strong>
                        <div
                            t-field="doc.company_id.country_id.display_name"
                        >United States of America</div>
                    </div>
                    <div t-if="doc.port_of_entry" class="col">
                        <strong>Port of Entry</strong>
                        <div t-field="doc.port_of_entry">Port Huron, MI</div>
                    </div>
                    <div t-if="doc.currency_id" class="col">
                        <strong>Currency</strong>
                        <div t-field="doc.currency_id.full_name">Canadian Dollars</div>
                    </div>
                </div>

                <!-- Is there a discount on at least one line? -->
                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()" />
                <t
                    t-set="display_discount"
                    t-value="any(l.discount for l in lines_to_report)"
                />
                <!-- Hide taxes AND show taxed amounts on lines -->
                <t t-set="hide_taxes_details" t-value="False" />
                <t
                    t-set="display_taxes"
                    t-value="not hide_taxes_details and any(l._has_taxes() for l in lines_to_report)"
                />

                <t
                    t-set="format_number"
                    t-value="lambda x: int(x) if x == int(x) else round(x, 2)"
                />
                <table class="o_has_total_table table o_main_table table-borderless">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description" class="text-start">
                                <strong>Description of Goods</strong>
                            </th>
                            <th
                                name="th_hts"
                                class="text-end text-nowrap"
                            >Hts Number</th>
                            <th
                                name="th_weight_gross"
                                class="text-end"
                            >Gross Wt. (kg)</th>
                            <th name="th_weight_ney" class="text-end">Net Wt. (kg)</th>
                            <th
                                name="th_quantity"
                                class="text-end text-nowrap"
                            >Quantity</th>
                            <th
                                name="th_priceunit"
                                class="text-end text-nowrap"
                            >Unit Price</th>
                            <th name="th_subtotal" class="text-end">
                                <span>Total</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="total_qty" t-value="0" />

                        <t t-set="current_section" t-value="None" />
                        <t t-set="current_subsection" t-value="None" />
                        <t
                            t-set="price_field"
                            t-value="'price_total' if hide_taxes_details else 'price_subtotal'"
                        />

                        <t t-foreach="lines_to_report" t-as="line">
                            <t
                                t-set="is_note"
                                t-value="line.display_type == 'line_note'"
                            />
                            <t
                                t-set="is_section"
                                t-value="line.display_type == 'line_section'"
                            />
                            <t
                                t-set="is_subsection"
                                t-value="line.display_type == 'line_subsection'"
                            />
                            <t
                                t-set="is_combo"
                                t-value="line.product_type == 'combo'"
                            />

                            <t t-if="is_section">
                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subsection" t-value="None" />
                                <t t-set="line_padding" t-value="0" />
                                <t
                                    t-set="collapse_prices"
                                    t-value="line.collapse_prices"
                                />
                            </t>
                            <t t-elif="is_subsection">
                                <t t-set="current_subsection" t-value="line" />
                                <t t-set="line_padding" t-value="2" />
                                <t
                                    t-set="collapse_prices"
                                    t-value="collapse_prices or line.collapse_prices"
                                />
                            </t>
                            <t t-else="">
                                <t
                                    t-set="line_padding"
                                    t-value="3 if current_subsection else (2 if current_section else 0)"
                                />
                            </t>

                            <t t-if="line.combo_item_id">
                                <t t-set="line_padding" t-value="line_padding + 1" />
                            </t>

                            <t
                                t-set="padding_class"
                                t-value="line_padding and ('px-' + str(line_padding)) or ''"
                            />
                            <t
                                t-set="show_section_total"
                                t-value="is_section or not line.parent_id.collapse_prices"
                            />

                            <t>
                                <tr
                                    t-if="is_section or is_subsection"
                                    name="tr_section"
                                    t-att-class="'fw-bolder o_line_section' if is_section else 'fw-bold o_line_subsection'"
                                >
                                    <t
                                        t-set="section_name_colspan"
                                        t-value="5 + (1 if display_discount else 0) + (1 if display_taxes else 0)"
                                    />
                                    <t t-if="not show_section_total">
                                        <t t-set="section_name_colspan" t-value="99" />
                                    </t>
                                    <td
                                        name="td_section_name"
                                        t-att-colspan="section_name_colspan"
                                        t-att-class="padding_class"
                                    >
                                        <span t-field="line.name">A section title</span>
                                    </td>
                                    <td
                                        t-if="show_section_total"
                                        name="td_section_price"
                                        class="text-end o_price_total"
                                    >
                                        <span
                                            name="price_subtotal_section"
                                            t-out="line._get_section_totals(price_field)"
                                            class="text-nowrap"
                                            t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                        >
                                            27.00
                                        </span>
                                    </td>
                                </tr>
                                <tr
                                    t-elif="is_note"
                                    name="tr_note"
                                    class="fst-italic o_line_note"
                                >
                                    <td
                                        name="td_note_name"
                                        colspan="99"
                                        t-att-class="padding_class"
                                    >
                                        <span
                                            t-field="line.name"
                                        >A note, whose content usually applies to the section or product above.</span>
                                    </td>
                                </tr>

                                <tr t-else="" name="tr_product">
                                    <td
                                        name="td_product_name"
                                        t-att-class="padding_class"
                                    >
                                        <span
                                            t-if="line.product_id.description_sale"
                                            t-field="line.product_id.description_sale"
                                        >Bacon Burger</span>
                                        <span
                                            t-elif="line.product_id.display_name"
                                            t-field="line.product_id.display_name"
                                        >Bacon Burger</span>
                                        <span
                                            t-else=""
                                            t-field="line.name"
                                        >Bacon Burger</span>
                                    </td>
                                    <td name="td_hts" class="padding_class text-end">
                                        <name t-field="line.product_id.hs_code" />
                                    </td>
                                    <td name="td_gross_weight" class="text-end">
                                        <name t-field="line.ordered_gross_weight" />
                                    </td>
                                    <td name="td_net_weight" class="text-end">
                                        <name t-field="line.ordered_net_weight" />
                                    </td>
                                    <td
                                        name="td_product_quantity"
                                        class="o_td_quantity text-end"
                                    >
                                        <t
                                            t-set="total_qty"
                                            t-value="total_qty + line.product_uom_qty"
                                        />
                                        <span
                                            t-out="format_number(line.product_uom_qty)"
                                            class="text-nowrap"
                                        >3</span>
                                        <span t-field="line.product_uom_id">units</span>
                                        <span
                                            t-if="line.product_uom_id != line.product_id.uom_id"
                                            class="text-muted small"
                                        >
                                            <t
                                                t-set="quantity_in_product_uom"
                                                t-value="line.product_uom_id._compute_quantity(line.product_uom_qty, line.product_id.uom_id)"
                                            />
                                            <br />
                                            <span
                                                t-esc="quantity_in_product_uom"
                                                t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"
                                            />
                                            <span t-field="line.product_id.uom_id" />
                                        </span>
                                    </td>
                                    <td
                                        name="td_product_priceunit"
                                        class="text-end text-nowrap"
                                    >
                                        <span
                                            t-if="not collapse_prices"
                                            t-field="line.price_unit"
                                            t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                        >
                                            25.00
                                        </span>
                                    </td>

                                    <td
                                        name="td_product_subtotal"
                                        class="text-end o_price_total"
                                    >
                                        <span t-field="line.price_subtotal">
                                            27.00
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <tr class="o_top_border">
                            <td />
                            <td />
                            <td class="text-end">
                                <span t-out="'%.1f' % doc.ordered_gross_weight" />
                            </td>
                            <td class="text-end">
                                <span t-out="'%.1f' % doc.ordered_net_weight" />
                            </td>
                            <td class="text-end">
                                <span t-out="format_number(total_qty)" />
                            </td>
                            <td class="text-end" colspan="2">
                                <span>Invoice total:</span>
                                <span t-field="doc.amount_untaxed" />
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-5">
                    <div class="col-6">
                        <div>
                            <p>
                                I declare that the information on this invoice is true and correct to the best of my knowledge.
                            </p>
                        </div>
                        <div
                            style="border-top: 1px solid #000; width: 250px; margin-top: 60px;"
                        />
                        <p class="mb-0">
                            <strong>Signature</strong>
                        </p>
                        <!-- <p
                            class="text-muted"
                            t-out="env.user.name"
                        >Name of authorized person</p> -->
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_commercial_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="impress_sales_customizations.report_commercial_invoice_document"
                    t-lang="doc.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_commercial_invoice" model="ir.actions.report">
        <field name="name">Commercial Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >impress_sales_customizations.report_commercial_invoice</field>
        <field
            name="report_file"
        >impress_sales_customizations.report_commercial_invoice</field>
        <field
            name="print_report_name"
        >"Commercial Invoice - %s - %s" % (object.partner_id.name or "", object.name)</field>
        <field name="binding_model_id" ref="model_sale_order" />
        <field name="binding_type">report</field>
    </record>
</odoo>
