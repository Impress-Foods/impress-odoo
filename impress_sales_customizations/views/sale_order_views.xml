<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_gantt" model="ir.ui.view">
        <field name="name">sale.order.view.gantt</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <gantt
                date_start="date_order"
                date_stop="date_order"
                default_scale="week"
                scales="week,month,year"
                string="Sales Orders"
                display_unavailability="false"
                precision="{'day':'hour:half','week':'day:half'}"
                total_row="false"
                decoration-danger="state == 'cancel'"
                color="id"
            >
                <field name="state" />
                <field name="partner_id" />
                <field name="invoice_status" />
                <templates>
                    <div t-name="gantt-popover">
                        <div t-if="partner_id">
                            <strong>Customer — </strong>
                            <t t-esc="partner_id[1]" />
                        </div>
                        <div>
                            <strong>
                                <span
                                    class="text-success"
                                    t-if="state =='sale'"
                                >Sale</span>
                            </strong>
                        </div>
                        <div>
                            <strong>
                                <span t-if="invoice_status=='invoiced'">Invoiced</span>
                                <span
                                    t-if="invoice_status=='no'"
                                >Nothing to invoice</span>
                                <span
                                    t-if="invoice_status=='to invoice'"
                                >To invoice</span>
                            </strong>
                        </div>
                    </div>
                </templates>
            </gantt>
        </field>
    </record>

    <record id="view_sale_order_calendar" model="ir.ui.view">
        <field name="inherit_id" ref="sale.view_sale_order_calendar" />
        <field name="name">sale.order.calendar</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//calendar[1]" position="attributes">
                <attribute name="date_start">commitment_date</attribute>
                <attribute name="js_class">sale_calendar_view</attribute>
                <attribute name="create">0</attribute>
                <attribute name="mode">week</attribute>
                <attribute name="color">delivery_status</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="replace">
                <field name="client_order_ref" />
                <field name="delivery_status" filters="1" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='state']" position="replace" />
        </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <xpath
                    expr="//group[@name='sale_shipping']//label[1]"
                    position="move"
                />
                <xpath
                    expr="//group[@name='sale_shipping']//div[hasclass('o_row')]"
                    position="move"
                />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <xpath expr="//field[@name='client_order_ref']" position="move" />
            </xpath>
            <xpath expr="//field[@name='product_template_id']" position="attributes">
                <attribute
                    name="options"
                >{"no_open":true,"no_quick_create":true,"no_create_edit":true}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="sum">Sum of Quantity</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//field[@name='qty_delivered']"
                position="attributes"
            >
                <attribute name="sum">Sum of Delivered</attribute>
            </xpath>
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="port_of_entry" />
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_zip" optional="true" />
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field
                    name="delivery_status"
                    optional="hide"
                    widget="badge"
                    decoration-success="delivery_status == 'full'"
                    decoration-info="delivery_status == 'pending'"
                    decoration-warning="delivery_status in ['started', 'partial']"
                />
            </xpath>
            <xpath expr="/list//field[@name='name']" position="after">
                <xpath expr="/list//field[@name='client_order_ref']" position="move" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_shipping_id" optional="show" />
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="after">
                <field name="delivery_count" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field
            name="view_mode"
        >list,kanban,form,calendar,pivot,graph,activity,gantt</field>
    </record>

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field
            name="view_mode"
        >gantt,list,kanban,form,calendar,pivot,graph,activity</field>
    </record>
</odoo>
