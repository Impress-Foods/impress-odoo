#. module: quality_label_printing
#. odoo-python
#: code:addons/quality_label_printing/models/quality_point.py:0
msgid "Printer %(printer)s cannot print the labels report %(report)s produces."
msgstr ""
"L'imprimante %(printer)s ne peut pas imprimer l'étiquette produite par le "
"rapport %(report)s."

#. module: quality_label_printing
#: model:ir.model.fields,help:quality_label_printing.field_quality_point__label_printer_id
msgid ""
"Printer this workstation prints the label on. Left empty, the printer the "
"report is already configured for is used. The operator can still print "
"elsewhere when printing."
msgstr ""
"L'imprimante que cette station utilise pour imprimer les étiquettes. Si "
"laissé vide, l'imprimante configurée sur le rapport est utilisée. "
"L'opérateur peut toutefois imprimer sur une autre imprimante au moment de "
"l'impression."

#. module: quality_label_printing
#: model:ir.model.fields,help:quality_label_printing.field_quality_check_printer_picker__printer_id
msgid ""
"Printer to print on. Starts on the one this step uses, and offers any other "
"that can print this label."
msgstr ""
"Imprimante à utiliser pour l'impression. Par défaut, utilise l'imprimante "
"configurée sur l'opération et offre toute autre imprimante compatible."

