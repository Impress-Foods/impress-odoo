<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View stock.package.type form -->
    <record id="view_stock_package_type_form" model="ir.ui.view">
        <field name="name">view.stock.package.type.form</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="packaging_material_id" />
                <field
                    name="source_location_id"
                    domain="[('usage', '=', 'internal')]"
                />
            </xpath>
        </field>
    </record>

</odoo>
