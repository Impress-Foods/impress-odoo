<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View stock.package.type form -->
    <record id="view_stock_package_type_form" model="ir.ui.view">
        <field name="name">view.stock.package.type.form</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">

            <xpath expr="//group[@name='delivery']" position="after">
                 <group name="packaging">
                    <field name="packaging_material_ids">
                        <tree editable="bottom">
                            <field name="product_id" />
                            <field name="quantity" />
                            <field name="location_id" />
                        </tree>
                    </field>
                 </group>
            </xpath>
        </field>
    </record>

</odoo>
