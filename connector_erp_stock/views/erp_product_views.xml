<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="erp_product_view_search" model="ir.ui.view">
        <field name="name">erp.product.view.search</field>
        <field name="model">erp.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
            </search>
        </field>
    </record>
    <record id="erp_product_view_tree" model="ir.ui.view">
        <field name="name">erp.product.view.list</field>
        <field name="model">erp.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="external_name" />
                <field name="product_id" />
            </list>
        </field>
    </record>
</odoo>
