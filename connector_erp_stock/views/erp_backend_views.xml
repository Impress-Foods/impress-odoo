<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="erp_backend_inherit" model="ir.ui.view">
        <field name="name">erp.backend.view.form.inherit</field>
        <field name="model">erp.backend</field>
        <field name="inherit_id" ref="connector_erp.erp_backend_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_products"
                    type="object"
                    icon="fa-cubes"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Products</span>
                        <span class="o_stat_value d-flex gap-1">
                            <field
                                name="erp_product_count"
                                widget="statinfo"
                                nolabel="1"
                                class="oe_inline"
                            />
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    type="object"
                    name="action_sync_products"
                    string="Sync Products"
                />
            </xpath>

            <xpath expr="//notebook[1]" position="inside">
                <page name="stock" string="Stock">
                    <group />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
