<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: backends are company-owned and filtered accordingly. -->
    <record id="biostar_backend_rule_company" model="ir.rule">
        <field name="name">BioStar Backend: multi-company</field>
        <field name="model_id" ref="model_biostar_backend"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
