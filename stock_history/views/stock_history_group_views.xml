<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View stock.history.group View Tree -->
    <record id="view_stock_history_group_tree" model="ir.ui.view">
        <field name="name">view.stock.history.group.tree</field>
        <field name="model">stock.history.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <!-- View stock.history.group form -->
    <record id="view_stock_history_group_form" model="ir.ui.view">
        <field name="name">view.stock.history.group.form</field>
        <field name="model">stock.history.group</field>
        <field name="arch" type="xml">
            <form string="Stock History Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Name..." />
                        </h1>
                    </div>
                    <group>
                        <field name="history_config_id" readonly="1" />
                        <field name="date" readonly="1" />
                        <field name="history_line_ids" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View stock.history.group search -->
    <record id="view_stock_history_group_search" model="ir.ui.view">
        <field name="name">view.stock.history.group.search</field>
        <field name="model">stock.history.group</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action stock.history.group -->
    <record id="action_stock_history_group" model="ir.actions.act_window">
        <field name="name">Stock History Group</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.history.group</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Stock History Group.
            </p>
        </field>
    </record>

    <menuitem
        id="stock_history_group_menu"
        name="Stock History"
        action="action_stock_history_group"
        parent="stock.menu_warehouse_report"
    />

</odoo>
