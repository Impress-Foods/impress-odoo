<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View stock_history_line View Tree -->
    <record id="view_stock_history_line_tree" model="ir.ui.view">
        <field name="name">view.stock_history_line.tree</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="uom" />
                <field name="location" />
            </tree>
        </field>
    </record>


    <record id="stock_history_line_view_pivot" model="ir.ui.view">
        <field name="name">stock_history_line.view.pivot</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <pivot string="" disable_linking="true" display_quantity="false">
                <field name="date" type="col" interval="week" />
                <field name="product_id" type="row" />
                <field name="location" type="row" />
                <field name="quantity" type="measure" />
            </pivot>
        </field>
    </record>
    <!-- View stock_history_line form -->
    <record id="view_stock_history_line_form" model="ir.ui.view">
        <field name="name">view.stock_history_line.form</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <form string="Stock_history_line">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence" />
                            <field name="date" />
                            <field name="product_id" />
                            <field name="location" />
                            <field name="quantity" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View stock_history_line search -->
    <record id="view_stock_history_line_search" model="ir.ui.view">
        <field name="name">view.stock_history_line.search</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="Sequence"
                        name="sequence"
                        domain="[]"
                        context="{'group_by':'sequence'}"
                    />
                    <filter
                        string="Product"
                        name="product"
                        domain="[]"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="Location"
                        name="location"
                        domain="[]"
                        context="{'group_by':'location'}"
                    />
                    <filter
                        string="Date"
                        name="filter_date"
                        date="date"
                        default_period="last_month"
                        context="{'group_by':'date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action stock_history_line -->
    <record id="action_stock_history_line" model="ir.actions.act_window">
        <field name="name">Stock_history_line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.history.line</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Stock_history_line.
            </p>
        </field>
    </record>

    <menuitem
        id="stock_history_lines_menu"
        name="Stock History Lines"
        action="action_stock_history_line"
        parent="stock.menu_warehouse_report"
    />
</odoo>
