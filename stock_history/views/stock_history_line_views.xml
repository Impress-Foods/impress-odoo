<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View stock_history_line View Tree -->
    <record id="view_stock_history_line_tree" model="ir.ui.view">
        <field name="name">view.stock_history_line.tree</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="uom" />
                <field name="location" />
            </tree>
        </field>
    </record>

    <!-- View stock_history_line form -->
    <record id="view_stock_history_line_form" model="ir.ui.view">
        <field name="name">view.stock_history_line.form</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <form string="Stock_history_line">
                <sheet>
                    <div class="oe_title">
                        <label for="sequence" />
                        <h1>
                            <field name="sequence" placeholder="Sequence..." />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View stock_history_line search -->
    <record id="view_stock_history_line_search" model="ir.ui.view">
        <field name="name">view.stock_history_line.search</field>
        <field name="model">stock.history.line</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="Sequence"
                        name="sequence"
                        domain="[]"
                        context="{'group_by':'sequence'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action stock_history_line -->
    <record id="action_stock_history_line" model="ir.actions.act_window">
        <field name="name">Stock_history_line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.history.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Stock_history_line.
            </p>
        </field>
    </record>


</odoo>
