<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View clickship.payment_method View Tree -->
    <record id="view_clickship_payment_method_tree" model="ir.ui.view">
        <field name="name">view.clickship.payment_method.tree</field>
        <field name="model">clickship.payment_method</field>
        <field name="arch" type="xml">
            <list />
        </field>
    </record>

    <!-- View clickship.payment_method form -->
    <record id="view_clickship_payment_method_form" model="ir.ui.view">
        <field name="name">view.clickship.payment_method.form</field>
        <field name="model">clickship.payment_method</field>
        <field name="arch" type="xml">
            <form string="Clickship Payment_method">
                <sheet />
            </form>
        </field>
    </record>

    <!-- View clickship.payment_method search -->
    <record id="view_clickship_payment_method_search" model="ir.ui.view">
        <field name="name">view.clickship.payment_method.search</field>
        <field name="model">clickship.payment_method</field>
        <field name="arch" type="xml">
            <search>
                <group>
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action clickship.payment_method -->
    <record id="action_clickship_payment_method" model="ir.actions.act_window">
        <field name="name">Clickship Payment_method</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">clickship.payment_method</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p
                class="oe_view_nocontent_create"
            > There is no examples click here to add new Clickship Payment_method. </p>
        </field>
    </record>
</odoo>
