<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t
        t-name="clickship.MainComponent"
        t-inherit="stock_barcode.MainComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//button[hasclass('o_validate_page')]" position="before">

            <t t-if="env.model.resModel === 'stock.picking'">
                <button
                    t-if="env.model.clickshipRateNeeded()"
                    t-on-click="openClickshipRateWizard"
                    class="btn btn-secondary"
                >
                    <i class="fa fa-truck me-1" /> Get Rates
                </button>
            </t>
        </xpath>
    </t>
</templates>
