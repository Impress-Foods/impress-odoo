<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View wizard.clickship_rates form -->
    <record id="view_wizard_clickship_rates_form" model="ir.ui.view">
        <field name="name">view.wizard.clickship_rates.form</field>
        <field name="model">wizard.clickship_rates</field>
        <field name="arch" type="xml">
            <form string="Wizard Clickship_rates">
                <field name="rate_ids">
                    <list
                        default_order="carrier_name desc"
                        delete="0"
                        create="0"
                        edit="0"
                    >
                        <field name="carrier_name" />
                        <field name="service_name" />
                        <field name="currency_id" column_invisible="True" />
                        <field name="transit_time" />
                        <field
                            name="total"
                            widget="monetary"
                            options="{'currency_field':'currency_id'}"
                        />
                        <button
                            type="object"
                            name="button_choose"
                            icon="fa-check"
                            title="Select"
                        />
                    </list>
                </field>
                <footer>
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action wizard.clickship_rates -->
    <record id="action_wizard_clickship_rates" model="ir.actions.act_window">
        <field name="name">Wizard Clickship_rates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.clickship_rates</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
