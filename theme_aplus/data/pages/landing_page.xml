                                            class="img img-fluid mx-auto o_we_custom_image"
                                            data-mimetype="image/svg+xml"
                                            data-original-id="855"
                                            data-original-src="/web/image/855-836a7a97/FrontPage-1.webp"
                                            data-mimetype-before-conversion="image/webp"
                                            data-resize-width="690"
