<?xml version="1.0" encoding="UTF-8" ?>
<?xml-model href="../../../import_xml.rng" type="application/xml"?>
<odoo>
    <!-- grid-area row_start / column_start / row_end / column_end -->
    <record id="landing_page_view" model="ir.ui.view">
        <field name="name">landing.page.view</field>
        <field name="key">landing.page</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t name="Landing Page" t-name="landing.page">
                <t t-call="website.layout">
                    <t t-set="pageName" t-value="'homepage'" />
                    <div id="wrap" class="oe_structure oe_empty">
                        <section
                            data-snippet="s_window_carousel"
                            class="s_window_carousel pb0 pt0 o_colored_level o_dynamic_empty"
                            data-name="Window Carousel"
                            data-number-of-records="16"
                            data-template-key="theme_aplus.dynamic_filter_template_product_template_wavy_card"
                            data-carousel-interval="5000"
                            style="background-image: none; position: relative;"
                            data-product-category-id="all"
                            data-filter-id="8"
                            data-oe-shape-data="{&quot;shape&quot;:&quot;illustration/aplus/02&quot;,&quot;colors&quot;:{&quot;c2&quot;:&quot;rgba(255, 51, 51, 0)&quot;,&quot;c3&quot;:&quot;#FF3333&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;animated&quot;:&quot;true&quot;}"
                        >
                            <div
                                class="o_we_shape o_illustration_aplus_02 o_we_animated"
                                style="background-image: url(&quot;/web_editor/shape/illustration%2Faplus%2F02.svg?c2=rgba(255%2C%2051%2C%2051%2C%200)&amp;c3=%23FF3333&amp;flip=y&quot;); background-position: 50% 100%;"
                            />
                            <img
                                class="hero-background active"
                                loading="lazy"
                                src="/web/image/product.template/11/hero_background"
                                data-mimetype="image/png"
                                data-original-id="12"
                                data-original-src="/web/static/img/placeholder.png"
                                data-mimetype-before-conversion="image/png"
                                style=""
                            />
                            <img
                                class="hero-background inactive"
                                loading="lazy"
                                src="/web/image/product.template/2/hero_background"
                                data-mimetype="image/png"
                                data-original-id="12"
                                data-original-src="/web/static/img/placeholder.png"
                                data-mimetype-before-conversion="image/png"
                                style=""
                            />
                            <div class="row o_grid_mode" data-row-count="15">


                                <div
                                    class="o_grid_item g-height-* g-col-lg-* o_colored_level g-height-4 col-lg-*"
                                    style="grid-area: 5 / 5 / 9 / 10;"
                                >
                                    <h1
                                        class="hero-text"
                                        style="color: rgb(27, 2, 168);"
                                    >DRINK</h1>
                                </div>
                                <div
                                    class="o_grid_item g-height-* g-col-lg-* o_colored_level g-height-4 col-lg-*"
                                    style="grid-area: 8 / 6 / 12 / 11;"
                                >
                                    <h1
                                        class="hero-text"
                                        style="color: rgb(27, 2, 168);"
                                    >YOUR</h1>
                                </div>
                                <div
                                    class="o_grid_item g-height-* g-col-lg-* o_colored_level g-height-4 col-lg-*"
                                    style="grid-area: 11 / 7 / 15 / 12;"
                                >
                                    <h1
                                        class="hero-text"
                                        style="color: rgb(27, 2, 168);"
                                    >FRUIT</h1>
                                </div>
                                <div
                                    class="o_grid_item g-height-* g-col-lg-* o_colored_level g-col-lg-3 col-lg-*"
                                    style="grid-area: 5 / 2 / 16 / 5;"
                                >
                                    <div class="carousel_container">
                                        <div
                                            class="carousel slide aplus_carousel"
                                            data-bs-ride="ride"
                                        >
                                            <div class="dynamic_snippet_template" />
                                            <a href="/shop" class="shop-now">
                                                <button
                                                    class="btn btn-primary shop-now-button o_default_snippet_text"
                                                    style="background-color: rgb(27, 2, 168); color: rgb(255, 255, 255);"
                                                >Shop
                                                    Now</button>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section
                            class="s_scrolling_text_banner o_full_width o_colored_level pb0 pt0 o_cc o_cc4"
                            data-speed="50"
                            data-speed-multiplier="1.0"
                            data-snippet="s_scrolling_text_banner"
                            data-name="Infinite Ticker Block"
                        >
                            <div class="ticker-container" />
                            <div class="ticker-text-editor o_snippet_editor_only">
                                <span class="ticker-source-text">WELCOME 10</span>
                                <br />
                            </div>
                        </section>
                        <section
                            class="s_text_image pt32 pb32 o_colored_level o_cc o_cc4"
