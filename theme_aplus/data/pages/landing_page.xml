                                            data-file-name="FrontPage-1.svg"
                                            data-shape-colors=";;;;"
                                            data-original-mimetype="image/webp"
                                            loading="lazy"
                                        />
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section
                            data-snippet="s_dynamic_snippet_product_templates"
                            class="s_dynamic_snippet_product_templates s_dynamic pt32 pb32 o_colored_level s_product_template_wavy_card o_dynamic_empty"
                            data-name="Product Templates"
                            style="background-image: none;"
                            data-product-category-id="all"
                            data-number-of-records="16"
                            data-filter-id="7"
                            data-template-key="theme_aplus.dynamic_filter_template_product_template_wavy_card"
