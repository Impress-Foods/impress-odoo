                            data-name="Text - Image"
                            style="position: relative; background-image: none;"
                            data-oe-shape-data="{&quot;shape&quot;:&quot;illustration/aplus/01&quot;,&quot;colors&quot;:{&quot;c2&quot;:&quot;rgba(255, 51, 51, 0)&quot;,&quot;c3&quot;:&quot;#F7EAE4&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;animated&quot;:&quot;true&quot;}"
