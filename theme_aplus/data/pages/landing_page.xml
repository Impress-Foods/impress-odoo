                            />
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-6 pt16 pb16 o_colored_level">
                                        <h5>
                                            <span
                                                class="h4-fs"
                                            >We use the whole fruit because we believe in keeping
                                                things real: our drinks are naturally packed with fiber and
                                                antioxidants.&amp;nbsp;</span>
                                        </h5>
                                        <h5>
                                            <span
                                                class="h4-fs"
                                            >And by cold-pressing our juices, we make sure the good
                                                stuff —like vitamins and nutrients— stay right where it
                                                belongs.&amp;nbsp;</span>
                                        </h5>
                                        <h5>
                                            <span
                                                class="h4-fs"
                                            >It’s wholesome, simple, and made for people who want to
                                                feel good about what they’re drinking.</span>

                                        </h5>
                                        <p><a
                                                href="/shop"
                                                class="btn btn-fill-custom bg-o-color-4 rounded-circle btn-lg"
                                                data-bs-original-title=""
                                                title=""
                                                style="border-width: 1px; border-style: solid; color: rgb(255, 0, 0);"
                                            >
                                            Shop <font
                                                    class="bg-o-color-4 text-o-color-2"
                                                >​</font>​​now</a>​​​​</p>
                                    </div>
                                    <div class="col-lg-6 pt16 pb16 o_colored_level">
                                        <img
                                            src="/web/image/857-aa1dff89/FrontPage-1.svg"
