<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <!-- options -->
    <template
        id="snippet_options_ecom"
        inherit_id="website.snippet_options"
        name="e-commerce snippet options"
        priority="99"
    >
        <xpath
            expr="//we-row[@id='o_wsale_grid_left_panel']"
            position="before"
            data-variable="group_by"
        >
            <we-row
                id="group_by_categories"
                string="Group by"
                data-variable="group_by_categories"
            >
                <we-button
                    string="Group by Category"
                    data-customize-website-views="theme_aplus.group_by_categories"
                    data-name="group_by_categories_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>

        </xpath>
        <xpath
            expr="//we-button[@data-select-class='o_wsale_design_grid']"
            position="after"
        >
            <we-button
                data-customize-website-views="theme_aplus.products_design_wavy_cards"
            > Wavy Cards </we-button>
        </xpath>
        <xpath
            expr="//we-select[hasclass('o_wsale_ppr_submenu')]/we-button[3]"
            position="after"
        >
            <we-button data-set-ppr="5">5</we-button>
        </xpath>
        <xpath
            expr="//we-checkbox[@data-customize-website-views='website_sale.product_tags']"
            position="after"
        >
            <we-row
                id="show_ingredients"
                string="Show Ingredients"
                data-variable="show-ingredients"
            >
                <we-button
                    string="Show Ingredients"
                    data-customize-website-views="theme_aplus.product_show_ingredients"
                    data-name="show_ingredient_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
            <we-row
                id="show_learn_more"
                string="Show Learn More Tabs"
                data-variable="show_tabbed"
            >
                <we-button
                    string="Show Learn More Tabs"
                    data-customize-website-views="theme_aplus.product_tabbed_information"
                    data-name="show_tabbed_opt"
                    data-no-preview="true"
                    data-reload="/"
                />

            </we-row>
            <we-row
                id="show_nutrition_table"
                string="Show Nutrition Table"
                data-variable="show_nutrition_table"
            >
                <we-button
                    string="Show Nutrition Table"
                    data-dependencies="show_tabbed_opt"
                    data-customize-website-views="theme_aplus.product_nutrition_table"
                    data-name="show_nutrition_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
            <we-row
                id="show_vectors"
                string="Show Fruit/Water/Maple"
                data-variable="show_vectors"
            >
                <we-button
                    string="Show Fruit/Water/Maple"
                    data-customize-website-views="theme_aplus.product_show_vectors"
                    data-name="show_vector_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
            <we-row id="show_adq" string="Show Alim du QC" data-variable="show_adq">
                <we-button
                    string="Show Alim du QC"
                    data-customize-website-views="theme_aplus.product_show_adq"
                    data-name="show_adq_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
            <we-row
                id="show_related"
                string="Show Related Flavors"
                data-variable="show_related"
            >
                <we-button
                    string="Show Related Flavors"
                    data-customize-website-views="theme_aplus.product_related_flavors"
                    data-name="show_related_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
            <we-row
                id="highlights"
                string="Color highlights"
                data-variable="highlights"
            >
                <we-button
                    string="Color highlights"
                    data-customize-website-views="theme_aplus.product_color_highlight"
                    data-name="highlights_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
        </xpath>
    </template>

    <!-- All products page + category page-->
    <template id="group_by_categories" name="Group By Categories" active="False" />

    <template
        id="products"
        name="Products"
        inherit_id="website_sale.products"
        priority="99"
    >

        <xpath expr="//div[@id='wrap']" position="before">
            <t
                id="group_by_category_switch"
                t-set="groupByCategory"
                t-value="is_view_active('theme_aplus.group_by_categories')"
            />
        </xpath>

        <xpath expr="//table" position="replace">
            <table
                class="table table-borderless h-100 m-0"
                t-att-data-ppg="ppg"
                t-att-data-ppr="ppr"
                t-att-data-default-sort="website.shop_default_sort"
                t-att-data-name="grid_block_name"
            >
                <colgroup t-ignore="true">
                    <!-- Force the number of columns (useful when only one row of (x < ppr) products) -->
                    <col t-foreach="ppr" t-as="p" />
                </colgroup>
                <t
                    t-set="flat_list"
                    t-value="[item for sublist in bins for item in sublist]"
                />
                <t
                    t-set="categories"
                    t-value="list(set([i['product'].public_categ_ids for i in flat_list]))"
                />

                <tbody t-if="not groupByCategory">
                    <tr t-foreach="bins" t-as="tr_product">
                        <t t-foreach="tr_product" t-as="td_product">
                            <t t-if="td_product">
                                <td
                                    t-att-colspan="td_product['x'] != 1 and td_product['x']"
                                    t-att-rowspan="td_product['y'] != 1 and td_product['y']"
                                    t-attf-class="oe_product"
                                    t-att-data-ribbon-id="td_product['ribbon'].id"
                                    t-att-data-name="product_block_name"
                                >
                                    <div
                                        t-attf-class="o_wsale_product_grid_wrapper position-relative h-100
                                o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}"
                                    >
                                        <t t-call="website_sale.products_item">
                                            <t
                                                t-set="product"
                                                t-value="td_product['product']"
                                            />
                                        </t>
                                    </div>
                                </td>
                            </t>
                            <td t-else="" />

                        </t>
                    </tr>
                </tbody>
                <tbody t-else="groupByCategory">
                    <t
                        t-set="categories_sorted"
                        t-value="sorted(categories, key=lambda x: x.sequence)"
                    />
                    <t t-foreach="categories_sorted" t-as="category">
                        <t
                            t-set="filtered_list"
                            t-value="[i for i in flat_list if (category in i['product'].public_categ_ids)]"
                        />
                        <tr t-if="len(categories) > 1 and len(filtered_list) != 0">
                            <td t-att-colspan="ppr" class="category-header">
                                <div class="o_ws_category_separator">
                                    <t t-out="category.name" />
                                </div>
                            </td>
                        </tr>

                        <t t-set="filtered_list_len" t-value="len(filtered_list)" />
                        <t t-set="rebinned_bins" t-value="[]" />

                        <t t-foreach="range(0, filtered_list_len, ppr)" t-as="i">
                            <t t-set="current_bin" t-value="filtered_list[i:i + ppr]" />

                            <t
                                t-set="rebinned_bins"
                                t-value="rebinned_bins + [current_bin]"
                            />
                        </t>

                        <tr
                            t-foreach="rebinned_bins"
                            t-as="tr_product"
                            class="product_row"
                        >

                            <t t-foreach="tr_product" t-as="td_product">
                                <t
                                    t-set="product_categories"
                                    t-value="td_product['product'].public_categ_ids"
                                />
                                <t t-if="td_product">
                                    <td
                                        t-att-colspan="td_product['x'] != 1 and td_product['x']"
                                        t-att-rowspan="td_product['y'] != 1 and td_product['y']"
                                        t-attf-class="oe_product"
                                        t-att-data-ribbon-id="td_product['ribbon'].id"
                                        t-att-data-name="product_block_name"
                                    >

                                        <div
                                            t-attf-class="o_wsale_product_grid_wrapper position-relative h-100
                                o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}"
                                        >
                                            <t
                                                t-if="is_view_active('theme_aplus.products_design_wavy_cards')"
                                                t-call="theme_aplus.products_item"
                                            >
                                                <t
                                                    t-set="product"
                                                    t-value="td_product['product']"
                                                />
                                            </t>
                                        </div>
                                    </td>
                                </t>
                                <t t-else="" />

                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>


        <xpath expr="//tbody/tr/t/t/td/div/t" position="attributes">
            <attribute
                name="t-if"
            >not is_view_active('theme_aplus.products_design_wavy_cards')</attribute>
        </xpath>
        <xpath expr="//tbody/tr/t/t/td/div/t" position="after">
            <t
                t-if="is_view_active('theme_aplus.products_design_wavy_cards')"
                t-call="theme_aplus.products_item"
            >
                <t t-set="product" t-value="td_product['product']" />
            </t>
        </xpath>
    </template>

    <template
        id="products_design_wavy_cards"
        active="False"
        name="Wavy Cards Product Design"
    />

    <!-- Product Page -->
    <template
        id="product_color_highlight"
        active="False"
        inherit_id="website_sale.product"
    >
        <!-- Set color for elements using t-attf-style -->
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute
                name="t-attf-style"
            >--highlight-color: {{product.product_page_text_color}};</attribute>
        </xpath>
    </template>

    <template id="product" inherit_id="website_sale.product">

        <xpath expr="//div[@id='product_detail_main']/div[1]" position="after">
            <div
                id="left-column"
                class="d-flex col-lg-6 mt-lg-4 flex-column align-items-center"
            />
        </xpath>
        <xpath expr="//div[@id='left-column']" position="inside">
            <xpath expr="//div[@id='product_detail_main']/div[1]" position="move" />
        </xpath>
        <xpath expr="//div[@id='left-column']" position="inside">
            <div id="learn-more-block-desktop" class="d-none d-lg-block w-100" />
        </xpath>
        <xpath expr="//div[@id='product_details']" position="inside">
            <div id="flavors-block" />
            <div class="d-flex flex-row align-items-center extra-icons">
                <div id="vectors-block" />
                <div id="adq-block" />
            </div>
            <div id="ingredients-block" />
            <div id="learn-more-block-mobile" class="d-block d-lg-none" />

        </xpath>

    </template>

    <template
        id="carousel_product_indicators"
        inherit_id="website_sale.carousel_product_indicators"
    >
        <xpath expr="//ol" position="attributes">
            <attribute name="style">justify-content: center;</attribute>
        </xpath>
    </template>

    <template
        id="product_show_ingredients"
        active="False"
        inherit_id="website_sale.product"
    >
        <xpath expr="//div[@id='ingredients-block']" position="inside">
            <t t-if="product.ingredients">
                <div class="ingredients-block d-flex flex-column">
                    <span class="subsection-header">Ingredients</span>
                    <span
                        class="text-muted ingredient-list"
                        t-field="product.ingredients"
                    />
                </div>
            </t>
        </xpath>

    </template>

    <template id="product_show_adq" active="False" inherit_id="website_sale.product">
        <xpath expr="//div[@id='adq-block']" position="inside">
            <div t-if="product.show_adq" class="icon-block">
                <img
                    src="/theme_aplus/static/src/images/AlimentsDuQuebec_Logo_Renv.svg"
                    width="100px"
                    height="100px"
                />
            </div>
        </xpath>
    </template>

    <template
        id="product_show_vectors"
        active="False"
        inherit_id="website_sale.product"
    >
        <xpath expr="//div[@id='vectors-block']" position="inside">

            <t
                t-if="is_view_active('theme_aplus.product_highlight_color')"
                t-set="style"
                t-value="'--highlight-color:' + product.product_page_text_color +';'"
            />
            <div id="vector_images" class="icon-block" t-att-style="style">
                <t
                    t-set="show_plus_1"
                    t-value="(product.show_fruits and product.show_water) or (product.show_fruits and product.show_maple)"
                />
                <t
                    t-set="show_plus_2"
                    t-value="(product.show_water and product.show_maple)"
                />

                <div t-if="product.show_fruits" class="vector-column">
                    <t t-call="theme_aplus.fruit_vector" />
                    <span>Fruits</span>
                </div>
                <t t-if="show_plus_1" t-call="theme_aplus.plus_vector" />
                <div t-if="product.show_water" class="vector-column">
                    <t t-call="theme_aplus.water_vector_alt" />
                    <span>Water</span>
                </div>
                <t t-if="show_plus_2" t-call="theme_aplus.plus_vector" />
                <div t-if="product.show_maple" class="vector-column">
                    <t t-call="theme_aplus.maple_vector" />
                    <span>Maple</span>
                </div>
            </div>
        </xpath>
    </template>

    <template
        id="product_related_flavors"
        active="False"
        inherit_id="website_sale.product"
    >
        <xpath expr="//div[@id='flavors-block']" position="inside">
            <div
                class="related-flavors-block"
                t-if="len(product_variant.public_categ_ids.product_tmpl_ids) > 1"
            >
                <div>
                    <span class="subsection-header">Flavors</span>
                </div>
                <div class="related-flavors">
                    <t
                        t-foreach="product_variant.public_categ_ids.product_tmpl_ids"
                        t-as="rel_product"
                    >
                        <div
                            class="d-flex flex-column align-items-center related-flavor"
                            t-if="rel_product.name != product.name"
                        >
                            <a
                                class="related-product"
                                t-attf-href="{{rel_product.website_url}}"
                            >
                                <image
                                    class="related-flavor-image"
                                    t-attf-src="/web/image/product.template/{{rel_product.id}}/image_512"
                                />
                            </a>
                            <span
                                class="related-flavor-name"
                                t-out="rel_product.name"
                            />
                        </div>

                    </t>
                </div>
            </div>
        </xpath>

    </template>

    <template
        id="product_tabbed_information"
        active="False"
        inherit_id="website_sale.product"
    >
        <xpath expr="//div[@id='learn-more-block-desktop']" position="inside">
            <t t-call="theme_aplus.tabbed_container">
                <t t-set="prefix" t-value="'desktop'" />
            </t>
        </xpath>
        <xpath expr="//div[@id='learn-more-block-mobile']" position="inside">
            <t t-call="theme_aplus.tabbed_container">
                <t t-set="prefix" t-value="'mobile'" />
            </t>
        </xpath>
    </template>

    <template id="tabbed_container">
        <t
            t-set="show_tvn"
            t-value="is_view_active('theme_aplus.product_nutrition_table')"
        />
        <div class="container custom-tab-container">
            <div class="row">
                <ul
                    class="nav nav-tabs nav-fill justify-content-center px-2"
                    id="{{prefix}}-Tab"
                    role="tablist"
                >

                    <li
                        t-if="product.tab_1_title"
                        class="nav-item custom-tab-item"
                        role="presentation"
                    >
                        <button
                            class="nav-link active"
                            t-attf-id="{{prefix}}-1-tab"
                            data-bs-toggle="tab"
                            t-att-data-bs-target="'#'+prefix+'-1'"
                            type="button"
                            role="y"
                            t-attf-aria-controls="{{prefix}}-1"
                            aria-selected="false"
                            t-out="product.tab_1_title"
                        />
                    </li>
                    <li
                        t-if="product.tab_2_title"
                        class="nav-item custom-tab-item"
                        role="presentation"
                    >
                        <button
                            class="nav-link"
                            t-attf-id="{{prefix}}-2-tab"
                            data-bs-toggle="tab"
                            t-att-data-bs-target="'#'+prefix+'-2'"
                            type="button"
                            role="tab"
                            t-attf-aria-controls="{{prefix}}-2"
                            aria-selected="false"
                            t-out="product.tab_2_title"
                        />
                    </li>
                    <li
                        t-if="show_tvn and product.has_tvn"
                        class="nav-item custom-tab-item"
                        role="presentation"
                    >
                        <button
                            class="nav-link"
                            t-attf-id="{{prefix}}-tvn-tab"
                            data-bs-toggle="tab"
                            t-att-data-bs-target="'#'+prefix+'-tvn'"
                            type="button"
                            role="tab"
                            t-attf-aria-controls="{{prefix}}-tvn"
                            aria-selected="false"
                        >Nutritional Facts</button>
                    </li>
                </ul>

                <div
                    class="tab-content p-4 shadow-sm bg-light"
                    t-attf-id="{{prefix}}-TabContent"
                >
                    <div
                        t-if="product.tab_1_title"
                        class="tab-pane fade show active"
                        t-attf-id="{{prefix}}-1"
                        role="tabpanel"
                        t-attf-aria-labelledby="{{prefix}}-1-tab"
                    >
                        <t t-out="product.tab_1_text" />
                    </div>
                    <div
                        t-if="product.tab_2_title"
                        class="tab-pane fade"
                        t-attf-id="{{prefix}}-2"
                        role="tabpanel"
                        t-attf-aria-labelledby="{{prefix}}-2-tab"
                    >
                        <t t-out="product.tab_2_text" />
                    </div>
                    <div
                        t-if="show_tvn and product.has_tvn"
                        class="tab-pane fade tvn-holder"
                        t-attf-id="{{prefix}}-tvn"
                        role="tabpanel"
                        t-attf-aria-labelledby="{{prefix}}-tvn-tab"
                    >
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template
        id="product_nutrition_table"
        active="False"
        inherit_id="theme_aplus.product_tabbed_information"
        priority="99"
    > </template>

    <template id="tvn">
        <div class="d-flex flex-column align-items-center">
            <div class="nutrition-table justify-center w-100" id="nutrition_table">
                <table class="table caption-top">
                    <caption t-if="product_variant.nutrition_facts_size">
                    <span>Nutritional Values ( for </span>
                    <span t-out="product_variant.nutrition_facts_size" />
                    <span>)</span>
                    </caption>
                    <thead>
                        <tr>
                            <th class="text-center">Content</th>
                            <th class="text-center">% Daily Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t
                            t-foreach="product_variant.nutrition_entry_ids.sorted('sequence')"
                            t-as="entry"
                        >
                            <tr
                                t-attf-style="background:{{product.product_page_text_color if entry_parity =='even' else ''}};"
                            >
                                <td
                                    class="text-center"
                                    t-attf-style="color:{{product.text_color if entry_parity =='even' else ''}};"
                                >
                                    <t t-out="entry.name" />
                                </td>
                                <td
                                    class="text-center"
                                    t-attf-style="color:{{product.text_color if entry_parity =='even' else ''}};"
                                >
                                    <t t-out="entry.value" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </template>

    <template
        id="bottle_quantity_selector"
        inherit_id="website_sale.product_quantity"
        active="False"
    >
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <div
                t-attf-class="css_quantity input-group {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} me-2 mb-2 align-middle"
                contenteditable="false"
            >

                <a
                    t-attf-href="#"
                    class="btn btn-link js_add_cart_json"
                    aria-label="Remove one"
                    title="Remove one"
                >
                    <i class="fa fa-minus" />
                </a>
                <input
                    type="text"
                    class="form-control quantity text-center"
                    data-min="1"
                    name="add_qty"
                    t-att-value="add_qty or 1"
                />

                <a
                    t-attf-href="#"
                    class="btn btn-link float_left js_add_cart_json"
                    aria-label="Add one"
                    title="Add one"
                >
                    <i class="fa fa-plus" />
                </a>
            </div>

        </xpath>
    </template>

</odoo>
