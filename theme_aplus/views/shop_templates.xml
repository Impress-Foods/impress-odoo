<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="products"
        name="Products"
        inherit_id="website_sale.products"
        priority="99"
    >

        <xpath expr="//div[@id='wrap']" position="before">
            <t
                id="group_by_category_switch"
                t-set="groupByCategory"
                t-value="is_view_active('theme_aplus.group_by_categories')"
            />
        </xpath>

        <xpath expr="//table" position="replace">
            <table
                class="table table-borderless h-100 m-0"
                t-att-data-ppg="ppg"
                t-att-data-ppr="ppr"
                t-att-data-default-sort="website.shop_default_sort"
                t-att-data-name="grid_block_name"
            >
                <colgroup t-ignore="true">
                    <!-- Force the number of columns (useful when only one row of (x < ppr) products) -->
                    <col t-foreach="ppr" t-as="p" />
                </colgroup>

                <t
                    t-set="categories"
                    t-value="list(set([i['product'].public_categ_ids for i in bins[0]]))"
                />
                <tbody t-if="not groupByCategory">
                    <tr t-foreach="bins" t-as="tr_product">
                        <t t-foreach="tr_product" t-as="td_product">
                            <t t-if="td_product">
                                <td
                                    t-att-colspan="td_product['x'] != 1 and td_product['x']"
                                    t-att-rowspan="td_product['y'] != 1 and td_product['y']"
                                    t-attf-class="oe_product"
                                    t-att-data-ribbon-id="td_product['ribbon'].id"
                                    t-att-data-name="product_block_name"
                                >
                                    <div
                                        t-attf-class="o_wsale_product_grid_wrapper position-relative h-100
                                o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}"
                                    >
                                        <t t-call="website_sale.products_item">
                                            <t
                                                t-set="product"
                                                t-value="td_product['product']"
                                            />
                                        </t>
                                    </div>
                                </td>
                            </t>
                            <td t-else="" />

                        </t>
                    </tr>
                </tbody>
                <tbody t-else="groupByCategory">
                    <t
                        t-set="flat_list"
                        t-value="[item for sublist in bins for item in sublist]"
                    />

                    <t t-foreach="categories" t-as="category">
                        <tr t-if="len(categories) > 1">
                            <td t-att-colspan="p">
                                <div class="o_ws_category_separator">
                                    <t t-out="category.name" />
                                </div>
                            </td>
                        </tr>
                        <t t-else="" />
                        <t
                            t-set="filtered_list"
                            t-value="[i for i in flat_list if (category in i['product'].public_categ_ids)]"
                        />
                        <t
                            t-set="rebinned_bins"
                            t-value="[filtered_list[i:i+p] for i in range(0, len(filtered_list), p)]"
                        />

                        <tr t-foreach="rebinned_bins" t-as="tr_product">
                            <t t-foreach="tr_product" t-as="td_product">
                                <t
                                    t-set="product_categories"
                                    t-value="td_product['product'].public_categ_ids"
                                />
                                <t t-if="td_product">
                                    <td
                                        t-att-colspan="td_product['x'] != 1 and td_product['x']"
                                        t-att-rowspan="td_product['y'] != 1 and td_product['y']"
                                        t-attf-class="oe_product"
                                        t-att-data-ribbon-id="td_product['ribbon'].id"
                                        t-att-data-name="product_block_name"
                                    >
                                        <div
                                            t-attf-class="o_wsale_product_grid_wrapper position-relative h-100
                                o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}"
                                        >
                                            <t
                                                t-if="is_view_active('theme_aplus.products_design_wavy_cards')"
                                                t-call="theme_aplus.products_item"
                                            >
                                                <t
                                                    t-set="product"
                                                    t-value="td_product['product']"
                                                />
                                            </t>
                                        </div>
                                    </td>
                                </t>
                                <t t-else="" />

                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>


        <xpath expr="//tbody/tr/t/t/td/div/t" position="attributes">
            <attribute
                name="t-if"
            >not is_view_active('theme_aplus.products_design_wavy_cards')</attribute>
        </xpath>
        <xpath expr="//tbody/tr/t/t/td/div/t" position="after">
            <t
                t-if="is_view_active('theme_aplus.products_design_wavy_cards')"
                t-call="theme_aplus.products_item"
            >
                <t t-set="product" t-value="td_product['product']" />
            </t>
        </xpath>
    </template>
    <template id="product" inherit_id="website_sale.product">
        <!-- <xpath expr="//section" position="attributes">
            <attribute
                name="t-att-data-highlight-color"
            >product.primary_color</attribute>
            <attribute
                name="t-att-data-highlight-sec-color"
            >product.secondary_color</attribute>
        </xpath> -->

        <!-- Set color for elements using t-attf-style -->
        <xpath expr="//ol[hasclass('breadcrumb')][1]" position="attributes">
            <attribute name="t-attf-style">color:{{product.product_page_text_color}};</attribute>
        </xpath>
        <xpath expr="//div[@id='add_to_cart_wrap']/a" position="attributes">
            <attribute name="t-attf-style">
                background-color:{{product.product_page_text_color}};border-color:{{product.product_page_text_color}};</attribute>
        </xpath>
        <xpath expr="//i[hasclass('fa-minus')][1]" position="attributes">
            <attribute name="t-attf-style">
                color:{{product.product_page_text_color}};</attribute>
        </xpath>
        <xpath expr="//i[hasclass('fa-plus')][1]" position="attributes">
            <attribute name="t-attf-style">
                color:{{product.product_page_text_color}};</attribute>
        </xpath>
        <xpath expr="//div[@id='o_wsale_cta_wrapper']/div[1]" position="attributes">
            <attribute name="t-attf-style">
                border-color:{{product.product_page_text_color}};</attribute>
        </xpath>
        <xpath expr="//h1[@itemprop='name']" position="attributes">
            <attribute name="t-attf-style">color:{{product.product_page_text_color}};</attribute>
        </xpath>

        <!-- Dynamic-ish links to other products in the same category -->
        <xpath expr="//input[@id='wsale_user_email']" position="after">
            <div
                class="related-flavors-block"
                t-if="len(product_variant.public_categ_ids.product_tmpl_ids) > 1"
            >
                <div>
                    <span class="subsection-header">Flavors</span>
                </div>
                <div class="related-flavors">
                    <t
                        t-foreach="product_variant.public_categ_ids.product_tmpl_ids"
                        t-as="rel_product"
                    >
                        <div
                            class="d-flex flex-column align-items-center related-flavor"
                            t-if="rel_product.name != product.name"
                        >
                            <a
                                class="related-product"
                                t-attf-href="{{rel_product.website_url}}"
                            >
                                <!-- <image class="related-flavor-image"
                                    t-attf-src="/web/image/product.template/{{rel_product.id}}/suggestion_image"
                                /> -->
                                <image
                                    class="related-flavor-image"
                                    t-attf-src="/web/image/product.template/{{rel_product.id}}/image_512"
                                />
                            </a>
                            <span t-out="rel_product.name" />
                        </div>

                    </t>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@id='product_details']" position="inside">

            <div
                id="vector_images"
                class="icon-block"
                t-attf-style="fill:{{product.product_page_text_color}};"
            >
                <t t-call="theme_aplus.fruit_vector" />
                <t t-call="theme_aplus.plus_vector" />
                <t t-call="theme_aplus.water_vector" />
                <t t-call="theme_aplus.plus_vector" />
                <t t-call="theme_aplus.maple_vector" />
            </div>
            <div class="icon-block">
                <img
                    src="/theme_aplus/static/src/images/AlimentsDuQuebec_Logo_Renv.svg"
                    width="100px"
                    height="100px"
                />
            </div>

        </xpath>
    </template>

    <template
        id="snippet_options_ecom"
        inherit_id="website.snippet_options"
        name="e-commerce snippet options"
        priority="99"
    >
        <xpath
            expr="//we-row[@id='o_wsale_grid_left_panel']"
            position="before"
            data-variable="group_by"
        >
            <we-row
                id="group_by_categories"
                string="Group by"
                data-variable="group_by_categories"
            >
                <we-button
                    string="Group by Category"
                    data-customize-website-views="theme_aplus.group_by_categories"
                    data-name="group_by_categories_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>

        </xpath>
        <xpath
            expr="//we-button[@data-select-class='o_wsale_design_grid']"
            position="after"
        >
            <we-button
                data-customize-website-views="theme_aplus.products_design_wavy_cards"
            >
                Wavy Cards
            </we-button>
        </xpath>
        <xpath
            expr="//we-select[hasclass('o_wsale_ppr_submenu')]/we-button[3]"
            position="after"
        >
            <we-button data-set-ppr="5">5</we-button>
        </xpath>
        <xpath
            expr="//we-checkbox[@data-customize-website-views='website_sale.product_tags']"
            position="after"
        >
            <we-checkbox
                string="Show Ingredients"
                data-no-preview="true"
                data-customize-website-views="theme_aplus.product_show_ingredients"
                data-reload="/"
                data-name="show_ingredient_opt"
            />
            <we-checkbox
                string="Show Nutrition Table"
                data-no-preview="true"
                data-customize-website-views="theme_aplus.product_nutrition_table"
                data-reload="/"
                data-name="show_nutrition_opt"
            />
            <we-row
                id="bottle_qty_selector"
                string="Bottle Quantity selector"
                data-variable="bottle_qty_selector"
            >
                <we-button
                    string="Bottle Quantity selector"
                    data-customize-website-views="theme_aplus.bottle_quantity_selector"
                    data-name="bottle_quantity_selector_opt"
                    data-no-preview="true"
                    data-reload="/"
                />
            </we-row>
        </xpath>
    </template>

    <template id="bottle_quantity_selector" inherit_id="website_sale.product_quantity" active="False">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <div
                t-attf-class="css_quantity input-group {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} me-2 mb-2 align-middle"
                contenteditable="false">

                <a t-attf-href="#" class="btn btn-link js_add_cart_json"
                    aria-label="Remove one" title="Remove one">
                    <i class="fa fa-minus"></i>
                </a>
                <!-- <t t-call="theme_aplus.bottle_vector">
                        <t t-set="scale" t-value="0.6" />
                    </t> -->
                <input type="text" class="form-control quantity text-center" data-min="1" name="add_qty"
                    t-att-value="add_qty or 1" />

                <a t-attf-href="#" class="btn btn-link float_left js_add_cart_json"
                    aria-label="Add one" title="Add one">
                    <i class="fa fa-plus"></i>
                </a>
            </div>

        </xpath>
    </template>

    <template
        id="product_show_ingredients"
        active="False"
        inherit_id="website_sale.product"
    >
        <xpath expr="//div[@id='vector_images']" position="before">
            <div class="ingredients-block d-flex flex-column pb-5">
                <span class="subsection-header">Ingredients</span>
                <span
                    class="text-muted ingredient-list"
                    t-field="product.ingredients"
                />
            </div>
        </xpath>

    </template>

    <template id="group_by_categories" name="Group By Categories" active="False" />

    <template
        id="products_design_wavy_cards"
        active="False"
        name="Wavy Cards Product Design"
    />

    <template id="search" inherit_id="website.website_search_box">
        <xpath expr="//div" position="attributes">
            <attribute
                name="t-attf-style"
            >border-color:{{product.product_page_text_color if product else ''}};</attribute>
        </xpath>
        <xpath expr="//div/button" position="attributes">
            <attribute name="t-attf-style">
                background-color:{{product.product_page_text_color if product else ''}};
                border-color:{{product.product_page_text_color if product else ''}};</attribute>
        </xpath>
    </template>

    <template id="product_price" inherit_id="website_sale.product_price">
        <xpath expr="//span[hasclass('oe_price')]" position="attributes">
            <attribute
                name="t-attf-style"
            >color:{{product.product_page_text_color if product else ''}};</attribute>
        </xpath>
    </template>

    <template
        id="product_nutrition_table"
        active="False"
        inherit_id="website_sale.product"
    >

        <xpath expr="//div[@id='product_detail_main']/div[1]" position="after">
            <div class="d-flex col-lg-6 mt-lg-4 flex-column align-items-center">
                <div
                    class="nutrition-table justify-center pt-4 w-100"
                    id="nutrition_table"
                >
                    <table class="table caption-top">
                        <caption
                            t-if="product_variant.nutrition_facts_size"
                            t-out="'Nutritional Values (for '+product_variant.nutrition_facts_size+')'"
                        />
                        <thead>
                            <tr>
                                <th class="text-center">Content</th>
                                <th class="text-center">% Daily Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t
                                t-foreach="product_variant.nutrition_entry_ids.sorted('sequence')"
                                t-as="entry"
                            >
                                <tr
                                    t-attf-style="background:{{product.product_page_text_color if entry_parity =='even' else ''}};"
                                >
                                    <th
                                        class="text-center"
                                        t-attf-style="color:{{product.text_color if entry_parity =='even' else ''}};"
                                    >
                                        <t t-out="entry.name" />
                                    </th>
                                    <td
                                        class="text-center"
                                        t-attf-style="color:{{product.text_color if entry_parity =='even' else ''}};"
                                    >
                                        <t t-out="entry.value" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

        </xpath>
        <!-- Move the image carousel into the new div to fix the sticky image bug -->
        <xpath expr="//div[@id='product_detail_main']/div[2]/div" position="before">
            <xpath expr="//div[@id='product_detail_main']/div[1]" position="move" />
        </xpath>


    </template>


</odoo>