<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Scrolling Text Banner Template -->
    <template id="s_scrolling_text_banner" name="Scrolling Text Banner">
        <section class="s_scrolling_text_banner pt16 pb16">
            <div class="container">
                <div
                    class="scrolling-banner-container position-relative overflow-hidden py-3"
                >
                    <div class="scrolling-text-wrapper d-flex">
                        <div class="scrolling-text d-inline-block">
                            <span>Your important announcement here</span>
                            <span class="mx-4">•</span>
                            <span>Special promotion: Use code WELCOME
                                for 10% off</span>
                            <span class="mx-4">•</span>
                            <span>Free shipping on all orders over $50</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>


    <!-- Snippet Options -->
    <template id="s_scrolling_text_banner_options" inherit_id="website.snippet_options">
        <xpath expr="//div[@data-js='Box']" position="after">
            <div data-selector=".s_scrolling_text_banner" data-js="ScrollingBanner">
                <we-colorpicker
                    string="Banner Color"
                    data-dependencies="banner_bg_custom_opt"
                    data-select-style="true"
                    data-css-property="background-color"
                    data-color-prefix="bg-"
                    data-apply-to=".scrolling-banner-container"
                />

                <we-colorpicker
                    string="Text Color"
                    data-select-style="true"
                    data-css-property="color"
                    data-apply-to=".scrolling-text"
                />

            </div>
        </xpath>
    </template>

</odoo>
