<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Infinite Ticker Block Template -->
    <template id="s_scrolling_text_banner" name="Infinite Ticker Block">
        <section
            class="s_scrolling_text_banner o_full_width o_cc o_cc1"
            data-speed="50"
            data-speed-multiplier="1.0"
        >
            <div class="ticker-container">
                <span
                    class="ticker-text ticker-text-editor"
                    contenteditable="true"
                >Infinite Ticker</span>
                <div class="ticker-stripe">
                </div>
            </div>

        </section>
    </template>


    <!-- Snippet Options -->
    <template
        id="s_scrolling_text_banner_options"
        name="Infinite Ticker Block Options"
        inherit_id="website.snippet_options"
    >
        <xpath expr="." position="inside">
            <div data-js="TickerBlock" data-selector=".s_scrolling_text_banner">

                <we-button-group string="Speed" data-dependencies="speedMultiplier_opt">
                    <we-button
                        title="Slower"
                        data-select-class="ticker-speed-05"
                        data-name="speedMultiplier05Option"
                    >0.5x</we-button>
                    <we-button
                        title="Normal"
                        data-select-class="ticker-speed-10"
                        data-name="speedMultiplier10Option"
                        data-select-class-default="true"
                    >1x</we-button>
                    <we-button
                        title="Fast"
                        data-select-class="ticker-speed-15"
                        data-name="speedMultiplier15Option"
                    >1.5x</we-button>
                    <we-button
                        title="Faster"
                        data-select-class="ticker-speed-20"
                        data-name="speedMultiplier20Option"
                    >2x</we-button>
                    <we-button
                        title="Very Fast"
                        data-select-class="ticker-speed-30"
                        data-name="speedMultiplier30Option"
                    >3x</we-button>
                </we-button-group>
            </div>
        </xpath>
    </template>

</odoo>
