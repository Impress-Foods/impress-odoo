<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="snippets" inherit_id="website.snippets" name="A+ - Snippets">
        <xpath expr="//*[@id='default_snippets']" position="before">
            <t id="x_theme_snippets">
                <div id="x_theme_snippets_category" class="o_panel">
                    <div class="o_panel_header">Theme</div>
                    <div class="o_panel_body">
                        <t t-snippet="theme_aplus.s_wave_transition_snippet">
                            <keywords>Transition</keywords>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
