<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="s_image_marquee" name="Image Marquee">
        <section class="s_image_marquee" style="overflow: hidden;">
            <div class="marquee_header">
                <h1> Discover what we're up to!</h1>
                <div>
                    <a href="https://www.instagram.com/aplus.superfruit/">
                        <i class="fa fa-instagram fa-2x" />
                    </a>
                </div>
            </div>
            <div class="marquee" data-speed="10">
                <div class="marquee-inner">
                    <img class="marquee-image" src="/web/image/placeholder.png" />
                </div>
            </div>
        </section>
    </template>

    <record id="s_image_marquee_000_js" model="ir.asset">
        <field name="name">Image Marquee 000 JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field
            name="path"
        >theme_aplus/static/src/snippets/s_image_marquee/000.js</field>
    </record>

    <record id="s_image_marquee_000_scss" model="ir.asset">
        <field name="name">Image Marquee 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field
            name="path"
        >theme_aplus/static/src/snippets/s_image_marquee/000.scss</field>
        <field name="active" eval="False" />
    </record>
</odoo>
