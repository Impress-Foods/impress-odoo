<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View product.template form -->
    <record id="view_product_template_form" model="ir.ui.view">
        <field name="name">view.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="priority">24</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_ribbon_id']" position="after">
                <field name="primary_color" widget="color" />
                <field name="secondary_color" widget="color" />
                <field name="text_color" widget="color" />
                <field name="background_image" widget="image" />
            </xpath>
        </field>
    </record>

</odoo>
