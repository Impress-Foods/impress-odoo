<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <record id="dynamic_filter_window_carousel_filter" model="website.snippet.filter">
        <field
            name="filter_id"
            ref="theme_aplus.dynamic_snippet_newest_product_templates_filter"
        />
        <field
            name="field_names"
            eval="'display_name,id,hero_image,hero_background_color,hero_text_color,hero_sticker'"
        />
        <field name="limit" eval="16" />
        <field name="name">Product Templates - Window</field>
    </record>

    <record id="dynamic_filter_wavy_card_filter" model="website.snippet.filter">
        <field
            name="filter_id"
            ref="theme_aplus.dynamic_snippet_newest_product_templates_filter"
        />
        <field
            name="field_names"
            eval="'display_name,id,image_512,card_primary_color,card_text_color,card_secondary_color,card_background_image,name'"
        />
        <field name="limit" eval="16" />
        <field name="name">Wavy Card Filter</field>
    </record>

    <record id="dynamic_filter_minimalist_card_filter" model="website.snippet.filter">
        <field
            name="filter_id"
            ref="theme_aplus.dynamic_snippet_newest_product_templates_filter"
        />
        <field
            name="field_names"
            eval="'display_name,id,image_512,name,card_image,card_primary_color,card_secondary_color'"
        />
        <field name="limit" eval="16" />
        <field name="name">Minimalist Card Filter</field>
    </record>
</odoo>
