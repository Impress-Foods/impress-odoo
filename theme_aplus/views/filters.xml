<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dynamic_filter_window_carousel_filter" model="website.snippet.filter">
        <field name="filter_id" ref="theme_aplus.dynamic_snippet_newest_product_templates_filter" />
        <field
            name="field_names"
            eval="'display_name,id,hero_image,hero_background_color,hero_text_color,hero_sticker'"
        />
        <field name="limit" eval="16" />
        <field name="name">Product Templates - Window</field>
    </record>

    <record id="dynamic_snippet_newest_product_templates_filter" model="ir.filters">
        <field name="name">Product Templates</field>
        <field name="model_id">product.template</field>
        <field name="user_id" eval="False" />
        <field name="domain">[('website_published', '=', True)]</field>
        <field
            name="context"
        >{'display_default_code': False, 'add2cart_rerender': False}</field>
        <field name="sort">["carousel_order asc"]</field>
        <field name="action_id" ref="website.action_website" />
    </record>

    <record id="dynamic_filter_wavy_card_filter" model="website.snippet.filter">
        <field
            name="filter_id"
            ref="theme_aplus.dynamic_snippet_newest_product_templates_filter"
        />
        <field name="field_names">display_name,id,image_512</field>
        <field name="limit" eval="16" />
        <field name="name">Wavy Card Filter</field>
    </record>


</odoo>