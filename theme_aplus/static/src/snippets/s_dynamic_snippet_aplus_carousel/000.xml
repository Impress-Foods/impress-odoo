<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">


    <t t-name="theme_aplus.aplus_product">
        <div t-att-id="unique_id" class="aplus_product_carousel" t-att-data-bs-interval="interval" data-bs-ride="carousel">
            <!-- Archway Container -->
            <div class="window-frame">
                <!-- Archway Top -->
                <div class="arch-top">
                    <div class="arch-shape"></div>
                </div>

                <t t-set="current_product_index" t-value="0"/>
                <!-- Main Product Display -->
                <div class="main-product-display">
                    <div class="product-window">
                        <div class="product-container">
                            <t t-foreach="data" t-as="product" t-key="product_id">
                                <t t-if="product_index === current_product_index">
                                    <t t-out="product"/>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Product Scroller -->
                <div class="product-scroller">
                    <div class="scroller-track">
                        <!-- Current product first -->
                        <t t-foreach="data" t-as="product" t-key="product_id">
                            <t t-if="product_index === current_product_index">
                                <div class="scroller-item active">
                                    <div class="scroller-name">
                                        <t t-out="product.display_name"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <!-- Next products -->
                        <t t-foreach="data" t-as="product" t-key="product_id">
                            <t t-if="product_index &gt; current_product_index &amp;&amp; product_index &lt; current_product_index + 4">
                                <div class="scroller-item">
                                    <div class="scroller-name">
                                        <t t-out="product.display_name"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <a href="/shop" class="shop_now">SHOP NOW</a>
            </div>
        </div>
    </t>


</templates>