<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="theme_aplus.aplus_product">

        <div class="carousel_container">
            <!-- Debug: Show data count -->
            <!-- <t
                t-log="'Product data count: ' + Object.keys(product_data || {}).length"
            /> -->
            <!-- Main Carousel -->

            <t t-log="product_data" />

            <div
                t-att-id="unique_id"
                class="carousel slide aplus_carousel"
                data-bs-ride="ride"
                t-att-data-bs-interval="interval"
            >

                <!-- Carousel Indicators  -->
                <div class="carousel-indicators visually-hidden">
                    <t t-foreach="product_data" t-as="product" t-key="product_index">
                        <button
                            type="button"
                            t-attf-class="#{product_index == 0 and 'active' or ''}"
                            t-att-data-bs-target="'#' + unique_id"
                            t-attf-data-bs-slide-to="#{product_index}"
                            t-attf-aria-label="Slide #{product_index + 1}"
                            t-att-aria-current="product_index == 0 and 'true' or 'false'"
                        >
                        </button>
                    </t>
                </div>

                <button
                    class="carousel-control-prev visually-hidden"
                    type="button"
                    t-att-data-bs-target="'#' + unique_id"
                    data-bs-slide="prev"
                >
                    <span class="carousel-control-prev-icon " aria-hidden="true" />
                    <span class="visually-hidden">Previous</span>
                </button>

                <button
                    class="carousel-control-next visually-hidden"
                    type="button"
                    t-att-data-bs-target="'#' + unique_id"
                    data-bs-slide="next"
                >
                    <span class="carousel-control-next-icon" aria-hidden="true" />
                    <span class="visually-hidden">Next</span>
                </button>

                <!-- Carousel Items -->
                <div class="carousel-inner h-100">
                    <t
                        t-foreach="product_data"
                        t-as="product_key"
                        t-key="product_index"
                    >
                        <t t-set="product" t-value="product_data[product_key]" />
                        <t t-if="product_key_first">
                            <div t-attf-class="carousel-item active">
                                <t t-call="theme_aplus.aplus_carousel_slide" />
                            </div>
                        </t>
                        <t t-else="">
                            <div t-attf-class="carousel-item">
                                <t t-call="theme_aplus.aplus_carousel_slide" />
                            </div>
                        </t>

                    </t>
                </div>
                <a href="/shop" class="shop-now">
                    <button class="btn btn-primary shop-now-button">Shop Now</button>
                </a>

            </div>

        </div>
    </t>

    <!-- Carousel Slide -->
    <t t-name="theme_aplus.aplus_carousel_slide">
        <div class="carousel-content">
            <svg width="300" height="200" viewbox="0 0 300 200" class="arc-text">

                <path
                    id="curve"
                    d="M10 200C70 30 220 30 290 200"
                    fill="transparent"
                    stroke="transparent"
                />
                <text
                    class="title-text"
                    t-att-fill="product.primary_color"
                    t-attf-style="text-shadow: 2px 2px 0px black"
                >
                    <textPath href="#curve" text-anchor="middle" startOffset="50%">
                        <t t-out="product.display_name" />
                    </textPath>
                </text>
            </svg>


            <!-- <h3 t-out="product.display_name" /> -->
            <div class="product-image">
                <t t-if="product.image_512">
                    <img
                        loading="lazy"
                        t-att-src="product.image_512"
                        t-att-alt="product.display_name"
                    />
                </t>
                <t t-else="">
                    <span>No image available</span>
                </t>
            </div>
            <!-- <p class="product-description" t-out="product.description or ''" /> -->
        </div>
    </t>
</templates>
