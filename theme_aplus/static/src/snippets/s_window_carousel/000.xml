<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="theme_aplus.window_carousel">
        <div class="d-flex flex-column">
            <div class="carousel_container">
                <div
                    class="carousel slide aplus_carousel"
                    data-bs-ride="carousel"
                    t-att-data-bs-interval="interval"
                >
                    <div class="carousel-inner h-100">
                        <t t-foreach="products" t-as="product" t-key="product['id']">
                            <div
                                class="carousel-item"
                                t-att-class="{ active: product_index === 0 }"
                                t-att-data-product-id="product['id']"
                                t-att-data-bg-color="product['hero_background_color']"
                                t-att-data-text-color="product['hero_text_color']"
                                t-att-data-product-url="product['product_url']"
                                t-att-data-sticker-url="product['hero_sticker']"
                            >
                                <div class="carousel-content">
                                    <div class="product-image">
                                        <a t-att-href="product['product_url']">
                                            <img
                                                loading="lazy"
                                                t-att-src="product['hero_image']"
                                            />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <div class="shop-now">
                <a href="/shop" class="shop-now-button" data-url="/shop">
                    Shop Now
                </a>
            </div>
        </div>
    </t>
</templates>
