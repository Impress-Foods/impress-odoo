<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="theme_aplus.window_carousel">
        <div class="d-flex flex-column">
            <div class="carousel_container">
                <div
                    t-att-id="unique_id"
                    class="carousel slide aplus_carousel"
                    data-bs-ride="ride"
                    t-att-data-bs-interval="interval"
                >
                    <t t-call="theme_aplus.window_carousel_window" />
                </div>
            </div>
            <div class="shop-now">
                <a href="/shop" class="shop-now-button">
                    Shop Now
                </a>
            </div>
        </div>
    </t>


    <t t-name="theme_aplus.window_carousel_window">
        <div class="carousel-inner h-100">
            <t t-foreach="data" t-as="product_key" t-key="product_index">

                <t t-set="product" t-value="data[product_key]" />
                <t t-if="product_key_first">
                    <div t-attf-class="carousel-item active">
                        <div class="carousel-content">
                            <t t-call="theme_aplus.window_carousel_image" />
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div t-attf-class="carousel-item">
                        <div class="carousel-content">
                            <t t-call="theme_aplus.window_carousel_image" />
                        </div>
                    </div>
                </t>

            </t>
        </div>
    </t>


    <t t-name="theme_aplus.window_carousel_image">
            <div class="product-image">
                <t t-if="product.hero_image">
                    <img
                    loading="lazy"
                    t-att-src="product.hero_image"
                    t-att-alt="product.display_name"
                />
                </t>
                <t t-else="">
                    <span>No image available</span>
                </t>
            </div>
    </t>
    <!-- Carousel Slide -->
    <t t-name="theme_aplus.window_carousel_slide">
        <div class="carousel-content">
            <svg viewbox="0 0 300 200" class="arc-text">
                <path
                    id="curve"
                    d="M10,200 A 130 150 180 0 1 290 200"
                    fill="transparent"
                    stroke="transparent"
                />
                <text class="title-text" t-att-fill="product.primary_color">

                    <textPath href="#curve" text-anchor="middle" startOffset="50%">
                        <t t-out="product.display_name" />
                    </textPath>
                </text>
            </svg>
            <t t-call="theme_aplus.window_carousel_image" />
        </div>
    </t>
</templates>
