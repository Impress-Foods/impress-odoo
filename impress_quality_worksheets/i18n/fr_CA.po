#: model_terms:ir.ui.view,arch_db:impress_quality_worksheets.MetalWorksheet_large_20260303_form_view
msgid ""
"Détecteur métal : Si l'éjection de l'un des témoins de métal est Non-"
"Conforme, appeler le contrôle de la qualité, remplir un registre d'écart, "
"réajuster l'appareil et\n"
"                            repasser tous les produits depuis la dernière "
"vérification conforme. S'il y a un rejet de métal durant la production, "
"aviser le contrôle de la qualité."
msgstr ""
"Détecteur métal : Si l'éjection de l'un des témoins de métal est Non-"
"Conforme, appeler le contrôle de la qualité, remplir un registre d'écart, "
"réajuster l'appareil et\n"
"                            repasser tous les produits depuis la dernière "
"vérification conforme. S'il y a un rejet de métal durant la production, "
"aviser le contrôle de la qualité."

