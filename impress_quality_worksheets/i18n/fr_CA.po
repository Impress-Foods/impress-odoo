#. module: impress_quality_worksheets
#: model_terms:ir.ui.view,arch_db:impress_quality_worksheets.MetalWorksheet_20250203_form_view
#: model_terms:ir.ui.view,arch_db:impress_quality_worksheets.MetalWorksheet_large_20260303_form_view
msgid ""
"Calibration : Comparer le poids d'une bouteille avec la balance de table et "
"la Loma, si l'écart est de 2g et +, faire une calibration. <br/> "
"Remplissage : Comparer le\n"
"                            poids moyen des bouteilles vs le poids visé. Si "
"l'écart est de + / - 3g, ajuster l'embouteilleuse. <br/> Lors de la dernière "
"vérification, vérifier qu'aucune bouteille ne\n"
"                            reste dans les bacs de rejet. <br/>"
msgstr ""
"Calibration : Comparer le poids d'une bouteille avec la balance de table et "
"la Loma, si l'écart est de 2g et +, faire une calibration. <br/> "
"Remplissage : Comparer le\n"
"                            poids moyen des bouteilles vs le poids visé. Si "
"l'écart est de + / - 3g, ajuster l'embouteilleuse. <br/> Lors de la dernière "
"vérification, vérifier qu'aucune bouteille ne\n"
"                            reste dans les bacs de rejet. <br/>"

