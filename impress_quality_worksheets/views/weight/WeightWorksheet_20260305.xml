<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id='weightWorksheet_20260305_form_view' model='ir.ui.view'>
        <field name="name">weight.worksheet.20260305.form.view</field>
        <field
            name="model"
            model="ir.model"
            eval="obj().env.ref('impress_quality_worksheets.ws_weight_20260305').model_id.model"
        />
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form create="false" js_class="worksheet_validation">
                <sheet>
                    <group
                        invisible="context.get('studio') or context.get('default_x_quality_check_id')"
                    >
                        <group>
                            <field name="x_quality_check_id" />
                        </group>
                    </group>
                    <div name="instructions">
                        <ol>
                            <li
                            >S'assurer que la balance est stable sur une table de travail.</li>
                            <li
                            >Faire la tare (cup + pellicule de plastique ou pochette).</li>
                            <li
                            >Prise du poids de 5 produits à toutes les 30 minutes lors du dosage.</li>
                            <li
                            >Comparer le poids du produit avec le poids visé pour cette production : si poids sous la cible ou + de 3g, faire un ajustement.</li>
                            <li
                            >Vérifier que le scellage est conforme (temps et température + les 5 positions si VC999 utilisé).</li>
                            <li
                            >Aviser le contrôle qualité si le poids est en dessous de la limite visée.</li>
                        </ol>
                    </div>
                    <group>
                        <group>
                            <field name="x_nominal_weight" />
                        </group>

                    </group>

                    <field name="x_weight_log_line_ids" nolabel="1">
                        <form>
                            <group>
                                <group>
                                    <field name="nominal_weight" required='1' />
                                    <field name="is_seal_ok" required='1' />
                                    <field name="is_weight_ok" required='1' />
                                    <field name="start_date" required='1' />
                                    <field name="notes" />
                                </group>
                                <group>
                                    <field name="measure_1" required='1' />
                                    <field name="measure_2" required='1' />
                                    <field name="measure_3" required='1' />
                                    <field name="measure_4" required='1' />
                                    <field name="measure_5" required='1' />
                                    <field
                                        name="signature"
                                        required='1'
                                        widget="signature"
                                        options="{'size':[0,90]}"
                                    />
                                </group>
                            </group>
                        </form>
                    </field>

                    <div class="text-center">
                        <strong
                        >Pour l'utilisation exclusive de Impress Foods. Mis à jour le 05 mars 2026. Feuille de contrôle Poids </strong>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
