<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id='MetalWorksheet_20250203_form_view' model='ir.ui.view'>
        <field name="name">Metal.worksheet.20250203.form.view</field>
        <field
            name="model"
            model="ir.model"
            eval="obj().env.ref('impress_quality_worksheets.ws_metal_20250203').model_id.model"
        />
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form create="false" js_class="worksheet_validation">
                <sheet>
                    <group
                        invisible="context.get('studio') or context.get('default_x_quality_check_id')"
                    >
                        <group>
                            <field name="x_quality_check_id" />
                        </group>
                    </group>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        name="studio_div_3b1faf"
                    >
                        <p
                        >Détecteur métal : Si l'éjection de l'un des témoins de métal est Non-Conforme, appeler le contrôle de la qualité, remplir un registre d'écart, réajuster l'appareil et
                            repasser tous les produits depuis la dernière vérification conforme. S'il y a un rejet de métal durant la production, aviser le contrôle de la qualité.</p>
                        <p>Fréquence : <ul>
                                <li
                                >Au début et à la fin du quart de travail/production chaque jour.</li>
                                <li
                                >À des intervalles de ≤ 2 heures pendant l'exécution de la production.</li>
                                <li
                                >Lorsque des changements surviennent dans les lots de production.</li>
                                <li
                                >Lorsque des changements surviennent dans les réglages de l'appareil.</li>
                                <li
                                >Après le temps d'arrêt à des fins de réparation.</li>
                            </ul>
                        </p>
                        <p
                        > Calibration : Comparer le poids d'une bouteille avec la balance de table et la Loma, si l'écart est de 2g et +, faire une calibration. <br
                            /> Remplissage : Comparer le
                            poids moyen des bouteilles vs le poids visé. Si l'écart est de + / - 3g, ajuster l'embouteilleuse. <br
                            /> Lors de la dernière vérification, vérifier qu'aucune bouteille ne
                            reste dans les bacs de rejet. <br />
                        </p>
                    </div>
                    <field name="x_metal_log_line_ids" nolabel="1">
                        <form>
                            <group>
                                <group>
                                    <field name="calibration" required='1' />
                                    <field name="ejection" required='1' />
                                    <field name="reject_value" required='1' />
                                    <field name="mean_weight" required='1' />
                                    <field name="start_date" required='1' />
                                    <field name="notes" />
                                </group>
                                <group>
                                    <field
                                        name="ferrous"
                                        required='1'
                                        string="Ferrous (2.0 mm)"
                                    />
                                    <field
                                        name="non_ferrous"
                                        required='1'
                                        string="Non ferrous (2.5 mm)"
                                    />
                                    <field
                                        name="stainless"
                                        required='1'
                                        string="Stainless (3.5 mm)"
                                    />
                                    <!-- <field name="torque" required='0' /> -->
                                    <field
                                        name="signature"
                                        widget="signature"
                                        options="{'size':[0,90]}"
                                        required='1'
                                    />
                                </group>
                            </group>
                        </form>
                    </field>
                    <div class="text-center">
                        <strong
                        >Pour l'utilisation exclusive de Impress Foods. Mis à jour le 03 Février 2025. Feuille de contrôle Détecteur de Métal </strong>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
