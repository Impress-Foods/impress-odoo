<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id='codingWorksheet_cases_form_view' model='ir.ui.view'>
        <field name="name">coding.worksheet.cases.form.view</field>
        <field
            name="model"
            model="ir.model"
            eval="obj().env.ref('impress_quality_worksheets.ws_coding_cases_20250723').model_id.model"
        />
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form create="false" js_class="worksheet_validation">
                <sheet>
                    <group
                        invisible="context.get('studio') or context.get('default_x_quality_check_id')"
                    >
                        <group>
                            <field name="x_quality_check_id" />
                        </group>
                    </group>
                    <div>
                        <p>
                            <span style="font-weight: bold;">Frequency: </span>
                            <span>At the start of every finished product format</span>
                        </p>
                    </div>

                    <group>
                        <group>
                            <field name="x_lot_id" readonly="1" />
                            <field name="x_shelf_life" readonly='1' />
                            <field name="x_case_code" required='1' />
                            <field name="x_case_check" required='1' />
                            <field name="x_start_date" required='1' />
                            <field name="x_notes" />
                        </group>
                        <group>
                            <field name="x_subunit_check" required='1' />
                            <field name="x_shelf_life_check" required='1' />
                            <field name="x_keep_cold_check" required='1' />
                            <field
                                name="x_signature"
                                widget="signature"
                                options="{'size':[0,90]}"
                                required='1'
                                string="Initials"
                            />
                        </group>
                    </group>

                    <div class="text-center">
                        <strong>Pour l'utilisation exclusive de Impress Foods</strong>
                        <strong> • </strong>
                        <strong>Mis à jour le 23 Juillet 2026</strong>
                        <strong> • </strong>
                        <strong>Feuille de contrôle Codage Caisses</strong>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
