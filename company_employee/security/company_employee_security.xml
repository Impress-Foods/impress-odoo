<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company record rules: only records belonging to the companies the
         user is allowed to access are visible. Mirrors the core HR behaviour. -->
    <record id="company_employee_comp_rule" model="ir.rule">
        <field name="name">Company Employee: multi-company</field>
        <field name="model_id" ref="model_company_employee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="company_department_comp_rule" model="ir.rule">
        <field name="name">Company Department: multi-company</field>
        <field name="model_id" ref="model_company_department"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
