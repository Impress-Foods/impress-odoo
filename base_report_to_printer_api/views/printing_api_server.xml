<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="printing_api_server_view_list" model="ir.ui.view">
        <field name="name">printing.api.server.list</field>
        <field name="model">printing.api.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="url" />
                <field name="method" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="printing_api_server_view_form" model="ir.ui.view">
        <field name="name">printing.api.server.form</field>
        <field name="model">printing.api.server</field>
        <field name="arch" type="xml">
            <form string="API Printing Endpoint">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" />
                            <field name="method" />
                            <field name="timeout" />
                        </group>
                        <group>
                            <field name="api_key" password="True" />
                            <field name="debug_logging" />
                        </group>
                    </group>
                    <field
                        name="printer_ids"
                        nolabel="1"
                        context="{'default_api_server_id': id, 'default_backend': 'api'}"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_printing_api_server" model="ir.actions.act_window">
        <field name="name">API Endpoints</field>
        <field name="res_model">printing.api.server</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="printing_api_server_menu"
        name="API Endpoints"
        parent="base_report_to_printer.printing_menu"
        action="action_printing_api_server"
        sequence="25"
    />
</odoo>
