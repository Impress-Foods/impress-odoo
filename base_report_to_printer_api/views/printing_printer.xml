<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="printing_printer_view_form_inherit_api" model="ir.ui.view">
        <field name="name">printing.printer.form.inherit.api</field>
        <field name="model">printing.printer</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_printer_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='name']" position="inside">
                <field
                    name="api_server_id"
                    invisible="backend != 'api'"
                    required="backend == 'api'"
                    domain="[('active', '=', True)]"
                    options="{'no_quick_create': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="printing_printer_view_list_inherit_api" model="ir.ui.view">
        <field name="name">printing.printer.list.inherit.api</field>
        <field name="model">printing.printer</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_printer_view_tree"
        />
        <field name="arch" type="xml">
            <field name="backend" position="after">
                <field name="api_server_id" optional="show" />
            </field>
        </field>
    </record>
</odoo>
