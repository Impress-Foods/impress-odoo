<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_actions_report_view_form_inherit_api" model="ir.ui.view">
        <field name="name">ir.actions.report.form.inherit.api</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base_report_to_printer.act_report_xml_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='print']/group/field[@name='printing_printer_id']"
                position="after"
            >
                <field
                    name="print_report_id"
                    invisible="report_type != 'api'"
                    required="report_type == 'api'"
                    domain="[('model', '=', model)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
