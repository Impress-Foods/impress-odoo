<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>
    <record id="erp_backend_view_form" model="ir.ui.view">
        <field name="name">erp_backend.view.form</field>
        <field name="model">erp.backend</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button
                        type="object"
                        name="action_sync_partners"
                        string="Sync Partners"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_ping"
                            type="object"
                            icon="fa-signal"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Ping Backend</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="backend_type" />
                        </group>
                        <group>
                            <field name="base_url" />
                            <field name="api_key" password="True" />
                        </group>
                    </group>

                    <notebook>
                        <page name="general" string="General">
                            <group>
                                <group name="contacts" string="Contacts">
                                    <field name="partner_category_id" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="erp_backend_action" model="ir.actions.act_window">
        <field name="name">External ERP Backends</field>
        <field name="res_model">erp.backend</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p
                class="oe_view_nocontent_create"
            > There is no examples. click here to add new ERP Backend. </p>
        </field>
    </record>
</odoo>
