<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="report_product_template_label_pdf" model="ir.actions.report">
        <field name="name">Product Label 2x4 (PDF)</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">label_printing_wizard.report_simple_label_2x4</field>
        <field name="report_file">label_printing_wizard.report_simple_label_2x4</field>
        <field name="paperformat_id" ref="label_printing_wizard.label_2x4" />
        <field name="print_report_name">'Products Labels - %s' % (object.name)</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="product.model_product_template" />
    </record>

    <template id="report_simple_label_2x4">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="product">
                <div class="o_label_full">
                    <div style="padding-left: 30%; padding-top:10%;">
                        <span t-field="product.display_name" />
                        <span t-field="product.id" />
                        <span t-field="product.type" />
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
