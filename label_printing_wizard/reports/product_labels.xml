<?xml version="1.0" encoding="UTF-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>


    <template id="label_product_product_zpl_2x4">
        <t t-foreach="docs" t-as="product_info">
            <t t-foreach="range(product_info['label_count'])" t-as="count">
                <t t-set="product" t-value="product_info['product_record']" />
                <t t-set="product_qty" t-value="product_info['product_quantity']" />
                <t t-translate="off">

<t t-out="'^XA^CI28'" />
                <t name="product_name">
<t
                            t-out="'^FO10,10 ^A0N,66,44^FB800,2,0,L^FD' + product_info['display_name_markup'] + '^FS'"
                        />
                </t>
                <t t-if="product_qty != 0" name="product_quantity">
<t
                            t-out="'^FO10,250 ^A0N,66,44^FB800,2,0,L^FDQTY: ' + str(product_qty) + ' ' + product.uom_id.display_name + '^FS'"
                        />
                </t>
                <t t-if="product_info['packaging_name']" name="packaging_name">
                    <t t-call="label_printing_wizard.packaging_block_2x4">
                        <t t-set="name" t-value="product_info['packaging_name']" />
                        <t t-set="qty" t-value="product_info['packaging_qty']" />
                    </t>
                </t>

                <t name="barcode">
                    <t t-if="product.valid_ean and product_info['gs1_barcode']">
<t t-out="'^FO550,160^BY3 ^BXN,12,200 ^FD' + product_info['gs1_barcode'] + '^FS'" />
                    </t>
                    <t t-else="">
<t t-out="'^FO550,160^BY3 ^BXN,12,200 ^FD' + product.barcode + '^FS'" />
                    </t>
                </t>
<t t-out="'^XZ'" />
                </t>
            </t>
        </t>
    </template>

    <template id="label_product_product_zpl_4x6">
        <t t-foreach="docs" t-as="product_info">
            <t t-foreach="range(product_info['label_count'])" t-as="count">
                <t t-set="product" t-value="product_info['product_record']" />
                <t t-set="product_qty" t-value="product_info['product_quantity']" />
                <t t-translate="off">

                    <t name="setup">
<t t-out="'^XA^CI28'" />
                    </t>
                    <t name="product_name">
<t
                            t-out="'^FO600,50 ^A0R,88,66^FB1100,2,0,L^FD' + product_info['display_name_markup'] + '^FS'"
                        />
                    </t>
                    <t t-if="product_qty != 0" name="product_qty">
<t
                            t-out="'^FO400,50 ^A0R,88,66^FDQTY: ' + str(product_qty) + ' ' + product.uom_id.display_name + '^FS'"
                        />
                    </t>
                    <t t-if="product_info['packaging_name']" name="packaging_name">
                        <t t-call="label_printing_wizard.packaging_block_4x6">
                            <t t-set="name" t-value="product_info['packaging_name']" />
                            <t t-set="qty" t-value="product_info['packaging_qty']" />
                        </t>
                    </t>
                    <t name="barcode">
                        <t t-if="product.valid_ean and product_info['gs1_barcode']">
<t t-out="'^FO100,800^BY3 ^BXR,20,200 ^FD' + product_info['gs1_barcode'] + '^FS'" />
                        </t>
                        <t t-else="">
<t t-out="'^FO100,800^BY3 ^BXR,20,200 ^FD' + product.barcode + '^FS'" />
                        </t>
                    </t>
                    <t name="footer">
<t t-out="'^XZ'" />
                    </t>
                </t>
            </t>
        </t>
    </template>





</odoo>
