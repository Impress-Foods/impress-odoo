<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="stock_barcode_lineComponent_inherit_add_printing_button"
        t-inherit="stock_barcode.LineComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath
            expr="//div[hasclass('o_line_buttons')]/span[1]/button[1]"
            position="before"
        >
            <button t-on-click="labelWizard" class="o_line_button o_edit btn">
                <i class="fa fa-2x fa-print" />
            </button>
        </xpath>
    </t>
</templates>
