<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-name="label_printing_wizard.LineUpperButtons"
        t-inherit="stock_barcode.LineUpperButtons"
        t-inherit-mode="extension"
    >
        <xpath expr="//div/button[1]" position="before">
            <button
                t-if="!displayToggleBtn and env.model.resModel === 'stock.picking'"
                class="o_line_button o_edit btn btn-secondary"
                t-on-click="labelWizard"
            >
                <i class="fa fa-lg fa-print" role="img" />
            </button>
        </xpath>
    </t>


    <t
        t-name="label_printing_wizard.LineLot"
        t-inherit="stock_barcode.LineLot"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[1]" position="before">
            <button
                t-if="!displayToggleBtn and env.model.resModel === 'stock.picking'"
                class="o_line_button o_edit btn btn-secondary"
                t-on-click="labelWizard"
            >
                <i class="fa fa-lg fa-print" role="img" />
            </button>
        </xpath>
    </t>

</templates>
