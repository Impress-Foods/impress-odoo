<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="stock_barcode.GroupedLineComponent_inherit"
        t-inherit="stock_barcode.GroupedLineComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//button[1]" position="before">
            <button
                t-on-click="labelWizard"
                class="o_line_button btn btn-primary ms-2 ms-sm-4"
            >
                <i class="fa fa-2x fa-print" />
            </button>
        </xpath>
    </t>
</templates>
