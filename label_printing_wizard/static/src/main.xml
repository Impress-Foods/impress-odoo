<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t
        t-name="label_printing_wizard.MainComponent"
        t-inherit="stock_barcode.MainComponent"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o_stock_mobile_barcode')]" position="before">
            <button
                t-if="env.model.formViewId and resModel === 'stock.picking'"
                t-on-click="labelWizard"
                class="btn nav-link"
            >
                <i class="fa fa-print" />
            </button>
        </xpath>
    </t>

</templates>
