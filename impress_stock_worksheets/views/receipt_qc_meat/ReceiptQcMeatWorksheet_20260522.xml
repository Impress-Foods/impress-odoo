<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ws_receipt_qc_meat_20260522_form_view" model="ir.ui.view">
        <field name="name">ws.receipt.qc_meat.20260522.form.view</field>
        <field
            name="model"
            model="ir.model"
            eval="obj().env.ref('impress_stock_worksheets.ws_receipt_qc_meat_20260522').model_id.model"
        />
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form create="false" js_class="worksheet_validation">
                <sheet>
                    <group
                        invisible="context.get('studio') or context.get('default_x_quality_check_id')"
                    >
                        <group>
                            <field name="x_quality_check_id" />
                        </group>
                    </group>
                    <group name="meat" string="Meat">
                        <group name="all_meats" string="All">
                            <field
                                name="x_product_provenance"
                                string="Provenance of product: canadian or foreign with import certificate."
                                widget="selection_badge"
                                options="{&quot;size&quot;:&quot;sm&quot;}"
                            />
                            <field
                                name="x_acia_stamp"
                                string="ACIA stamp present?"
                                widget="selection_badge"
                                options="{&quot;size&quot;:&quot;sm&quot;}"
                            />
                            <field
                                name="x_microbial_analysis"
                                string="Microbial analysis (if needed)"
                                widget="selection_badge"
                                options="{&quot;size&quot;:&quot;sm&quot;}"
                            />
                        </group>
                        <group>
                            <separator string="Beef" />
                            <field
                                name="x_thirty_months_mark"
                                string="Marked or triangle if age > 30 months and exports"
                                widget="selection_badge"
                                options="{&quot;size&quot;:&quot;sm&quot;}"
                            />
                            <separator string="Turkey" />
                            <field
                                name="x_egg_mention"
                                string="No 'eggs' allergen mention"
                                widget="selection_badge"
                                options="{&quot;size&quot;:&quot;sm&quot;}"
                            />
                            <field
                                name="x_toms_only_mention"
                                string="'Toms Only' mention on invoices and BoL"
                                widget="selection_badge"
                                options="{&quot;size&quot;:&quot;sm&quot;}"
                            />
                        </group>
                    </group>
                    <div class="text-center">
                        <strong
                        >Pour l'utilisation exclusive de Impress Foods. Mis à jour le 22 mai 2026. Feuille de contrôle Relâche Réception </strong>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
