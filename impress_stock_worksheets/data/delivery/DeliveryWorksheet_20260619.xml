<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="https://raw.githubusercontent.com/odoo/odoo/refs/heads/17.0/odoo/import_xml.rng" type="application/XML"?>
<odoo>
    <!-- Create a new Worksheet Template -->
    <record id="ws_delivery_20260619" model="worksheet.template">
        <field name="name">Worksheet delivery 2026-06-19</field>
        <field name="res_model">quality.check</field>
    </record>

    <!-- Add the required fields -->

    <record id='delivery_20260619_x_pallet_used' model='ir.model.fields'>
        <field name="name">x_pallet_used</field>
        <field name="field_description">Type of pallet used</field>
        <field
            name="model_id"
            model="ir.model"
            eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id"
        />
        <field name="ttype">selection</field>
        <field
            name="selection"
        >[('chep', 'CHEP'), ('white', 'Blanche'), ('n/a', 'Non applicable')]</field>
    </record>

    <record id="delivery_20260619_x_ccps_approved" model="ir.model.fields">
        <field name="name">x_ccps_approved</field>
        <field
            name="model_id"
            model="ir.model"
            eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id"
        />
        <field name="ttype">selection</field>
        <field
            name="selection"
        >[('true', 'Conforme'), ('false', 'Non Conforme')]</field>
    </record>
    <record id='delivery_20260619_x_truck_state' model='ir.model.fields'>
        <field name="name">x_truck_state</field>
        <field name="field_description">Truck state and cleanliness</field>
        <field
            name="model_id"
            model="ir.model"
            eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id"
        />
        <field name="ttype">selection</field>
        <field
            name="selection"
        >[('true', 'Conforme'), ('false', 'Non Conforme')]</field>
    </record>

    <record id='delivery_20260619_x_product_state' model='ir.model.fields'>
        <field name="name">x_product_state</field>
        <field name="field_description">Product state and cleanliness</field>
        <field
            name="model_id"
            model="ir.model"
            eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id"
        />
        <field name="ttype">selection</field>
        <field
            name="selection"
        >[('true', 'Conforme'), ('false', 'Non Conforme')]</field>
    </record>
    <!--
    <record id='delivery_20260619_x_driver_id' model='ir.model.fields'>
        <field name="name">x_driver_id</field>
        <field name="field_description">Driver ID'd</field>
        <field name="model_id" model="ir.model" eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id" />
        <field name="ttype">selection</field>
        <field name="selection">[('true', 'Conforme'), ('false', 'Non Conforme'), ('n/a', 'Non applicable')]</field>
    </record>
    -->

    <record id='delivery_20260619_x_signature' model='ir.model.fields'>
        <field name="name">x_signature</field>
        <field name="field_description">Signature</field>
        <field
            name="model_id"
            model="ir.model"
            eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id"
        />
        <field name="ttype">binary</field>
    </record>
    <!--
    <record id='delivery_20260619_x_truck_picture' model='ir.model.fields'>
        <field name="name">x_truck_picture</field>
        <field name="field_description">Truck Picture</field>
        <field name="model_id" model="ir.model" eval="obj().env.ref('impress_stock_worksheets.ws_delivery_20260619').model_id"/>
        <field name="ttype">binary</field>
    </record>
    -->
</odoo>
