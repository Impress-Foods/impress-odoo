<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_view_kanban_inherit" model="ir.ui.view">
        <field name="name">stock.picking.view.kanban.barcode.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_barcode.stock_picking_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <span class="ps-2">
                    <field name="origin" invisible="not origin" />
                </span>
            </xpath>
        </field>
    </record>
    <record id="stock_picking_view_kanban_barcode_inherit" model="ir.ui.view">
        <field name="name">stock.picking.view.kanban.stock.barcode</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_barcode.stock_picking_view_kanban" />
        <field name="mode">extension</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <button
                    action="action_open_picking_backend_form"
                    class="fa fa-desktop"
                    title="Open Form"
                />
            </xpath>
        </field>
    </record>
</odoo>
