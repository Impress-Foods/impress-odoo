<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t
        t-name="impress_barcode.add_image"
        t-inherit="stock_barcode.LineComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_barcode_line_details')]" position='before'>
            <div
                class="d-flex align-items-center me-4"
                style="width: 128px; height: 128px;"
            >
                <img
                    style="max-height: 100%; width: auto; margin: auto;"
                    t-attf-src="/web/image?model=product.product&amp;id={{props.line.product_id.id}}&amp;field=image_128"
                />
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_barcode_line')]" position="attributes">
            <attribute name="t-att-style">style</attribute>
        </xpath>
    </t>

    <t
        t-name="impress_barcode.HideUnreservedDeleteButton"
        t-inherit="stock_barcode.LineLowerButtons"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//button[hasclass('o_delete_line')]" position="attributes">
            <attribute name="t-if">!props.line.isUnreservedLine</attribute>
        </xpath>
    </t>

    <t
        t-name="impress_barcode.LineQuantity"
        t-inherit="stock_barcode.LineQuantity"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[@name='quantity']/span[2]" position="inside">
            <span
                style="color: var(--danger);"
                t-if="qtyDemand &lt; plannedQty"
                t-esc="'(' + qtyDemand +'/'+plannedQty +')'"
            />
        </xpath>
    </t>
</templates>
