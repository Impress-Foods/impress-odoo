<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t
        t-name="stock_barcode_main_inherit_add_origin"
        t-inherit="stock_barcode.MainComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//header//nav/button[2]/div[1]" position="replace">
            <t t-if="env.model.origin">
                <div t-esc="env.model.name + ' - ' + env.model.origin" />
            </t>
            <t t-else="">
                <div t-esc="env.model.name" />
            </t>
        </xpath>
    </t>


    <t
        t-name="stock_barcode_main_inherit_add_move_line"
        t-inherit="stock_barcode.MainComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div/t/div/t" position="after">
            <t t-if="unreservedMoves.length != 0">
                <div
                    class="o_barcode_line list-group-item d-flex flex-row flex-nowrap"
                    style="background: #ffc107;"
                >
                    <div class="justify-content-center">
                        <i class="fa fa-exclamation-triangle" />
                        <span> MISSING PRODUCT(S) </span>
                        <i class="fa fa-exclamation-triangle" />
                    </div>
                </div>

                <t t-set="index" t-value="1" />
                <t t-foreach="unreservedMoves" t-as="move" t-key="index">
                    <MoveComponent move="move" />
                    <t t-set="index" t-value="index+1" />
                </t>
            </t>
        </xpath>
    </t>

    <t
        t-name="stock_barcode_main_inherit_reservation_button"
        t-inherit="stock_barcode.MainComponent"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//header//nav/t/button[1]" position="after">
            <button
                t-if="env.model.formViewId"
                t-on-click="() => this.doReservation()"
                class="o_show_information btn nav-link"
            >
                <i class="fa fa-check fa-large" />
            </button>
        </xpath>
    </t>

</templates>
