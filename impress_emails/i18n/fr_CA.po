"                                            <strong>Order Date / Date de "
"commande:</strong>\n"
"                                            <t t-"
"out=\"object.sale_id.date_order\" t-options=\"{&quot;widget&quot;: "
"&quot;date&quot;}\"/>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"\n"
"                                <hr t-attf-style=\"border: 0; border-top: "
"1px solid {{headingColor}}; margin: 30px 0;\"/>\n"
"\n"
"                                <h2 t-attf-style=\"font-size: 18px; color: "
"{{headingColor}}; margin: 0 0 15px;\">Items in this shipment / Articles dans "
"cet envoi:</h2>\n"
"                                <t t-call=\"impress_emails.product_list\"/>\n"
"\n"
"                                <p t-attf-style=\"margin-top: 30px;color:"
"{{textColor}};\"> Thank you for your order! We hope you enjoy your products. "
"<br/> Nous vous remercions pour votre commande! Nous espérons que\n"
"                  vous apprécierez vos produits. </p>\n"
"                                <p t-attf-style=\"color:{{textColor}};\"> "
"Sincerely, / Sincèrement,<br/> The Impress Foods Team / L'équipe des "
"Aliments Impress </p>\n"
"                            </td>\n"
