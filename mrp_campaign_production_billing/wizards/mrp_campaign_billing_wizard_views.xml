<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_mrp_campaign_billing_wizard_form" model="ir.ui.view">
        <field name="name">mrp.campaign.billing.wizard.form</field>
        <field name="model">mrp.campaign.billing.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field
                            name="campaign_id"
                            readonly="1"
                            invisible="not campaign_id"
                        />
                        <field
                            name="product_id"
                            invisible="campaign_id"
                            readonly="campaign_id"
                        />
                        <field
                            name="planned_date"
                            invisible="campaign_id"
                            required="True"
                        />
                    </group>
                </group>
                <field name="selection_line_ids" nolabel="1">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="selected" />
                        <field name="sale_order_id" readonly="1" />
                        <field name="client_order_ref" readonly="1" />
                        <field
                            name="end_product_id"
                            readonly="1"
                            string="End Product"
                        />
                        <field name="promised_qty" readonly="1" string="Qty" />
                    </tree>
                </field>
                <footer>
                    <button
                        name="process_wizard"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_mrp_campaign_billing_wizard_create"
        model="ir.actions.act_window"
    >
        <field name="name">Create Campaign (Billing)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.campaign.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_mrp_campaign_billing_wizard_add" model="ir.actions.act_window">
        <field name="name">Add Billing Demand</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.campaign.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_mrp_campaign_billing_wizard"
        name="Create Campaign (Billing)"
        parent="mrp_campaign.menu_mrp_campaign"
        action="action_mrp_campaign_billing_wizard_create"
        sequence="52"
    />

</odoo>
