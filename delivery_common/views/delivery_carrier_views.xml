<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="delivery_carrier_for_inherit_module_name" model="ir.ui.view">
        <field name="name">delivery.carrier.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="emails" string="Emails">
                    <group>
                        <group>
                            <field name="send_confirmation_email" />
                            <field
                                name="confirmation_template_id"
                                invisible="not send_confirmation_email"
                                required="send_confirmation_email"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
