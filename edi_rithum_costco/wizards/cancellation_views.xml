<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cancellation_form" model="ir.ui.view">
        <field name="name">edi.rithum.costco.cancellation.form</field>
        <field name="model">edi.rithum.costco.cancellation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_confirm"
                        string="Cancel with Costco"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="send"
                        string="Send again"
                        type="object"
                        invisible="state != 'done'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="name" invisible="state == 'draft'" />
                        <field name="order_id" />
                        <field name="reason_id" readonly="state != 'draft'" />
                        <field name="note" readonly="state != 'draft'" />
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sale_line_id" column_invisible="1" />
                            <field name="product_id" />
                            <field name="open_quantity" />
                            <field name="quantity" />
                        </list>
                    </field>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_cancellation_list" model="ir.ui.view">
        <field name="name">edi.rithum.costco.cancellation.list</field>
        <field name="model">edi.rithum.costco.cancellation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="order_id" />
                <field name="reason_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="action_cancellation" model="ir.actions.act_window">
        <field name="name">Costco cancellations</field>
        <field name="res_model">edi.rithum.costco.cancellation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
