<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_costco_product_list" model="ir.ui.view">
        <field name="name">edi.rithum.costco.product.list</field>
        <field name="model">edi.rithum.costco.product</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="backend_id" />
                <field name="product_id" />
                <field name="costco_sku" />
                <field name="discontinued_on" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_costco_product_search" model="ir.ui.view">
        <field name="name">edi.rithum.costco.product.search</field>
        <field name="model">edi.rithum.costco.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
                <field name="costco_sku" />
                <field name="backend_id" />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="discontinued"
                    string="Discontinued"
                    domain="[('discontinued_on', '!=', False)]"
                />
                <group>
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_costco_product" model="ir.actions.act_window">
        <field name="name">Costco products</field>
        <field name="res_model">edi.rithum.costco.product</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_costco_product"
        name="Costco products"
        parent="sale.menu_sale_config"
        action="action_costco_product"
        groups="sales_team.group_sale_manager"
    />

    <record id="edi_backend_view_form" model="ir.ui.view">
        <field name="name">edi.backend.form.costco</field>
        <field name="model">edi.backend</field>
        <field name="inherit_id" ref="edi_core_oca.edi_backend_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_costco_products"
                    icon="fa-cubes"
                    invisible="backend_type_code != 'x12'"
                    groups="sales_team.group_sale_manager"
                >
                    <field
                        name="costco_product_count"
                        widget="statinfo"
                        string="Costco products"
                    />
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_costco_send_inventory"
                        string="Send Costco inventory"
                        type="object"
                        invisible="backend_type_code != 'x12'"
                        groups="sales_team.group_sale_manager"
                    />
                    <button
                        name="action_costco_bind_products"
                        string="Bind Costco products"
                        type="object"
                        invisible="backend_type_code != 'x12'"
                        groups="sales_team.group_sale_manager"
                    />
                </header>
            </xpath>
        </field>
    </record>

</odoo>
