<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.costco</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_cancel']" position="before">
                <field name="costco_can_cancel" invisible="1" />
                <button
                    name="action_costco_cancel"
                    string="Cancel with Costco"
                    type="object"
                    invisible="not costco_can_cancel"
                    groups="sales_team.group_sale_salesman"
                />
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field
                    name="costco_shipping_method"
                    invisible="not costco_shipping_method"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='name']"
                position="after"
            >
                <field name="costco_sku" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
