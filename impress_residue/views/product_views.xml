<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_residue" model="ir.ui.view">
        <field name="name">product.template.form.residue</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_ok']/.." position="after">
                <group string="Residue Management" name="residue_management">
                    <field name="is_residue" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
