<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">


    <record id="sequence_picking_type_residue" model="ir.sequence">
        <field name="name">Residue Pickup Sequence</field>
        <field name="prefix">RP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="picking_type_residue_pickup" model="stock.picking.type">
        <field name="name">Residue Pickup</field>
        <field name="code">outgoing</field>
        <field name="sequence_id" ref="sequence_picking_type_residue" />
        <field name="warehouse_id" eval="False" />
        <field name="default_location_src_id" ref="stock.stock_location_stock" />
        <field name="default_location_dest_id" ref="stock.stock_location_suppliers" />
        <field name="sequence_code">RPIO</field>
    </record>

</odoo>
