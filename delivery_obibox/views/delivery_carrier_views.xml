<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View delivery.carrier form -->
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">view.delivery.carrier.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="before">
                <page
                    string="Obibox Configuration"
                    name="obibox_configuration"
                    invisible="delivery_type != 'obibox'"
                >
                    <group>
                        <group>
                            <field
                                name="obibox_username"
                                required="delivery_type=='obibox'"
                            />
                            <field
                                name="obibox_api_key"
                                required="delivery_type == 'obibox'"
                            />
                            <field name="obibox_label_format" />
                            <field name="obibox_delivery_day" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
