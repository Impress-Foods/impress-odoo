<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_breadcrumbs_timesheet" name="Portal breadcrumb: timesheet"
              inherit_id="portal.portal_breadcrumbs" priority="35">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'timesheet'" class="breadcrumb-item active">
                <t>Timesheets</t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_timesheet" name="Timesheets" customize_show="True"
              inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Timesheets</t>
                <t t-set="url" t-value="'/my/timesheets'"/>
                <t t-set="text">Review your work time</t>
                <t t-set="placeholder_count" t-value="'timesheet_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_timesheets" name="My Timesheets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Timesheets</t>
            </t>
            <div class="row">
                <div class="col-lg-12">
                    <t t-if="not timesheets">
                        <div class="alert alert-info" role="alert">
                            <t t-if="search">
                                No timesheet entries match your search.
                            </t>
                            <t t-else="">
                                There are no timesheet entries for your account yet.
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <table class="table table-hover o_portal_my_doc_table">
                            <thead>
                                <tr>
                                    <th t-if="groupby != 'employee'">Employee</th>
                                    <th>Date</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th class="text-end">Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="items" t-as="item">
                                    <tr t-if="item['label']">
                                        <td t-att-colspan="4 if groupby == 'employee' else 5"
                                            class="bg-light fw-semibold">
                                            <t t-esc="item['label']"/>
                                            <span class="text-muted float-end">
                                                <t t-esc="item['hours_label']"/> hours
                                            </span>
                                        </td>
                                    </tr>
                                    <tr t-foreach="item['sessions']" t-as="timesheet">
                                        <td t-if="groupby != 'employee'">
                                            <span t-field="timesheet.employee_id.name"/>
                                        </td>
                                        <td><span t-field="timesheet.date"/></td>
                                        <td><span t-field="timesheet.check_in"/></td>
                                        <td>
                                            <span t-if="timesheet.check_out" t-field="timesheet.check_out"/>
                                            <span t-else="" class="text-muted">Still open</span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="timesheet.worked_hours"
                                                  t-options="{'widget': 'float_time'}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <div t-if="pager" class="mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
