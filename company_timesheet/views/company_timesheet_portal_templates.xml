<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_breadcrumbs_timesheet" name="Portal breadcrumb: timesheet"
              inherit_id="portal.portal_breadcrumbs" priority="35">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'timesheet'" class="breadcrumb-item active">
                <t>Timesheets</t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_timesheet" name="Timesheets" customize_show="True"
              inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Timesheets</t>
                <t t-set="url" t-value="'/my/timesheets'"/>
                <t t-set="text">Review your work time</t>
                <t t-set="placeholder_count" t-value="'timesheet_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_timesheets" name="My Timesheets">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-lg-12">
                    <h3 class="mb-3">My Timesheets</h3>
                    <t t-if="not timesheets">
                        <div class="alert alert-info" role="alert">
                            There are no timesheet entries for your account yet.
                        </div>
                    </t>
                    <t t-else="">
                        <table class="table table-hover o_portal_my_doc_table">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Date</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th class="text-end">Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="timesheets" t-as="timesheet">
                                    <td><span t-field="timesheet.employee_id.name"/></td>
                                    <td><span t-field="timesheet.date"/></td>
                                    <td><span t-field="timesheet.check_in"/></td>
                                    <td><span t-field="timesheet.check_out"/></td>
                                    <td class="text-end">
                                        <span t-field="timesheet.worked_hours"
                                              t-options="{'widget': 'float_time'}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <div t-if="pager" class="mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
