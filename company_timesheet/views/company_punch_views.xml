<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_punch_list" model="ir.ui.view">
        <field name="name">company.punch.list</field>
        <field name="model">company.punch</field>
        <field name="arch" type="xml">
            <list string="Punches" create="false">
                <field name="employee_id"/>
                <field name="timestamp"/>
                <field name="direction"/>
                <field name="source"/>
                <field name="external_id"/>
                <field name="device"/>
                <field name="session_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_company_punch_form" model="ir.ui.view">
        <field name="name">company.punch.form</field>
        <field name="model">company.punch</field>
        <field name="arch" type="xml">
            <form string="Punch" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="timestamp"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="external_id"/>
                            <field name="device"/>
                            <field name="session_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_company_punch_search" model="ir.ui.view">
        <field name="name">company.punch.search</field>
        <field name="model">company.punch</field>
        <field name="arch" type="xml">
            <search string="Punches">
                <field name="employee_id"/>
                <field name="source"/>
                <field name="external_id"/>
                <field name="timestamp"/>
                <separator/>
                <filter name="direction_in" string="In" domain="[('direction', '=', 'in')]"/>
                <filter name="direction_out" string="Out" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter name="group_source" string="Source"
                        context="{'group_by': 'source'}"/>
                <filter name="group_date" string="Date"
                        context="{'group_by': 'timestamp'}"/>
            </search>
        </field>
    </record>

    <record id="action_company_punch" model="ir.actions.act_window">
        <field name="name">Punches</field>
        <field name="res_model">company.punch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_punch_search"/>
    </record>
</odoo>
