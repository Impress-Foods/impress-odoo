<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timesheet_list" model="ir.ui.view">
        <field name="name">workforce.timesheet.list</field>
        <field name="model">workforce.timesheet</field>
        <field name="arch" type="xml">
            <list string="Timesheets" create="false" edit="false">
                <field name="worker_id"/>
                <field name="date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time" sum="Total Hours"/>
                <field name="department_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_timesheet_form" model="ir.ui.view">
        <field name="name">workforce.timesheet.form</field>
        <field name="model">workforce.timesheet</field>
        <field name="arch" type="xml">
            <form string="Timesheet" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="worker_id"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="worked_hours" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Punches" name="punches">
                            <field name="punch_ids" readonly="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="direction"/>
                                    <field name="source"/>
                                    <field name="device"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_timesheet_search" model="ir.ui.view">
        <field name="name">workforce.timesheet.search</field>
        <field name="model">workforce.timesheet</field>
        <field name="arch" type="xml">
            <search string="Timesheets">
                <field name="worker_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="manager_id"/>
                <filter name="my_timesheet" string="My Timesheet"
                        domain="[('worker_id.partner_id.user_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This Week"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="group_employee" string="Employee"
                        context="{'group_by': 'worker_id'}"/>
                <filter name="group_department" string="Department"
                        context="{'group_by': 'department_id'}"/>
                <filter name="group_date" string="Date"
                        context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="view_timesheet_pivot" model="ir.ui.view">
        <field name="name">workforce.timesheet.pivot</field>
        <field name="model">workforce.timesheet</field>
        <field name="arch" type="xml">
            <pivot string="Timesheets">
                <field name="worker_id" type="row"/>
                <field name="date" type="col"/>
                <field name="worked_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_timesheet_graph" model="ir.ui.view">
        <field name="name">workforce.timesheet.graph</field>
        <field name="model">workforce.timesheet</field>
        <field name="arch" type="xml">
            <graph string="Timesheets" type="bar">
                <field name="worker_id"/>
                <field name="worked_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_timesheet" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">workforce.timesheet</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_timesheet_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work time yet
            </p>
            <p>
                Sessions are derived automatically from imported punch data.
            </p>
        </field>
    </record>
</odoo>
