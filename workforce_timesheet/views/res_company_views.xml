<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_timesheet" model="ir.ui.view">
        <field name="name">res.company.form.workforce.timesheet</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group name="workforce_timesheet" string="Timesheets">
                    <field name="timesheet_day_start_hour"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
