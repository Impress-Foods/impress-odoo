<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="email_template_password_reset_aplus" model="mail.template">
        <field name="name">A+: Password Reset</field>
        <field name="model_id" ref="base.model_res_users" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> A+ Superfruit password reset </field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-call="aplus_emails.email_format">
                <t t-call="aplus_emails.logo_header" />
                <div style="width: 80%; margin: auto;">
                    <h1>Let's update your password</h1>
                    <p
                    >We received a request to set a new password for the following account on A+ Superfruit:</p>

                    <div>
                        <p>Name: <span t-out="object.name" /> </p>
                        <p>Email: <span t-out="object.login" /></p>
                    </div>

                    <p
                    >If you didn't make this request, just ignore this email. If you'd like to proceed:</p>
                    <a style="text-decoration: none; padding-bottom: 1rem;" href="/">
                        <div
                            t-attf-style="background-color: {{textColor}};
                            border-radius: 20px; width: 200px; padding-top:0.40rem; padding-bottom:0.40rem;
                            text-align: center;"
                        >
                            <span
                                t-attf-style="color: {{bgColor}}"
                            >Reset your password</span>
                        </div>
                    </a>
                    <p>Thanks for reading &amp; don't hesitate to <a
                            t-attf-style="color: {{textColor}};"
                            href="mailto:info@aplussuperfruit.com"
                        >contact us</a> if you are having trouble.</p>
                    <p>The A+ Team</p>
                </div>
            </t>
        </field>
    </record>

</odoo>
