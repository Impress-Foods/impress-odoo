<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="email_template_welcome_aplus" model="mail.template">
        <field name="name">A+: Welcome</field>
        <field name="model_id" ref="base.model_res_users" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject">Welcome to A+ Superfruit</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-set="fonts" t-value="'font-family: \'Gooper\', Garamond, serif;'" />
            <t t-call="aplus_emails.font_gooper" />
            <div
                t-attf-style="background-color: {{bgColor}}; {{fonts}}; color: {{textColor}}; align: center; overflow: hidden;"
            >
                <table t-attf-style="width: 80%; margin: auto; color: {{textColor}};">
                    <tbody>
                        <tr>
                            <td>
                                <t t-call="aplus_emails.image_header">
                                    <t t-set="image" t-value="'new-account-1.jpg'" />
                                    <t
                                        t-set="alt_text"
                                        t-value="'Lunch bag with an A+ juice bottle'"
                                    />
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <h1
                                    t-attf-style="color: {{textColor}};"
                                > Welcome to A+ Superfruit</h1>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span> Dear <t t-out="object.name" />, <br />
                                    Your account has been successfully created. You can access your account area to view orders, change your password, and more at:
                                    <a
                                        t-attf-style="color:{{textColor}};"
                                        href="https://aplussuperfruit.com/my/home"
                                    >
                                        wwww.aplussuperfruit.com/my/home
                                    </a>
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div
                                    style="padding-top: 1rem;"
                                > We look forward to seeing you soon.</div>
                            </td>
                        </tr>
                    </tbody>
                </table>


                <hr
                    style="width: 100vw; color: white; background-color: white; border:none; height:1px;"
                />


                <table style="width: 80%; margin: auto;">
                    <tbody>
                        <tr>
                            <td>
                                <h3
                                    t-attf-style="color:{{textColor}};"
                                >For the big and <em>little</em> moments</h3>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div
                                    t-attf-style="color:{{textColor}}; padding-bottom:1rem;"
                                > Click
                                    <a
                                        t-attf-style="color:{{textColor}};"
                                        href="https://aplussuperfruit.com/locator"
                                    >here</a>
                                    for the nearest store
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <table
                                    style="border-spacing: 15px; border-collapse: separate; width: 90%; margin-left:-15px;"
                                >
                                    <colgroup>
                                        <col style="width: 25%;" />
                                        <col style="width: 25%;" />
                                        <col style="width: 50%;" />
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <img
                                                    style="width:100%; height: auto;"
                                                    src="/aplus_emails/static/img/IGA.png"
                                                />
                                            </td>
                                            <td>
                                                <img
                                                    style="width:100%; height: auto;"
                                                    src="/aplus_emails/static/img/Metro.png"
                                                />
                                            </td>
                                            <td rowspan="2" style="text-align: right;">
                                                <img
                                                    style="width: 70%; height: auto; text-align: right;"
                                                    src="/aplus_emails/static/img/strawberry_girl.png"
                                                />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <img
                                                    style="width:100%; height: auto;"
                                                    src="/aplus_emails/static/img/WholeFoods.png"
                                                />
                                            </td>
                                            <td>
                                                <img
                                                    style="width:100%; height: auto;"
                                                    src="/aplus_emails/static/img/Avril.png"
                                                />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <t t-call="aplus_emails.social_footer" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </field>
    </record>
</odoo>
