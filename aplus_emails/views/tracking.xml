<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="email_template_tracking_aplus" model="mail.template">
        <field name="name">A+: Shipment tracking</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> Your order is on the way!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field
            name="scheduled_date"
        >${(datetime.datetime.now() + relativedelta(minutes=10)).strftime('%Y-%m-%d %H:%M')}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-call="aplus_emails.font_gooper" />
            <t t-set="fonts" t-value="'font-family: \'Gooper\', Garamond, serif;'" />
            <t t-set="so" t-value="object.sale_id" />

            <t t-call="aplus_emails.font_gooper" />
            <div
                t-attf-style="background-color: {{bgColor}}; {{fonts}}; color: {{textColor}}; align: center;"
            >
                <t t-call="aplus_emails.image_header_overlaid_logo">
                    <t t-set="alt_text" t-value="'Picture of a child with A+ juice'" />
                </t>
                <table style="width: 80%; margin: auto;">
                    <tbody t-attf-style="color: {{textColor}};">
                        <tr>
                            <td>
                                <h1
                                    t-attf-style="color:{{textColor}}; {{fonts}}"
                                >Your order is on its way</h1>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <p>Great news, your order <b><t
                                            t-out="so.name"
                                        /></b> has been shipped and is now heading your way. You can track its progress using the button below. </p>
                            </td>
                        </tr>

                        <tr>
                            <td
                                align="center"
                                style="text-align: center; padding-top: 2rem; padding-bottom: 2rem;"
                            >
                                <t
                                    t-set="button_style"
                                    t-value="'border-radius: 20px; background-color:' + textColor +'; color:#ffffff; font-weight: bold; padding: 10px 20px; border: 1px solid ' + textColor + '; display: inline-block;'"
                                />

                                <table
                                    align="center"
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    role="presentation"
                                    style="margin: auto;"
                                >
                                    <tbody>
                                        <tr>
                                            <td align="center" style="padding: 0;">
                                                <a
                                                    t-attf-href="{{object.carrier_tracking_url}}"
                                                    t-attf-style="text-decoration: none; {{button_style}}"
                                                > Track here </a>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <p>Your order was shipped using <t
                                        t-out="object.carrier_id.name"
                                    />. Your tracking number is <b><t
                                            t-out="object.carrier_tracking_ref"
                                        /></b>.</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <t t-call="aplus_emails.social_footer" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </field>
    </record>

