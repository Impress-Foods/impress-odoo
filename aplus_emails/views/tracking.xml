    <record id="email_template_pickup_aplus" model="mail.template">
        <field name="name">A+: Pickup Confirmation</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> Your order is on the way!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field
            name="scheduled_date"
        >${(datetime.datetime.now() + relativedelta(minutes=10)).strftime('%Y-%m-%d %H:%M')}</field>
        <field name="body_html" type="html">
            <t t-set="fonts" t-value="'font-family: \'Gooper\', Garamond, serif;'" />
            <t t-call="aplus_emails.font_gooper" />
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-set="so" t-value="object.sale_id" />
            <div
                t-attf-style="background-color: {{bgColor}}; {{fonts}}; color: {{textColor}}; align: center;"
            >
                <t t-call="aplus_emails.image_header_overlaid_logo">
                    <t t-set="alt_text" t-value="'Picture of a child with A+ juice'" />
                </t>
                <table style="width: 80%; margin: auto;">
                    <tbody t-attf-style="color: {{textColor}};">
                        <tr>
                            <td>
                                <h1
                                    t-attf-style="color:{{textColor}}; {{fonts}}"
                                >Your order is ready for pickup</h1>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <p> You can stop by <b
                                    >1910 Avenue du Sanctuaire</b> between <b
                                    >9:00 a.m. and 4:30 p.m.</b>, Monday to Friday. Please head to the reception on the <b
                                    >2<sup>nd</sup>
                                    floor</b> and we'll give you your order. </p>
                                <p> Have a great day &amp; see you soon! 🍓 </p>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <h1
                                    t-attf-style="color: {{textColor}}; padding-top: 1rem;"
                                >Order #<t t-out="so.name" /> (<t
                                        t-out="so.date_order.date()"
                                    />) </h1>
                                <t t-call="aplus_emails.order_summary" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <t t-call="aplus_emails.social_footer" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </field>
    </record>
</odoo>
