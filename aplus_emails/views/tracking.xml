<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="email_template_tracking_aplus" model="mail.template">
        <field name="name">A+: Shipment tracking</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> Your order is on the way!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field
            name="scheduled_date"
        >${(datetime.datetime.now() + relativedelta(minutes=10)).strftime('%Y-%m-%d %H:%M')}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-set="flexColumn" t-value="'display: flex; flex-direction: column; '" />
            <t t-set="fonts" t-value="'font-family: \'Gooper\', Garamond, serif;'" />
            <t t-set="so" t-value="object.sale_id" />
            <t t-call="aplus_emails.font_gooper" />
            <div t-attf-style="background-color: {{bgColor}}; {{fonts}}">

                <t t-call="aplus_emails.image_header_overlaid_logo">
                    <t t-set="image" t-value="'shipping-1.jpg'" />
                    <t t-set="alt_text" t-value="'Picture of a child with A+ juice'" />
                </t>
                <div t-attf-style="{{flexColumn}} width:90%; margin:auto;">

                    <div t-attf-style="{{flexColumn}} color:{{textColor}}; ">
                        <div t-attf-style="{{flexColumn}}" id="test">
                            <h1
                                t-attf-style="color:{{textColor}}; {{fonts}}"
                            >Your order is on its way</h1>
                            <p>Great news, your order <t
                                    t-out="so.name"
                                /> has been shipped and is now heading your way. You can track its progress using the button below.</p>
                            <a
                                t-attf-href="{{object.carrier_tracking_url}}"
                                style="text-decoration: none;"
                            >
                                <t
                                    t-set="button_style"
                                    t-value="'border-radius: 20px; background-color:' + textColor +'; color:#ffffff; max-width: 25%; height: 40px; margin: auto;'"
                                />
                                <div
                                    t-attf-style="{{button_style}} display: flex; flex-direction: column; align-items: center; justify-content: center; "
                                >
                                    Track here
                                </div>
                            </a>
                            <p>Your order was shipped using <t
                                    t-out="object.carrier_id.name"
                                />. Your tracking number is <t
                                    t-out="object.carrier_tracking_ref"
                                />.</p>
                        </div>

                        <div
                            style="align-self: center; width: 40%; padding-top:3rem;"
                            id="footer"
                        >
                            <t t-call="aplus_emails.social_footer" />
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <record id="email_template_tracking_obibox_aplus" model="mail.template">
        <field name="name">A+: Shipment tracking (obibox)</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> Your order is on the way!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field
            name="scheduled_date"
        >${(datetime.datetime.now() + relativedelta(minutes=10)).strftime('%Y-%m-%d %H:%M')}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-set="so" t-value="object.sale_id" />
            <t t-call="aplus_emails.email_format">
                <t t-call="aplus_emails.image_header_overlaid_logo">
                    <t t-set="image" t-value="'shipping-1.jpg'" />
                    <t t-set="alt_text" t-value="'Picture of a child with A+ juice'" />
                </t>
                <div t-attf-style="{{flexColumn}} width:90%; margin:auto;">

                    <div t-attf-style="{{flexColumn}} color:{{textColor}}; ">
                        <div t-attf-style="{{flexColumn}}" id="test">
                            <h1
                                t-attf-style="color:{{textColor}}; {{fonts}}"
                            >We're preparing your order</h1>
                            <p>Great news, we've received your order <t
                                    t-out="so.name"
                                /> and are currently preparing it with care. You can track its progress using the button below. Our delivery driver picks up orders every <b
                                >Wednesday</b>, so yours will be delivered within 48 hours after pickup.</p>
                            <a
                                t-attf-href="{{object.carrier_tracking_url}}"
                                style="text-decoration: none;"
                            >
                                <t
                                    t-set="button_style"
                                    t-value="'border-radius: 20px; background-color:' + textColor +'; color:#ffffff; max-width: 25%; height: 40px; margin: auto;'"
                                />
                                <div
                                    t-attf-style="{{button_style}} display: flex; flex-direction: column; align-items: center; justify-content: center; "
                                >
                                    Track here
                                </div>
                            </a>
                            <p>Your order was shipped using <t
                                    t-out="object.carrier_id.name"
                                />. Your tracking number is <t
                                    t-out="object.carrier_tracking_ref"
                                />.</p>
                        </div>
                    </div>
                </div>
            </t>
        </field>
    </record>

    <record id="email_template_pickup_aplus" model="mail.template">
        <field name="name">A+: Pickup Confirmation</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> Your order is on the way!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field
            name="scheduled_date"
        >${(datetime.datetime.now() + relativedelta(minutes=10)).strftime('%Y-%m-%d %H:%M')}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-set="so" t-value="object.sale_id" />
            <t t-call="aplus_emails.email_format">
                <t t-call="aplus_emails.image_header_overlaid_logo">
                    <t t-set="image" t-value="'shipping-1.jpg'" />
                    <t t-set="alt_text" t-value="'Picture of a child with A+ juice'" />
                </t>
                <div t-attf-style="{{flexColumn}} width:90%; margin:auto;">
                    <div t-attf-style="{{flexColumn}} color:{{textColor}};">
                        <h1
                            t-attf-style="color:{{textColor}}; {{fonts}}"
                        >Your order is ready for pickup</h1>
                        <p>
                            You can stop by <b>1910 Avenue du Sanctuaire</b> between <b
                            >9:00 a.m. and 4:30 p.m.</b>, Monday to Friday. Please head to the reception on the <b
                            >2<sup>nd</sup> floor</b> and we'll give you your order.
                        </p>
                        <p>
                            Have a great day &amp; see you soon! 🍓
                        </p>
                    </div>
                    <div>
                        <h1>Order #<t t-out="so.name" /> (<t
                                t-out="so.date_order.date()"
                            />)</h1>
                        <t t-call="aplus_emails.order_summary" />
                    </div>
                </div>
            </t>
        </field>
    </record>
</odoo>
