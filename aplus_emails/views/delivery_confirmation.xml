<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../import_xml.rng" type="application/xml"?>
<odoo>

    <record id="email_template_delivery_aplus" model="mail.template">
        <field name="name">A+: Delivery confirmation</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="subject"> Your order is on the way!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field
            name="scheduled_date"
        >${(datetime.datetime.now() + relativedelta(minutes=10)).strftime('%Y-%m-%d %H:%M')}</field>
        <field name="body_html" type="html">
            <t t-set="textColor" t-value="'#f65834'" />
            <t t-set="bgColor" t-value="'#f7eae4'" />
            <t t-set="flexColumn" t-value="'display: flex; flex-direction: column; '" />
            <t t-set="fonts" t-value="'font-family: \'Gooper\', Garamond, serif;'" />
            <t t-set="so" t-value="object.sale_id" />
            <t t-call="aplus_emails.font_gooper" />
            <div t-attf-style="background-color: {{bgColor}}; {{fonts}}">
                <div t-attf-style="{{flexColumn}} width:80%; margin:auto;">
                    <t t-call="aplus_emails.image_header">
                        <t t-set="image" t-value="'delivery-1.jpg'" />
                        <t
                            t-set="alt_text"
                            t-value="'Picture of a child with A+ juice'"
                        />
                    </t>
                    <div t-attf-style="{{flexColumn}} color:{{textColor}}; ">
                        <div>
                            <h1
                                t-attf-style="color:{{textColor}}; {{fonts}}"
                            >Thank you for shopping with us!</h1>
                            <p
                            >We have received your order and will provide you with a tracking number as soon as it leaves our facility. You can find your full order details below.</p>
                            <p>We hope our juices can bring you joy :)</p>
                        </div>

                        <div>
                            <h1>Your order details</h1>
                            <div style="width:80%;">
                                <t t-call="aplus_emails.order_summary" />
                            </div>
                        </div>
                        <div style="align-self: center; width: 40%; padding-top:3rem;">
                            <t t-call="aplus_emails.social_footer" />
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
