#. module: aplus_emails
#: model:mail.template,body_html:aplus_emails.email_template_pickup_aplus
msgid ""
"<t t-set=\"fonts\" t-value=\"'font-family: \\'Gooper\\', Garamond, serif;'\"></t>\n"
"            <t t-call=\"aplus_emails.font_gooper\"></t>\n"
"            <t t-set=\"textColor\" t-value=\"'#f65834'\"></t>\n"
"            <t t-set=\"bgColor\" t-value=\"'#f7eae4'\"></t>\n"
"            <t t-set=\"so\" t-value=\"object.sale_id\"></t>\n"
"            <div t-attf-style=\"background-color: {{bgColor}}; {{fonts}}; color: {{textColor}}; align: center;\">\n"
"                <t t-call=\"aplus_emails.image_header_overlaid_logo\">\n"
"                    <t t-set=\"image\" t-value=\"'shipping-1.jpg'\"></t>\n"
"                    <t t-set=\"alt_text\" t-value=\"'Picture of a child with A+ juice'\"></t>\n"
"                </t>\n"
"                <table style=\"width: 80%; margin: auto;\">\n"
"                    <tbody t-attf-style=\"color: {{textColor}};\">\n"
"                        <tr>\n"
"                            <td>\n"
"                                <h1 t-attf-style=\"color:{{textColor}}; {{fonts}}\">Your order is ready for pickup</h1>\n"
"                            </td>\n"
"                        </tr>\n"
"\n"
"                        <tr>\n"
"                            <td>\n"
"                                <p> You can stop by <b>1910 Avenue du Sanctuaire</b> between <b>9:00 a.m. and 4:30 p.m.</b>, Monday to Friday. Please head to the reception on the <b>2<sup>nd</sup>\n"
"                                    floor</b> and we'll give you your order. </p>\n"
"                                <p> Have a great day &amp; see you soon! 🍓 </p>\n"
"                            </td>\n"
"                        </tr>\n"
"\n"
"                        <tr>\n"
"                            <td>\n"
"                                <h1 t-attf-style=\"color: {{textColor}}; padding-top: 1rem;\">Order #<t t-out=\"so.name\"></t> (<t t-out=\"so.date_order.date()\"></t>) </h1>\n"
"                                <t t-call=\"aplus_emails.order_summary\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <t t-call=\"aplus_emails.social_footer\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

#. module: aplus_emails
#: model:mail.template,body_html:aplus_emails.email_template_tracking_obibox_aplus
msgid ""
"<t t-set=\"fonts\" t-value=\"'font-family: \\'Gooper\\', Garamond, serif;'\"></t>\n"
"            <t t-set=\"textColor\" t-value=\"'#f65834'\"></t>\n"
"            <t t-set=\"bgColor\" t-value=\"'#f7eae4'\"></t>\n"
"            <t t-set=\"so\" t-value=\"object.sale_id\"></t>\n"
"            <t t-call=\"aplus_emails.font_gooper\"></t>\n"
"\n"
"            <div t-attf-style=\"background-color: {{bgColor}}; {{fonts}}; color: {{textColor}}; align: center;\">\n"
"                <t t-call=\"aplus_emails.image_header_overlaid_logo\">\n"
"                    <t t-set=\"image\" t-value=\"'shipping-1.jpg'\"></t>\n"
"                    <t t-set=\"alt_text\" t-value=\"'Picture of a child with A+ juice'\"></t>\n"
"                </t>\n"
"                <table style=\"width: 80%; margin: auto;\">\n"
"                    <tbody t-attf-style=\"color: {{textColor}};\">\n"
"                        <tr>\n"
"                            <td t-attf-style=\"color: {{textColor}}; {{fonts}}\">\n"
"                                <h1 t-attf-style=\"color: {{textColor}}; {{fonts}}\"> We're preparing your order </h1>\n"
"                            </td>\n"
"                        </tr>\n"
"\n"
"                        <tr>\n"
"                            <td>\n"
"                                <p>Great news, we've received your order <b>\n"
"                                        <t t-out=\"so.name\"></t>\n"
"                                    </b> and are currently preparing it with care. You can track its progress using the button below. Our\n"
"                                    delivery driver picks up orders every <b> Wednesday</b>, so yours will be delivered within 48 hours after pickup.</p>\n"
"                            </td>\n"
"                        </tr>\n"
"\n"
"                        <tr>\n"
"                            <td align=\"center\" style=\"text-align: center;padding-top: 2rem; padding-bottom: 2rem;\">\n"
"                                <t t-set=\"button_style\" t-value=\"'border-radius: 20px; background-color:' + textColor +'; color:#ffffff; font-weight: bold; padding: 10px 20px; border: 1px solid ' + textColor + '; display: inline-block;'\"></t>\n"
"\n"
"                                <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: auto;\">\n"
"                                    <tbody>\n"
"                                        <tr>\n"
"                                            <td align=\"center\" style=\"padding: 0;\">\n"
"                                                <a t-attf-href=\"{{object.carrier_tracking_url}}\" t-attf-style=\"text-decoration: none; {{button_style}}\"> Track here </a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"\n"
"                        <tr>\n"
"                            <td>\n"
"                                <p>Your order was shipped using <t t-out=\"object.carrier_id.name\"></t>. Your tracking number is <b>\n"
"                                        <t t-out=\"object.carrier_tracking_ref\"></t>\n"
"                                    </b>.</p>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <t t-call=\"aplus_emails.social_footer\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

