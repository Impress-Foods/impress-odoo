#. module: aplus_emails
#: model:mail.template,body_html:aplus_emails.email_template_password_reset_aplus
msgid ""
"<t t-set=\"textColor\" t-value=\"'#f65834'\"></t>\n"
"            <t t-set=\"bgColor\" t-value=\"'#f7eae4'\"></t>\n"
"            <t t-set=\"fonts\" t-value=\"'font-family: \\'Gooper\\', Garamond, serif;'\"></t>\n"
"            <t t-call=\"aplus_emails.font_gooper\"></t>\n"
"            <div t-attf-style=\"background-color: {{bgColor}}; {{fonts}}; color: {{textColor}}; align: center;\">\n"
"                <table style=\"width: 80%; margin: auto;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td style=\"padding-top: 2rem; padding-bottom: 2rem;\">\n"
"                                <t t-call=\"aplus_emails.logo_header\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <h1 t-attf-style=\"color: {{textColor}};\">Let's update your password</h1>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td t-attf-style=\"color: {{textColor}};\">\n"
"                                <p>We received a request to set a new password for the following account on A+ Superfruit:</p>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td t-attf-style=\"color: {{textColor}};\">\n"
"                                <div style=\"padding-left: 2rem;\">\n"
"                                    <p>Name: <span t-out=\"object.name\"></span></p>\n"
"                                    <p>Email: <span t-out=\"object.login\"></span></p>\n"
"                                </div>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td t-attf-style=\"color: {{textColor}};\">\n"
"                                <p style=\"padding-bottom: 2rem;margin: 0px;\">If you didn't make this request, just ignore this email. If you'd like to proceed:</p>\n"
"\n"
"                                <a style=\"text-decoration: none; padding-top: 2rem; \" href=\"/\">\n"
"                                    <div t-attf-style=\"background-color: {{textColor}};                                 border-radius: 20px; width: 200px; padding-top:0.40rem; padding-bottom:0.40rem;                                 text-align: center;\">\n"
"                                        <span t-attf-style=\"color: {{bgColor}}\">Reset your password</span>\n"
"                                    </div>\n"
"                                </a>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td t-attf-style=\"color: {{textColor}};\">\n"
"                                <p style=\"padding-top:2rem;\">Thanks for reading &amp; don't hesitate to <a t-attf-style=\"color: {{textColor}};\" href=\"mailto:info@aplussuperfruit.com\">contact us</a> if you are having trouble.</p>\n"
"                                <p>The A+ Team</p>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td t-attf-style=\"color: {{textColor}};\">\n"
"                                <t t-call=\"aplus_emails.social_footer\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

