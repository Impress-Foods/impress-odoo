<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="aggregated_lot_expiry_alert" model="mail.template">
        <field name="name">Aggregated lot expiry alert</field>
        <field name="model_id" ref="stock.model_stock_lot" />
        <field name="auto_delete" eval="True" />
        <field
            name="subject"
        > Lot expiry alerts for {{ datetime.datetime.today().date() }} </field>
        <field name="body_html" type="html">
            <div />
        </field>
    </record>

    <template id="body_aggregated_expiry_alert" name="Aggregated Expiry Alert Body">
        <p>The following lots have expiry alerts today (<t t-out="today" />): </p>
        <ul t-foreach="lots" t-as="lot">
            <li>
                <a
                    t-attf-href="{{base_url}}/web#id={{lot.id}}&amp;model=stock.lot&amp;view_type=form"
                >
                    <t t-out="lot.product_id.name" /> (<t t-out="lot.name" />)
                </a>
            </li>
        </ul>
    </template>

</odoo>
