<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View sale.order form -->
    <record id="view_sale_order_form" model="ir.ui.view">
        <field name="name">view.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field name="auto_selected_carrier_id" readonly="1" />
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="after">
                <button
                    string="Get Carrier"
                    name="action_auto_select_carrier"
                    type="object"
                    class="btn-secondary"
                    invisible="state in ['sale', 'cancel'] or auto_selected_carrier_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
